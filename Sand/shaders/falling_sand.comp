    uint cloudClumpThreshold;     // UNUSED: cloud spreads like sand, no cohesion
    uint rainWaitMinTicks;        // floor of a raincloud's wait at the ceiling
    uint steamCondenseTicks;      // dispatches of stillness before steam condenses in place
    float cloudSmoothRate;        // how fast the drawn cloud surface follows the block field
} tuning;

#define LAYER_SIZE (uint(WIDTH) * uint(HEIGHT)) // one layer of the world

// Per-frame state the CPU writes: camera pose, cursor position, brush.
//
// Vulkan takes this as push constants -- 60 bytes written straight into the command buffer, with
// no buffer to allocate and nothing to synchronise. WebGPU has no equivalent at all; the web build
// binds the same fields as an ordinary uniform buffer instead.
//
// Only the declaration differs. The fields are all scalars, so std140 packs them at exactly the
// offsets a push-constant block uses, and the same C++ PushConstants struct is the payload either
// way. Keeping it as one #ifdef rather than two shader files is what stops the two from drifting.
#ifdef SAND_WEB
layout(std140, binding = 3) uniform Constants {
#else
layout(push_constant) uniform Constants {
#endif
    float time;
    float pitch;
    float yaw;
    float camX;
    float camY;
    float camZ;
    int spawnX;
    int spawnY;
    int spawnZ;
    int spawnActive;
    int spawnType;
    int spawnSize;
    float fovDistance;
    float perspectiveBlend;
    int spawnShape; // 0 = cube, 1 = sphere
    // Unused here -- this shader casts no rays. Declared because the block's layout is a binary
    // contract shared with raymarch.frag and FrameConstants.hpp, and a short block here would read
    // every field before it correctly and then diverge for anything added later.
    float aspectScaleX;
    float aspectScaleY;
    int showCloudBlocks; // debug view: draw the invisible cloud blocks as solid voxels
} pc;

// World extents. Macros rather than constants because they come from the UBO now -- every use below
// is unchanged, it just reads a uniform where it used to read an immediate.
#define WIDTH  int(tuning.gridWidth)
#define HEIGHT int(tuning.gridHeight)
#define DEPTH  int(tuning.gridDepth)


// FUNCTION: getHDir
ivec3 getHDir(int d) {
    if (d == 0) return ivec3(1, 0, 0);
    if (d == 1) return ivec3(-1, 0, 0);
    if (d == 2) return ivec3(0, 0, 1);
    if (d == 3) return ivec3(0, 0, -1);
    if (d == 4) return ivec3(1, 0, 1);
    if (d == 5) return ivec3(1, 0, -1);
    if (d == 6) return ivec3(-1, 0, 1);
    return ivec3(-1, 0, -1);
}

// FUNCTION: getOrthoDir
ivec3 getOrthoDir(int d) {
    if (d == 0) return ivec3(1, 0, 0);
    if (d == 1) return ivec3(-1, 0, 0);
    if (d == 2) return ivec3(0, 1, 0);
    if (d == 3) return ivec3(0, -1, 0);
    if (d == 4) return ivec3(0, 0, 1);
    return ivec3(0, 0, -1);
}

// FUNCTION: getIndex
uint getIndex(ivec3 pos) {
    return uint(pos.x + (pos.y * WIDTH) + (pos.z * WIDTH * HEIGHT));
}

// FUNCTION: pack
uint pack(uint type, uint dir, uint sleep, uint age) {
    return (type & 0xFFu) | ((dir & 0xFFu) << 8) | ((sleep & 0xFFu) << 16) | ((age & 0xFFu) << 24);
}

// FUNCTION: getType
uint getType(uint val) {
    return val & 0xFFu;
}

// FUNCTION: getDir
uint getDir(uint val) {
    return (val >> 8) & 0xFFu;
}

// FUNCTION: getSleep
uint getSleep(uint val) {
    return (val >> 16) & 0xFFu;
}

// FUNCTION: getAge
uint getAge(uint val) {
    return (val >> 24) & 0xFFu;
}

// FUNCTION: packCloud and its accessors
// The cloud word -- a separate, narrower encoding from pack() above:
//   bits 0-1   kind     0 = empty, 1 = cloud, 2 = raincloud
//   bit  2     moved    did this block move on the last dispatch
//   bits 3-13  counter  a raincloud's tick count at the ceiling, 0..2047
//   bits 14-24 target   the count it is heading for, 0..2047
// Nothing outside these functions should know the layout.
//
// eleven bits for each of the two counters, not the eight the wait field used to have: a raincloud
// waits somewhere between rainWaitMinTicks and rainWaitMaxTicks, and 2048 does not fit in a byte.
//
// The `moved` bit is what the storm check reads. Storing it per block rather than only counting
// moves globally means "did anything move last tick" is answerable from the block itself, which is
// also what makes cloudIsAtRest a single mask instead of a threshold on a sleep counter.
const uint CLOUD_NONE = 0u;
const uint CLOUD_CALM = 1u;
const uint CLOUD_RAIN = 2u;

const uint CLOUD_COUNTER_MAX = 2047u;

uint packCloud(uint kind, bool moved, uint counter, uint target) {
    return (kind & 3u)
         | (moved ? 4u : 0u)
         | ((min(counter, CLOUD_COUNTER_MAX)) << 3)
         | ((min(target,  CLOUD_COUNTER_MAX)) << 14);
}
uint getCloudKind(uint v)    { return v & 3u; }
bool getCloudMoved(uint v)   { return (v & 4u) != 0u; }
uint getCloudCounter(uint v) { return (v >> 3) & CLOUD_COUNTER_MAX; }
uint getCloudTarget(uint v)  { return (v >> 14) & CLOUD_COUNTER_MAX; }

// FUNCTION: cloudCellInBounds
// Whether a cloud block may occupy a cell -- the same strict interior every other material is
// confined to, NOT merely "inside the array".
//
// This matters far more than it looks. main() walls off a one-voxel border and returns before any
// material update, so a voxel that reaches the border is never simulated again: it is frozen there
// for good. Cloud movement used to test only against WIDTH and DEPTH, so blocks slid into the border
// columns, and a storm block there turned into a water voxel that could never fall -- water welded
// to the walls of the world.
bool cloudCellInBounds(ivec3 p) {
    return p.x >= 1 && p.x < WIDTH - 1 &&
           p.y >= 1 && p.y < HEIGHT - 1 &&
           p.z >= 1 && p.z < DEPTH - 1;
}

// FUNCTION: easeTowards
// One step of an exponential average held as an integer, guaranteed to arrive.
//
// The obvious form -- uint(old + (target - old) * rate) -- does not. Once the remaining difference
// is small the step is under one unit and the truncation throws it away, so the value parks short of
// the target and stays there: at a rate of 0.08 an average chasing one block settles a quarter of
// the way and never moves again. Forcing a whole unit of movement whenever there is any difference
// left fixes that, and clamping to the target stops the forced step overshooting.
uint easeTowards(uint current, float target, float rate) {
    float old = float(current);
    float next = old + (target - old) * rate;
    if (target > old)      next = clamp(max(next, old + 1.0f), old, target);
    else if (target < old) next = clamp(min(next, old - 1.0f), target, old);
    return uint(max(next, 0.0f));
}

// FUNCTION: cloudTouchesRain
// Whether any of the six face neighbours holds a raincloud. Faces only, not the 26-cell shell:
// "touching" should mean touching, and a diagonal contact spreading the rain would let it jump
// through the gap between two blocks that are not themselves connected.
bool cloudTouchesRain(ivec3 pos) {
    for (int i = 0; i < 6; i++) {
        ivec3 n = pos + getOrthoDir(i);
        if (!cloudCellInBounds(n)) continue;
        if (getCloudKind(cloudCells[getIndex(n)]) == CLOUD_RAIN) return true;
    }
    return false;
}

// FUNCTION: cloudColumnBase
// Where a column's four census words start. x and z only -- the whole point is that the renderer
// can answer "how much cloud is over this spot" without marching the column.
uint cloudColumnBase(int x, int z) { return uint(x + z * WIDTH) * 4u; }

// FUNCTION: cloudIsAtRest
// A cloud block that did not move on the last dispatch. Steam condenses onto these, so it has to
// mean "settled" rather than merely "present": condensing against a block still on its way up would
// turn a rising column into cloud from the bottom and fill the sky from the wrong end.
bool cloudIsAtRest(uint v) {
    return getCloudKind(v) != CLOUD_NONE && !getCloudMoved(v);
}

// FUNCTION: hash
float hash(vec3 p) {
    return fract(sin(dot(p, vec3(12.9898f, 78.233f, 45.164f))) * 43758.5453f);
}

// =================================================================================================
// LAVA
//
// Four voxel types, hottest to coldest, plus dark stone. The stage is NOT independent state: lava
// stores a single 8-bit "coolness" in its age byte and the type is a denormalised view of it, so
// the two can never contradict each other. Everything that should cool lava feeds that one number --
// water flashed to steam, moisture boiled out of soil, and time spent sitting still -- which is what
// lets "cooled because it drank" and "cooled because it settled" be the same rule rather than two
// clocks that could disagree.
//
// Dark stone keeps the same number, high. That is the whole trick behind the sharing rules: lava
// meeting lava and lava meeting dark stone are one diffusion step in whichever direction the
// gradient runs, and stone re-melts exactly when contact drags it back under the solidify point.
// =================================================================================================
const uint LAVA_HOTTEST = 8u;
const uint LAVA_COLDEST = 11u;
const uint DARK_STONE = 12u;

// Declared up here with the other material ids rather than down in the TREES block, because the
// things that eat, burn and melt a tree are all defined before it -- locusts graze on leaves, fire
// takes them and lava voids them outright, so the id has to exist before any of those can name it.
const uint TREE_TRUNK = 18u;
const uint TREE_LEAF = 19u;

// FUNCTION: isLava
bool isLava(uint type) { return type >= LAVA_HOTTEST && type <= LAVA_COLDEST; }

// FUNCTION: lavaSolidifyCoolness
// Coolness at which lava becomes dark stone: one stage past the coldest, so the four stages divide
// the run-up evenly and the last one is not a dead band.
uint lavaSolidifyCoolness() { return min(max(tuning.lavaStageSize, 1u) * 4u, 255u); }

// FUNCTION: lavaTypeFor
uint lavaTypeFor(uint coolness) {
    return LAVA_HOTTEST + min(coolness / max(tuning.lavaStageSize, 1u), 3u);
}

// FUNCTION: lavaSpawnCoolness
// Seed value for a stage placed straight from the material dropdown. Without it a hand-placed
// stage-3 voxel would carry coolness 0 and be retyped back to stage 0 on its very first update.
uint lavaSpawnCoolness(uint type) {
    if (type == DARK_STONE) return lavaSolidifyCoolness();
    if (isLava(type)) return (type - LAVA_HOTTEST) * max(tuning.lavaStageSize, 1u);
    return 0u;
}

// =================================================================================================
// LOCUSTS
//
// Five voxel types, sparsest to densest, over one 8-bit head count in the age byte. Exactly the lava
// arrangement: the stage is a denormalised view of the number, not independent state, so a swarm's
// look and its size can never contradict each other.
//
// The other two bytes are shared rather than dedicated, because a swarm is only ever doing one of
// two things and they need different state:
//
//   age   -- head count, 1..locustMaxSize. Zero is death, so it is never stored.
//   sleep -- position within the current locust tick. NOT the engine's sleep/wake counter; a swarm
//            is never dormant, it is starving on a clock, so the byte is free for the clock itself.
//   dir   -- the eat timer when standing on grass, and packed heading+steps when not. Which one it
//            means is read off the grid (is there grass under me?) rather than stored, so there is
//            no third state to keep consistent. The one hazard is a swarm STEPPING onto grass with
//            navigation bits still in the byte, which would read as a meal already part-eaten --
//            locustArriveDir exists solely to clear it at the moment of arrival.
// =================================================================================================
const uint LOCUST_SPARSEST = 13u;
const uint LOCUST_DENSEST = 17u;

// FUNCTION: isLocust
bool isLocust(uint type) { return type >= LOCUST_SPARSEST && type <= LOCUST_DENSEST; }

// FUNCTION: locustMaxCount
uint locustMaxCount() { return max(tuning.locustMaxSize, 1u); }

// FUNCTION: locustStage
uint locustStage() { return max(tuning.locustStageSize, 1u); }

// FUNCTION: locustTypeFor
// Head count to visual stage. Bands are [1..s], [s+1..2s], ... so a count sitting exactly on a band
// edge belongs to the lower band -- which is what makes locustSpawnCount's round trip exact.
uint locustTypeFor(uint count) {
    uint stage = (count == 0u) ? 0u : (count - 1u) / locustStage();
    return LOCUST_SPARSEST + min(stage, 4u);
}

// FUNCTION: locustSpawnCount
// Seed head count for a stage placed straight from the material dropdown, the same job
// lavaSpawnCoolness does. Returns the TOP of the stage's band, which is why the placeable stage
// starts at exactly locustSpawnSize with no special case: at the default stage size of 10 the third
// band tops out at 30, and locustTypeFor(30) lands back on that same third band.
uint locustSpawnCount(uint type) {
    if (!isLocust(type)) return 0u;
    return min((type - LOCUST_SPARSEST + 1u) * locustStage(), locustMaxCount());
}

// FUNCTION: locustEatTicks
// How many locust ticks a swarm needs to strip one grass block. Interpolated across the whole live
// range so a bigger swarm eats faster: the cap takes locustEatTicksMin, a swarm down to its last
// stage takes locustEatTicksMax, and everything between is linear.
uint locustEatTicks(uint count) {
    uint fast = tuning.locustEatTicksMin;
    uint slow = tuning.locustEatTicksMax;
    uint cap = locustMaxCount();
    uint floorCount = min(locustStage(), cap);

    if (count >= cap) return fast;
    if (count <= floorCount || cap == floorCount) return slow;

    float t = float(count - floorCount) / float(cap - floorCount);
    return uint(round(mix(float(slow), float(fast), t)));
}

// FUNCTION: locustInBounds
// The interior test, matching the one main() applies to the invocation itself -- the outer shell is
// walled off, so a swarm must never be written into it.
bool locustInBounds(ivec3 p) {
    return p.x > 0 && p.x < WIDTH - 1 && p.y > 0 && p.y < HEIGHT - 1 && p.z > 0 && p.z < DEPTH - 1;
}

// FUNCTION: isGrassBlock / grassAt
// Grass is a range on dirt's flora byte, not a type: 1..10 is bare soil warming up, 11..100 is
// visible grass, and past 100 it is drowning. Only the middle band counts as grass -- it is what
// locusts eat and what a tree will seed a sapling onto.
bool isGrassBlock(uint value) {
    uint flora = (value >> 8) & 0xFFu;
    return getType(value) == 4u && flora > 10u && flora <= 100u;
}

// FUNCTION: isLocustFood
// What a swarm will stand on and eat. Grass, and the leaves of a tree.
//
// Leaves need no special case anywhere else because they are already solid: a swarm walks onto a
// canopy exactly as it walks onto the ground, and "the block under me is food" is then the same
// test it always was. Eating one drops the swarm through the hole it just made, which is precisely
// what a swarm stripping a canopy should look like.
bool isLocustFood(uint value) {
    return isGrassBlock(value) || getType(value) == TREE_LEAF;
}

// FUNCTION: locustFoodAt
bool locustFoodAt(ivec3 p) {
    if (p.x < 0 || p.x >= WIDTH || p.y < 0 || p.y >= HEIGHT || p.z < 0 || p.z >= DEPTH) return false;
    return isLocustFood(readCell(getIndex(p)));
}

// FUNCTION: locustPackNav / locustHeading / locustSteps
// Heading in the low 3 bits, steps left in the run in the next 3. Two bits spare.
uint locustPackNav(uint heading, uint steps) { return (heading & 7u) | ((min(steps, 7u)) << 3); }
uint locustHeading(uint dirByte) { return dirByte & 7u; }
uint locustSteps(uint dirByte) { return (dirByte >> 3) & 7u; }

// FUNCTION: locustRunSteps
uint locustRunSteps() { return clamp(tuning.locustRunLength, 1u, 7u); }

// FUNCTION: locustReverse
// The about-face for each of getHDir's eight headings. Used for the cliff rule, which turns a swarm
// back rather than letting it walk off an edge.
uint locustReverse(uint d) {
    if (d == 0u) return 1u;
    if (d == 1u) return 0u;
    if (d == 2u) return 3u;
    if (d == 3u) return 2u;
    if (d == 4u) return 7u;
    if (d == 5u) return 6u;
    if (d == 6u) return 5u;
    return 4u;
}

// FUNCTION: locustHasGrip
// Is there anything at this level for a swarm to hold on to? True if any of the eight horizontal
// neighbours is solid.
//
// This is what makes the climb rule work at all. Gravity and the upward step are applied in the same
// tick, so without it every climb is undone the instant it is made: a swarm steps up the face of a
// wall, finds nothing beneath it next tick, and drops straight back down. It can then only ever
// mount an obstacle exactly one block tall -- anything higher and it oscillates at the foot of it
// forever, which is not "prefer to go upward" in any useful sense.
//
// Clinging is also the honest reading of what a locust is. Insects hold on to vertical surfaces;
// falling off the moment they leave the floor is sand behaviour, not swarm behaviour.
bool locustHasGrip(ivec3 pos) {
    for (int d = 0; d < 8; d++) {
        ivec3 n = pos + getHDir(d);
        if (n.x <= 0 || n.x >= WIDTH - 1 || n.z <= 0 || n.z >= DEPTH - 1) continue;
        if (readCell(getIndex(n)) != 0u) return true;
    }
    return false;
}

// FUNCTION: locustArriveDir
// The dir byte a swarm should carry into `dest`. Zero when it is landing on grass, because there the
// byte is the eat timer and navigation bits left in it would read as a meal already part eaten --
// a swarm could finish a block it had only just stepped onto.
uint locustArriveDir(ivec3 dest, uint nav) {
    return locustFoodAt(dest + ivec3(0, -1, 0)) ? 0u : nav;
}

// =================================================================================================
// TREES
//
// Two types over one idea each. A TRUNK holds drawn-up water in its age byte and its height above
// the soil in dir; a LEAF holds its distance from the nearest trunk in its age byte, and nothing
// else. Both are pure functions of the grid around them, so neither needs a growth plan stored
// anywhere -- a forest is emergent rather than authored.
//
// Water only ever enters at the bottom, out of soil moisture, and is passed up the column one voxel
// at a time. That is what keeps a tree honest: its height, its canopy and its ability to seed the
// grass beside it are all paid for out of the ground it is standing in, and it will not drink the
// soil below treeSoilReserve -- the moisture grass itself needs to grow. A forest therefore thins
// itself out on dry ground and thickens after rain without any rule saying so.
//
// The leaf distance is doing more work than it looks. It bounds the canopy, it makes two trees whose
// crowns overlap merge into one continuous roof rather than two balls, and it is the test for
// whether a leaf is still attached to anything -- a leaf with no closer neighbour has had its tree
// taken out from under it and falls.
// =================================================================================================
// A detached leaf carries this in place of a distance. It sits outside every value an attached leaf
// can hold -- treeLeafReach is clamped far below it -- so one byte does double duty as "how far from
// the crown" and "no longer part of a tree" with no third state to keep in sync.
const uint LEAF_DETACHED = 255u;

// FUNCTION: isTree
bool isTree(uint type) { return type == TREE_TRUNK || type == TREE_LEAF; }

// FUNCTION: treeInBounds
bool treeInBounds(ivec3 p) {
    return p.x > 0 && p.x < WIDTH - 1 && p.y > 0 && p.y < HEIGHT - 1 && p.z > 0 && p.z < DEPTH - 1;
}

// FUNCTION: tree26
// The 26 surrounding offsets, centre skipped. Index 13 of a 3x3x3 walk IS the centre, so stepping
// the index past it is all the skipping that is needed.
ivec3 tree26(int i) {
    int j = (i >= 13) ? i + 1 : i;
    return ivec3(j % 3, (j / 3) % 3, j / 9) - ivec3(1);
}

// FUNCTION: incWater / decWater
// waterVoxelCount tracks exactly one thing: how many type-2 water voxels currently exist in
// the grid. Not "water in the system" -- water stored as soil moisture or as airborne steam is
// deliberately NOT counted, because those are different storage forms with their own state.
// Keeping this to a single, directly-observable meaning is what makes the conservation loop
// auditable: water voxel -> steam (dec) -> vents off the top as a cloud block -> that block rides
// the storm back down and becomes water again (inc), and soil absorption (dec) / percolation (inc)
// balance against each other. Every transition that creates or destroys a water voxel must call
// one of these. decWater relies on uint wraparound (adding 0xFFFFFFFFu == -1 under modular
// arithmetic) since atomicAdd has no signed form.
void incWater() { atomicAdd(waterVoxelCount, 1u); }
void decWater() { atomicAdd(waterVoxelCount, 0xFFFFFFFFu); }

// FUNCTION: getRainThreshold
// Was a compile-time `const` before its input moved into the TuningParams UBO; GLSL const
// initializers can't reference a uniform, so it's computed on demand here instead.
uint getRainThreshold() { return tuning.rainStartLayers * LAYER_SIZE; }

// =================================================================================================
// BLACK HOLE TABLE
//
// A slot holds a black hole's voxel index with the top bit set, so 0 is unambiguously "free" even
// though voxel index 0 is a real (if unreachable) address. 128^3 needs 21 bits, leaving bit 31
// free for the flag.
// =================================================================================================
const uint BH_ACTIVE = 0x80000000u;
// The index occupies bits 0..29, which covers any world up to 1024^3 -- comfortably past the 512
// config ceiling -- leaving bit 30 for the purge flag and bit 31 for "slot in use". BH_PURGE marks the one enormous hole the Clear Grid button drops: same voxel, same
// orbit and void code, but unlimited reach, a size taken straight from its mass, and a much shorter
// fuse before it gives up and shrinks away.
const uint BH_INDEX_MASK = 0x3FFFFFFFu;
const uint BH_PURGE = 0x40000000u;

// FUNCTION: bhDecode
ivec3 bhDecode(uint code) {
    uint i = code & BH_INDEX_MASK;
    return ivec3(int(i % uint(WIDTH)), int((i / uint(WIDTH)) % uint(HEIGHT)), int(i / uint(WIDTH * HEIGHT)));
}

// FUNCTION: bhIsPurge
bool bhIsPurge(uint code) { return (code & BH_PURGE) != 0u; }

// FUNCTION: bhRegister
// Claims a slot for a new hole, or reports failure when the table is full -- the caller must not
// place the voxel unless this succeeds, or the grid would hold a black cube that pulls on nothing.
bool bhRegister(ivec3 p) {
    uint code = BH_ACTIVE | getIndex(p);
    for (int i = 0; i < BLACK_HOLE_MAX; i++) {
        if (atomicCompSwap(blackHoles[i], 0u, code) == 0u) {
            blackHoleMass[i] = 0u;   // a fresh hole starts at level 0, whatever the last tenant ate
            blackHoleStarve[i] = 0u; // and gets a full grace period before it can evaporate
            return true;
        }
    }
    return false;
}

// FUNCTION: bhRelease
void bhRelease(ivec3 p) {
    uint code = BH_ACTIVE | getIndex(p);
    for (int i = 0; i < BLACK_HOLE_MAX; i++) {
        atomicCompSwap(blackHoles[i], code, 0u);
    }
}

// FUNCTION: bhBodyRadius
// The hole's body is a ball, so its diameter runs 1, 3, 5, ... voxels as it grows.
float bhBodyRadius(uint level) { return float(level) + 0.5f; }

// FUNCTION: bhLevel
// Size of the hole's body. It advances a level once it has swallowed as many voxels as the next size
// would itself occupy, so its body ends up about as big as what it ate.
//
// Derived from the swallowed count rather than stored alongside it. There is deliberately no
// separate "current size" field to keep in step: the drawn body and the eaten total cannot disagree
// if only one of them exists, and the growth threshold can be retuned in the config without
// stranding holes at a size they could no longer justify.
//
// DUPLICATED IN raymarch.frag -- the renderer sizes the body from the same count, so if you change
// the curve here you MUST change it there or the drawn body will stop matching the one that eats.
uint bhLevel(uint mass) {
    uint level = 0u;
    for (uint l = 1u; l <= min(tuning.blackHoleMaxLevel, 16u); l++) {
        float r = bhBodyRadius(l);
        float volume = 4.18879f * r * r * r; // 4/3 pi r^3
        if (float(mass) < tuning.blackHoleGrowthCost * volume) break;
        level = l;
    }
    return level;
}

// FUNCTION: bhLevelFor
// Body size for a table slot. Normal holes derive it from the growth curve; the purge hole ramps
// linearly from its starting mass instead, so it melts away smoothly rather than stepping down
// through the growth stages backwards -- and neither shader has to re-derive a volume formula to
// know how big it should be drawn.
uint bhLevelFor(uint code, uint mass) {
    if (bhIsPurge(code)) {
        return uint(float(tuning.purgeLevel) * clamp(float(mass) / float(max(tuning.purgeMass, 1u)), 0.0f, 1.0f));
    }
    return bhLevel(mass);
}

// FUNCTION: bhPlaneNormal
// One candidate orbital plane out of the hole's fan, as its normal.
//
// Spread over a HEMISPHERE, not a full sphere: n and -n describe the same plane, so sampling the
// whole sphere would produce pairs of near-identical candidates for a particle to flip between.
// z is uniform in (0,1), which is uniform by area on a hemisphere, and the golden angle keeps
// successive normals from clumping into a stripe. `seed` rotates the whole fan per hole so two
// holes side by side don't share inclinations.
vec3 bhPlaneNormal(int k, int planeCount, float seed) {
    float z = (float(k) + 0.5f) / float(planeCount);
    float r = sqrt(max(0.0f, 1.0f - z * z));
    float a = 2.399963f * float(k) + seed; // golden angle
    return vec3(r * cos(a), z, r * sin(a));
}

// FUNCTION: bhOrbitAxis
// The axis of the orbit this particle is on -- the signed normal of its own plane.
//
// A great circle through the centre lies in a plane that CONTAINS the particle's position, and that
// is what makes a purely geometric choice self-sustaining: the particle takes whichever candidate
// most nearly contains it right now, and because its orbit then keeps it inside that plane, the same
// candidate keeps winning on every later tick. Each plane's "winning region" is the band around its
// own great circle, so an orbit never wanders out of the region that selected it.
//
// Hashing a plane per particle instead cannot work here. Nothing identifies a particle across ticks
// -- there is no id to hash, only a position, and a position-seeded plane would re-roll the instant
// the particle moved, producing a random walk rather than an orbit.
//
// The circulation sense is hashed per plane index, which is stable because the index is, so roughly
// half the fan runs retrograde and the shell doesn't read as all-one-way swirl.
vec3 bhOrbitAxis(ivec3 center, ivec3 pos) {
    vec3 radial = normalize(vec3(pos - center));
    int planeCount = int(clamp(tuning.blackHoleOrbitPlanes, 1u, 32u));
    float seed = hash(vec3(center) + vec3(29.0f, 3.0f, 71.0f)) * 6.28318f;

    vec3 best = vec3(0.0f, 1.0f, 0.0f);
    float bestAlign = 2.0f;
    int bestK = 0;

    for (int k = 0; k < planeCount; k++) {
        vec3 n = bhPlaneNormal(k, planeCount, seed);
        float align = abs(dot(n, radial)); // 0 when the plane contains the particle exactly
        if (align < bestAlign) {
            bestAlign = align;
            best = n;
            bestK = k;
        }
    }

    float sense = (hash(vec3(center) + vec3(float(bestK) * 13.0f, 101.0f, 47.0f)) < 0.5f) ? -1.0f : 1.0f;
    return best * sense;
}

// FUNCTION: inBrush
// The set of voxels the spawn brush writes. Cube bounds are tested first because they are cheap and
// are exactly the region the box cursor draws; the sphere test then carves the round brush out of
// that.
//
// The sphere test is done entirely in world coordinates -- voxel CENTRES against a centre derived
// from the same bounds the renderer's outline uses -- because a voxel's integer position is its min
// corner, and testing corners instead would place the sphere half a voxel off the one drawn.
bool inBrush(ivec3 pos) {
    int halfMin = pc.spawnSize / 2;
    int halfMax = (pc.spawnSize - 1) / 2;

    if (pos.x < pc.spawnX - halfMin || pos.x > pc.spawnX + halfMax) return false;
    if (pos.y < pc.spawnY - halfMin || pos.y > pc.spawnY + halfMax) return false;

    if (pos.z < pc.spawnZ - halfMin || pos.z > pc.spawnZ + halfMax) return false;

    if (pc.spawnShape != 1) return true;

    vec3 center = vec3(pc.spawnX, pc.spawnY, pc.spawnZ) + vec3(float(halfMax - halfMin + 1) * 0.5f);
    vec3 d = (vec3(pos) + 0.5f) - center;
    float radius = float(pc.spawnSize) * 0.5f;
    return dot(d, d) <= radius * radius;
}

// FUNCTION: tryMove
bool tryMove(uint currentIndex, uint currentValue, uint targetIndex, uint newValue) {
    uint targetValue = readCell(targetIndex);
    uint targetType = getType(targetValue);
    uint currentType = getType(currentValue);

    if (targetType == 0u || ((currentType == 1u || currentType == 4u) && targetType == 2u) || (currentType == 6u && targetType == 5u)) {
        if (atomicCompSwap(grid[currentIndex], currentValue, 0u) == currentValue) {
            uint actual = atomicCompSwap(grid[targetIndex], targetValue, newValue);
            if (actual == targetValue) {
                if (targetType != 0u) {
                    atomicExchange(grid[currentIndex], targetValue); 
                }
                return true;
            } else {
                atomicCompSwap(grid[currentIndex], 0u, currentValue);
            }
        }
    }
    return false;
}

// FUNCTION: tryDisplace
bool tryDisplace(uint currentIndex, uint currentValue, uint targetIndex, uint targetValue, uint pushIndex) {
    if (atomicCompSwap(grid[currentIndex], currentValue, 0u) == currentValue) {
        uint displacedValue = pack(getType(targetValue), 0u, 0u, 0u); 
        uint actualPush = atomicCompSwap(grid[pushIndex], 0u, displacedValue);
        
        if (actualPush == 0u) {
            uint actualTarget = atomicCompSwap(grid[targetIndex], targetValue, currentValue);
            if (actualTarget == targetValue) {
                return true;
            } else {
                atomicCompSwap(grid[pushIndex], displacedValue, 0u);
            }
        }
        atomicCompSwap(grid[currentIndex], 0u, currentValue);
    }
    return false;
}


// FUNCTION: orbitStep
// Moves a captured particle one cell along `stepDir`, into empty space only. Orbiting matter
// deliberately does NOT get the displacement rules the falling materials have: two particles
// arriving at the same cell should queue up behind each other, because that queueing is what gives
// the shell visible density instead of letting everything pass through everything else.
bool orbitStep(ivec3 pos, uint currentIndex, uint rawValue, ivec3 stepDir) {
    if (stepDir == ivec3(0)) return false;

    ivec3 target = pos + stepDir;
    if (target.x < 1 || target.x >= WIDTH - 1 ||
        target.y < 1 || target.y >= HEIGHT - 1 ||
        target.z < 1 || target.z >= DEPTH - 1) return false;

    uint targetIndex = getIndex(target);
    if (getType(readCell(targetIndex)) != 0u) return false;

    return tryMove(currentIndex, rawValue, targetIndex,
                   pack(getType(rawValue), getDir(rawValue), 0u, getAge(rawValue)));
}

// FUNCTION: dominantAxis
// Collapses a continuous direction onto the 26 lattice steps: the largest component always steps,
// and the others join in when they are within 55% of it, which is what produces diagonal moves.
ivec3 dominantAxis(vec3 dir, float relative) {
    vec3 a = abs(dir);
    float m = max(a.x, max(a.y, a.z));
    if (m <= 0.0f) return ivec3(0);
    return ivec3(greaterThanEqual(a, vec3(m * relative))) * ivec3(sign(dir));
}

// FUNCTION: updateOrbital
// One tick of a particle held by a black hole. This replaces the particle's own material update
// outright -- captured matter is on an orbit, not falling -- which is the whole reason the shell
// stays up instead of raining down onto the hole.
//
// There is no force, acceleration or velocity anywhere in here, and nowhere to put one: a voxel has
// three spare bytes, all of them already spoken for by the materials. So a "gravity well" is instead
// a direction field sampled fresh every tick, plus two probabilities. The direction is purely
// sideways -- tangent to the particle's own orbital plane (see bhOrbitAxis), corrected back toward
// that plane -- and the two rolls supply everything a magnitude normally would:
//
//   speed  -- how OFTEN a step is taken, ~speed/sqrt(distance), reproducing the Keplerian shear
//             that makes inner orbits visibly outrun outer ones.
//   infall -- how often that step spirals inward instead of continuing around, which is what makes
//             the orbit decay over many revolutions rather than in one.
//
// Both are probabilities for the same reason: a move is exactly one voxel, so a step has no room to
// carry a magnitude. Encoding either as a vector weight instead fails in a way that looks like it
// works -- see the note on the infall roll below.
void updateOrbital(ivec3 pos, uint currentIndex, uint rawValue, ivec3 center, int slot, uint level, bool purge, float dist, float randVal) {
    uint type = getType(rawValue);
    uint sleep = getSleep(rawValue);

    // Something is captured, so the hole is not starving -- reset the clock before anything else,
    // including before the swallow test, so a hole with matter merely orbiting it stays alive rather
    // than having to actually eat to survive. A plain store rather than an atomic: every captured
    // particle writes the same constant, so racing writes all agree, and the counter only ever feeds
    // a coarse "has this hole seen anything lately" decision.
    blackHoleStarve[slot] = 0u;

    // A hole voids a spherical shell around itself, not just the voxels its body occupies:
    // everything within body radius + horizon. The horizon is an offset PAST the body rather than an
    // absolute distance, so the cleared region stays tied to the size the hole is drawn at as it
    // grows, and the hole never sits flush against whatever it is eating.
    if (dist <= bhBodyRadius(level) + float(tuning.blackHoleHorizon)) {
        if (atomicCompSwap(grid[currentIndex], rawValue, 0u) == rawValue) {
            // Credited only on a successful swap, so two invocations racing the same voxel can
            // never both bill it -- the hole's size is a running total and would drift permanently.
            //
            // The purge hole is not credited at all. Its size is a fixed ramp off its starting mass,
            // and letting it grow on a whole world's worth of matter would leave it enormous with a
            // correspondingly long shrink, turning a quick flourish into a wait.
            if (!bhIsPurge(blackHoles[slot])) atomicAdd(blackHoleMass[slot], 1u);

            if (type == 2u) {
                // No high mark to bring down any more: a storm's size is the cloud that fell, not a
                // debt measured against a peak water level, so water swallowed by a hole simply
                // stops existing and the sky never knew about it either way.
                decWater();
            }
        }
        return;
    }

    // Held but not moving this tick. Sleep is still cleared: the particle skipped its material
    // update, and a stale sleep counter would leave it frozen once it drifts back out of range.
    // The purge hole pulls on its own terms -- see the note in Config.hpp; the normal figures would
    // make clearing the grid a 35 second wait.
    float orbitSpeed = purge ? tuning.purgeOrbitSpeed : tuning.blackHoleOrbitSpeed;
    float infallChance = purge ? tuning.purgeInfall : tuning.blackHoleInfall;

    if (randVal > clamp(orbitSpeed / sqrt(max(dist, 1.0f)), 0.0f, 1.0f)) {
        if (sleep != 0u) {
            atomicCompSwap(grid[currentIndex], rawValue, pack(type, getDir(rawValue), 0u, getAge(rawValue)));
        }
        return;
    }

    vec3 inward = normalize(vec3(center - pos));
    vec3 axis = bhOrbitAxis(center, pos);

    vec3 tangent = cross(axis, inward);
    float tangentLen = length(tangent);
    if (tangentLen < 0.05f) {
        // The chosen plane nearly contains the particle, so this is rare -- but a particle sitting
        // on its own axis has no direction to travel. Any perpendicular gets it moving, after which
        // the field takes over.
        tangent = normalize(cross(axis, vec3(0.577f, 0.577f, 0.577f)));
    } else {
        tangent /= tangentLen;
    }

    // Cancel whatever drift has accumulated along the plane's normal. Without this the orbit is
    // free to wander off its plane and the whole shell degenerates into a formless cloud.
    float axial = dot(vec3(pos - center), axis);
    vec3 grip = -axis * clamp(axial * 0.5f, -1.0f, 1.0f) * tuning.blackHolePlaneGrip;

    // Direction to travel along the orbit. Safe to normalize: tangent is a unit vector orthogonal
    // to grip, so the sum can never cancel to zero however grip is weighted. Infall is deliberately
    // NOT blended in here -- see the roll below.
    vec3 along = normalize(tangent + grip);

    // Infall has to be a PROBABILITY rather than a component of the direction, and the reason is not
    // obvious: blending it into the direction looks like it works and then quietly stops.
    //
    // A one-voxel move quantises direction to the 26 lattice neighbours. A small inward term does
    // bend some of those steps inward, so the orbit really does decay at first -- but only down to a
    // radius fixed by the infall weight, where the orbit locks into a closed lattice loop whose
    // rounding error exactly cancels the inward bias. That loop is a stable attractor, not a
    // coincidence: at the 0.16 default a particle released anywhere between r=10 and r=28 settles
    // onto the SAME r~6.7 cycle, 36 steps around, and orbits it forever without ever reaching the
    // horizon. Matter parked in mid-air near a hole is this.
    //
    // Rolling for infall removes the attractor, because there is no longer a fixed direction field
    // to lock into: decay becomes reliable at every radius, and a particle from r=28 reaches the
    // horizon in ~460 steps. It also mirrors how orbital SPEED is handled a few lines up, for the
    // same underlying reason -- a one-voxel step has no room to carry a magnitude.
    bool pullIn = fract(randVal * 61.0f) < clamp(infallChance, 0.0f, 1.0f);

    // Still mostly sideways when it does fall, so infall reads as the spiral tightening rather than
    // the particle abruptly dropping out of its orbit.
    vec3 spiral = normalize(inward + tangent * 0.6f);

    if (pullIn && orbitStep(pos, currentIndex, rawValue, dominantAxis(spiral, 0.55f))) return;

    if (orbitStep(pos, currentIndex, rawValue, dominantAxis(along, 0.55f))) return;
    if (orbitStep(pos, currentIndex, rawValue, dominantAxis(along, 1.0f))) return;
    // Blocked in the direction it wants, so slide along the ring instead. A jammed orbit is
    // traffic that clears as the particles ahead move on -- never a reason to drop out of the orbit.
    if (orbitStep(pos, currentIndex, rawValue, dominantAxis(tangent, 1.0f))) return;

    // Last resort: inward. Captured matter packs tight enough to gridlock -- every particle wanting
    // a tangential cell that another captured particle already occupies -- and with no inward option
    // that jam never breaks, which is the second way matter ends up hanging in space. Dropping
    // inward when the ring is blocked lets a clump drain from its inner edge, where the horizon is
    // already eating it.
    if (orbitStep(pos, currentIndex, rawValue, dominantAxis(inward, 0.55f))) return;
    if (orbitStep(pos, currentIndex, rawValue, dominantAxis(inward, 1.0f))) return;

    if (sleep != 0u) {
        atomicCompSwap(grid[currentIndex], rawValue, pack(type, getDir(rawValue), 0u, getAge(rawValue)));
    }
}

// FUNCTION: captureByBlackHole
// Scans the table and hands the particle to the nearest hole whose influence it is inside.
// Returns false for the overwhelmingly common case of a particle nowhere near one.
bool captureByBlackHole(ivec3 pos, uint currentIndex, uint rawValue, float randVal) {
    if (blackHoleCount == 0u) return false;

    float bestDistSq = 3.0e9f;
    ivec3 bestCenter = ivec3(0);
    int bestSlot = -1;
    uint bestLevel = 0u;
    bool bestPurge = false;

    // Widest reach any hole could possibly have. Every solid voxel in the grid runs this loop every
    // dispatch, so the distance test has to come BEFORE bhLevel -- deriving a level per slot per
    // voxel would put a growth-threshold search on the hot path for the whole grid, to answer a
    // question that only matters for voxels already near a hole.
    float maxRadius = float(tuning.blackHoleRadius + min(tuning.blackHoleMaxLevel, 16u));
    float maxRadiusSq = maxRadius * maxRadius;

    for (int i = 0; i < BLACK_HOLE_MAX; i++) {
        uint code = blackHoles[i];
        if (code == 0u) continue;

        ivec3 center = bhDecode(code);
        vec3 d = vec3(center - pos);
        float distSq = dot(d, d);

        // The purge hole is exempt from the cheap pre-reject: its whole job is to reach every voxel
        // in the grid at once, so there is no radius to reject against.
        bool purge = bhIsPurge(code);
        if (!purge && (distSq > maxRadiusSq)) continue;
        if (distSq >= bestDistSq) continue;

        // Reach grows with the body, one voxel per level, so a hole that has eaten a dune pulls on
        // a wider field than the pinprick it started as.
        uint level = bhLevelFor(code, blackHoleMass[i]);
        float radius = purge ? 1.0e9f : float(tuning.blackHoleRadius + level);

        if (distSq <= radius * radius) {
            bestDistSq = distSq;
            bestCenter = center;
            bestSlot = i;
            bestLevel = level;
            bestPurge = purge;
        }
    }

    if (bestSlot < 0) return false;

    updateOrbital(pos, currentIndex, rawValue, bestCenter, bestSlot, bestLevel, bestPurge, sqrt(bestDistSq), randVal);
    return true;
}

// FUNCTION: grainCanMove
// Cheap precondition for a grain's entire falling path: five reads answering "is there anywhere at
// all for this to go".
//
// A grain buried in a settled dune answers no, and that lets everything below be skipped -- most
// importantly the 3x3x3 cohesion scan, which is 27 reads spent deciding whether a grain that has
// nowhere to go should stick. Wet settled sand was paying 47 reads a tick forever to reach that
// conclusion; dry sand escaped it only because the cohesion test is gated on moisture, which is why
// this never showed up until it rained.
//
// Behaviour-preserving rather than a trade: cohesion only ever gates a move, so when no move is
// possible its value cannot be observed.
bool grainCanMove(ivec3 pos) {
    if (pos.y <= 1) return false;

    for (int i = 0; i < 5; i++) {
        ivec3 target = pos + ivec3((i == 1) ? 1 : ((i == 2) ? -1 : 0), -1,
                                   (i == 3) ? 1 : ((i == 4) ? -1 : 0));
        if (target.x <= 0 || target.x >= WIDTH - 1 || target.z <= 0 || target.z >= DEPTH - 1) continue;
        uint t = getType(readCell(getIndex(target)));
        if (t == 0u || t == 2u) return true; // empty to fall into, or water to displace
    }
    return false;
}

// FUNCTION: updateSand
void updateSand(ivec3 pos, uint currentIndex, uint rawValue, uint currentSleep, uint currentAge, float randVal) {
    uint moisture = currentAge;
    bool moistureModified = false;
    
    if (moisture < tuning.sandMoistureCapacity) {
        int startDir = int(fract(randVal * 17.0f) * 6.0f);
        for(int i = 0; i < 6; i++) {
            int d = (startDir + i) % 6;
            if (d != 2) {
                ivec3 nPos = pos + getOrthoDir(d);
                if (nPos.x > 0 && nPos.x < WIDTH-1 && nPos.y > 0 && nPos.y < HEIGHT-1 && nPos.z > 0 && nPos.z < DEPTH-1) {
                    uint nIndex = getIndex(nPos);
                    uint nVal = readCell(nIndex);

                    if (getType(nVal) == 2u) {
                        if (atomicCompSwap(grid[nIndex], nVal, 0u) == nVal) {
                            atomicAdd(grid[currentIndex], tuning.sandWaterAbsorbUnit << 24);
                            decWater(); // water voxel consumed into soil moisture
                            moistureModified = true;
                            break;
                        }
                    }
                }
            }
        }
    }

    if (!moistureModified && moisture > 0u) {
        int d = int(fract(randVal * 31.0f) * 6.0f);
        if (d != 2) {
            ivec3 nPos = pos + getOrthoDir(d);
            if (nPos.x > 0 && nPos.x < WIDTH-1 && nPos.y > 0 && nPos.y < HEIGHT-1 && nPos.z > 0 && nPos.z < DEPTH-1) {
                uint nIndex = getIndex(nPos);
                uint nVal = readCell(nIndex);
                uint nType = getType(nVal);

                if (nType == 1u || nType == 4u) {
                    uint nMoisture = getAge(nVal);
                    uint nCapacity = (nType == 4u) ? tuning.dirtMoistureCapacity : tuning.sandMoistureCapacity;

                    if (moisture > nMoisture + 1u && nMoisture < nCapacity) {
                        atomicAdd(grid[currentIndex], 0xFF000000u);
                        atomicAdd(grid[nIndex], 1u << 24);
                        moistureModified = true;
                    }
                }
            }
        }
    }

    if (!moistureModified && moisture >= tuning.sandWaterAbsorbUnit) {
        ivec3 leakPos = pos + ivec3(0, -1, 0);
        if (leakPos.y > 0 && getType(readCell(getIndex(leakPos))) == 0u) {
            if (atomicCompSwap(grid[getIndex(leakPos)], 0u, pack(2u, 0u, 0u, 0u)) == 0u) {
                // Release exactly what one absorption stored. Was hardcoded 0xA6000000u, which
                // is (-90 << 24) and so silently assumed sandWaterAbsorbUnit == 90; deriving it
                // keeps percolation balanced if that value is ever retuned in the config.
                atomicAdd(grid[currentIndex], (0u - tuning.sandWaterAbsorbUnit) << 24);
                incWater(); // moisture percolated back out as a real water voxel
                moistureModified = true;
            }
        }
    }

    if (moistureModified) return;

    // Nowhere to go: skip the cohesion scan and the move attempts alike, and just age the sleep
    // counter. This is the difference between a settled dune costing ~11 reads a tick and ~47.
    bool canMove = grainCanMove(pos);

    bool isClumped = false;
    if (canMove && moisture > 0u && currentSleep > tuning.wakeSleepThreshold) {
        int emptyBelowCount = 0;
        if (pos.y > 1) {
            for (int x = -1; x <= 1; x++) {
                for (int z = -1; z <= 1; z++) {
                    ivec3 checkPos = pos + ivec3(x, -1, z);
                    if (checkPos.x >= 0 && checkPos.x < WIDTH && checkPos.z >= 0 && checkPos.z < DEPTH) {
                        if (getType(readCell(getIndex(checkPos))) == 0u) {
                            emptyBelowCount++;
                        }
                    }
                }
            }
        }

        if (emptyBelowCount >= int(tuning.emptyBelowWakeCount)) {
            currentSleep = 0u;
        } else {
            int clumpCount = 0;
            for (int x = -1; x <= 1; x++) {
                for (int y = -1; y <= 1; y++) {
                    for (int z = -1; z <= 1; z++) {
                        if (x == 0 && y == 0 && z == 0) continue;
                        ivec3 nPos = pos + ivec3(x, y, z);
                        if (nPos.x >= 0 && nPos.x < WIDTH && nPos.y >= 0 && nPos.y < HEIGHT && nPos.z >= 0 && nPos.z < DEPTH) {
                            if (getType(readCell(getIndex(nPos))) == 1u) clumpCount++;
                        }
                    }
                }
            }
            if (clumpCount >= int(tuning.sandClumpThreshold)) isClumped = true;
        }
    }

    if (canMove && !isClumped) {
        if (pos.y > 1) {
            ivec3 belowPos = pos + ivec3(0, -1, 0);
            if (getType(readCell(getIndex(belowPos))) == 0u) {
                if (tryMove(currentIndex, rawValue, getIndex(belowPos), pack(1u, 0u, 0u, moisture))) return;
            }
        }

        if (pos.y > 1) {
            int dir = (fract(randVal * 10.0f) > 0.5f) ? 1 : -1;
            ivec3 slidePos1, slidePos2;
            
            if (fract(randVal * 100.0f) > 0.5f) {
                slidePos1 = pos + ivec3(dir, -1, 0); slidePos2 = pos + ivec3(0, -1, dir);
            } else {
                slidePos1 = pos + ivec3(0, -1, dir); slidePos2 = pos + ivec3(dir, -1, 0);
            }

            if (slidePos1.x > 0 && slidePos1.x < WIDTH - 1 && slidePos1.z > 0 && slidePos1.z < DEPTH - 1) {
                if (getType(readCell(getIndex(slidePos1))) == 0u) {
                    if (tryMove(currentIndex, rawValue, getIndex(slidePos1), pack(1u, 0u, 0u, moisture))) return;
                }
            }
            if (slidePos2.x > 0 && slidePos2.x < WIDTH - 1 && slidePos2.z > 0 && slidePos2.z < DEPTH - 1) {
                if (getType(readCell(getIndex(slidePos2))) == 0u) {
                    if (tryMove(currentIndex, rawValue, getIndex(slidePos2), pack(1u, 0u, 0u, moisture))) return;
                }
            }
        }

        if (pos.y > 1) {
            ivec3 belowPos = pos + ivec3(0, -1, 0);
            uint belowIndex = getIndex(belowPos);
            uint belowValue = readCell(belowIndex);
            
            if (getType(belowValue) == 2u) {
                int startDir = int(fract(randVal * 8.0f) * 8.0f);
                for (int i = 0; i < 8; i++) {
                    int d = (startDir + i) % 8;
                    ivec3 pushPos = belowPos + getHDir(d);
                    if (pushPos.x > 0 && pushPos.x < WIDTH - 1 && pushPos.z > 0 && pushPos.z < DEPTH - 1) {
                        if (tryDisplace(currentIndex, pack(1u, 0u, 0u, moisture), belowIndex, belowValue, getIndex(pushPos))) return; 
                    }
                }
                if (tryMove(currentIndex, rawValue, belowIndex, pack(1u, 0u, 0u, moisture))) return;
            }

            int dir = (fract(randVal * 10.0f) > 0.5f) ? 1 : -1;
            ivec3 slidePos[2];
            if (fract(randVal * 100.0f) > 0.5f) {
                slidePos[0] = pos + ivec3(dir, -1, 0); slidePos[1] = pos + ivec3(0, -1, dir);
            } else {
                slidePos[0] = pos + ivec3(0, -1, dir); slidePos[1] = pos + ivec3(dir, -1, 0);
            }

            for (int s = 0; s < 2; s++) {
                ivec3 sPos = slidePos[s];
                if (sPos.x > 0 && sPos.x < WIDTH - 1 && sPos.z > 0 && sPos.z < DEPTH - 1) {
                    uint sIndex = getIndex(sPos);
                    uint sValue = readCell(sIndex);
                    if (getType(sValue) == 2u) {
                        int startDir = int(fract(randVal * 8.0f + float(s)) * 8.0f);
                        for (int i = 0; i < 8; i++) {
                            int d = (startDir + i) % 8;
                            ivec3 pushPos = sPos + getHDir(d);
                            if (pushPos.x > 0 && pushPos.x < WIDTH - 1 && pushPos.z > 0 && pushPos.z < DEPTH - 1) {
                                if (tryDisplace(currentIndex, pack(1u, 0u, 0u, moisture), sIndex, sValue, getIndex(pushPos))) return;
                            }
                        }
                        if (tryMove(currentIndex, rawValue, sIndex, pack(1u, 0u, 0u, moisture))) return;
                    }
                }
            }
        }
    }

    uint newSleep = min(currentSleep + 1u, 255u);
    atomicCompSwap(grid[currentIndex], rawValue, pack(1u, 0u, newSleep, moisture));
}

// FUNCTION: updateDirt
void updateDirt(ivec3 pos, uint currentIndex, uint rawValue, uint currentDir, uint currentSleep, uint currentAge, float randVal) {
    uint moisture = currentAge;
    bool moistureModified = false;
    
    if (moisture < tuning.dirtMoistureCapacity) {
        int startDir = int(fract(randVal * 17.0f) * 6.0f);
        for(int i = 0; i < 6; i++) {
            int d = (startDir + i) % 6;
            ivec3 nPos = pos + getOrthoDir(d);
            if (nPos.x > 0 && nPos.x < WIDTH-1 && nPos.y > 0 && nPos.y < HEIGHT-1 && nPos.z > 0 && nPos.z < DEPTH-1) {
                uint nIndex = getIndex(nPos);
                uint nVal = readCell(nIndex);

                if (getType(nVal) == 2u) {
                    if (atomicCompSwap(grid[nIndex], nVal, 0u) == nVal) {
                        atomicAdd(grid[currentIndex], tuning.sandWaterAbsorbUnit << 24);
                        decWater(); // water voxel consumed into soil moisture
                        moistureModified = true;
                        break;
                    }
                }
            }
        }
    }

    if (!moistureModified && moisture > 0u) {
        int d = int(fract(randVal * 31.0f) * 6.0f);
        ivec3 nPos = pos + getOrthoDir(d);
        if (nPos.x > 0 && nPos.x < WIDTH-1 && nPos.y > 0 && nPos.y < HEIGHT-1 && nPos.z > 0 && nPos.z < DEPTH-1) {
            uint nIndex = getIndex(nPos);
            uint nVal = readCell(nIndex);
            uint nType = getType(nVal);

            if (nType == 4u || nType == 1u) {
                uint nMoisture = getAge(nVal);
                uint nCapacity = (nType == 4u) ? tuning.dirtMoistureCapacity : tuning.sandMoistureCapacity;

                if (moisture > nMoisture + 1u && nMoisture < nCapacity) {
                    atomicAdd(grid[currentIndex], 0xFF000000u);
                    atomicAdd(grid[nIndex], 1u << 24);
                    moistureModified = true;
                }
            }
        }
    }

    if (moistureModified) return;

    bool canMove = grainCanMove(pos);

    bool isClumped = false;
    if (canMove && currentSleep > tuning.wakeSleepThreshold) {
        int emptyBelowCount = 0;
        if (pos.y > 1) {
            for (int x = -1; x <= 1; x++) {
                for (int z = -1; z <= 1; z++) {
                    ivec3 checkPos = pos + ivec3(x, -1, z);
                    if (checkPos.x >= 0 && checkPos.x < WIDTH && checkPos.z >= 0 && checkPos.z < DEPTH) {
                        if (getType(readCell(getIndex(checkPos))) == 0u) {
                            emptyBelowCount++;
                        }
                    }
                }
            }
        }

        if (emptyBelowCount >= int(tuning.emptyBelowWakeCount)) {
            currentSleep = 0u;
        } else {
            int clumpCount = 0;
            for (int x = -1; x <= 1; x++) {
                for (int y = -1; y <= 1; y++) {
                    for (int z = -1; z <= 1; z++) {
                        if (x == 0 && y == 0 && z == 0) continue;
                        ivec3 nPos = pos + ivec3(x, y, z);
                        if (nPos.x >= 0 && nPos.x < WIDTH && nPos.y >= 0 && nPos.y < HEIGHT && nPos.z >= 0 && nPos.z < DEPTH) {
                            if (getType(readCell(getIndex(nPos))) == 4u) clumpCount++;
                        }
                    }
                }
            }
            if (clumpCount >= int(tuning.dirtClumpThreshold)) isClumped = true;
        }
    }

    if (canMove && !isClumped) {
        if (pos.y > 1) {
            ivec3 belowPos = pos + ivec3(0, -1, 0);
            if (getType(readCell(getIndex(belowPos))) == 0u) {
                if (tryMove(currentIndex, rawValue, getIndex(belowPos), pack(4u, 0u, 0u, moisture))) return;
            }
        }

        if (pos.y > 1) {
            int dir = (fract(randVal * 10.0f) > 0.5f) ? 1 : -1;
            ivec3 slidePos1, slidePos2;
            
            if (fract(randVal * 100.0f) > 0.5f) {
                slidePos1 = pos + ivec3(dir, -1, 0); slidePos2 = pos + ivec3(0, -1, dir);
            } else {
                slidePos1 = pos + ivec3(0, -1, dir); slidePos2 = pos + ivec3(dir, -1, 0);
            }

            if (slidePos1.x > 0 && slidePos1.x < WIDTH - 1 && slidePos1.z > 0 && slidePos1.z < DEPTH - 1) {
                if (getType(readCell(getIndex(slidePos1))) == 0u) {
                    if (tryMove(currentIndex, rawValue, getIndex(slidePos1), pack(4u, 0u, 0u, moisture))) return;
                }
            }
            if (slidePos2.x > 0 && slidePos2.x < WIDTH - 1 && slidePos2.z > 0 && slidePos2.z < DEPTH - 1) {
                if (getType(readCell(getIndex(slidePos2))) == 0u) {
                    if (tryMove(currentIndex, rawValue, getIndex(slidePos2), pack(4u, 0u, 0u, moisture))) return;
                }
            }
        }

        if (pos.y > 1) {
            ivec3 belowPos = pos + ivec3(0, -1, 0);
            uint belowIndex = getIndex(belowPos);
            uint belowValue = readCell(belowIndex);
            
            if (getType(belowValue) == 2u) {
                int startDir = int(fract(randVal * 8.0f) * 8.0f);
                for (int i = 0; i < 8; i++) {
                    int d = (startDir + i) % 8;
                    ivec3 pushPos = belowPos + getHDir(d);
                    if (pushPos.x > 0 && pushPos.x < WIDTH - 1 && pushPos.z > 0 && pushPos.z < DEPTH - 1) {
                        if (tryDisplace(currentIndex, pack(4u, 0u, 0u, moisture), belowIndex, belowValue, getIndex(pushPos))) return; 
                    }
                }
                if (tryMove(currentIndex, rawValue, belowIndex, pack(4u, 0u, 0u, moisture))) return;
            }

            int dir = (fract(randVal * 10.0f) > 0.5f) ? 1 : -1;
            ivec3 slidePos[2];
            if (fract(randVal * 100.0f) > 0.5f) {
                slidePos[0] = pos + ivec3(dir, -1, 0); slidePos[1] = pos + ivec3(0, -1, dir);
            } else {
                slidePos[0] = pos + ivec3(0, -1, dir); slidePos[1] = pos + ivec3(dir, -1, 0);
            }

            for (int s = 0; s < 2; s++) {
                ivec3 sPos = slidePos[s];
                if (sPos.x > 0 && sPos.x < WIDTH - 1 && sPos.z > 0 && sPos.z < DEPTH - 1) {
                    uint sIndex = getIndex(sPos);
                    uint sValue = readCell(sIndex);
                    if (getType(sValue) == 2u) {
                        int startDir = int(fract(randVal * 8.0f + float(s)) * 8.0f);
                        for (int i = 0; i < 8; i++) {
                            int d = (startDir + i) % 8;
                            ivec3 pushPos = sPos + getHDir(d);
                            if (pushPos.x > 0 && pushPos.x < WIDTH - 1 && pushPos.z > 0 && pushPos.z < DEPTH - 1) {
                                if (tryDisplace(currentIndex, pack(4u, 0u, 0u, moisture), sIndex, sValue, getIndex(pushPos))) return;
                            }
                        }
                        if (tryMove(currentIndex, rawValue, sIndex, pack(4u, 0u, 0u, moisture))) return;
                    }
                }
            }
        }
    }

    uint floraState = currentDir;
    
    if (isClumped || currentSleep > tuning.wakeSleepThreshold) {
        ivec3 abovePos = pos + ivec3(0, 1, 0);
        bool aboveInside = (abovePos.y < HEIGHT - 1);
        uint aboveIndex = getIndex(abovePos);
        uint aboveType = aboveInside ? getType(readCell(aboveIndex)) : 0u;

        // A trunk counts as open sky here, not as something resting on top. A tree grows OUT of its
        // grass rather than over it -- the block keeps its turf, and keeps growing it back if it is
        // burnt or eaten away, exactly as it would with nothing standing there.
        if (aboveType == 0u || aboveType == TREE_TRUNK) {
            if (moisture >= 5u && floraState < 100u) {
                if (fract(randVal * 55.0f) < tuning.grassGrowChance) {
                    floraState++;

                    // The bloom. Rolled at the single moment the turf finishes growing in, rather
                    // than every tick it is grass: a per-tick roll would turn every field into
                    // forest given long enough, because each block would keep rolling until it hit.
                    // Once per block per time it greens over is what "one in a thousand" means.
                    if (floraState == 100u && aboveType == 0u && aboveInside &&
                        fract(randVal * 97.0f) < tuning.treeBloomChance) {
                        atomicCompSwap(grid[aboveIndex], 0u, pack(TREE_TRUNK, 0u, 0u, 0u));
                    }
                }
            }
            if (floraState > 100u) floraState = 100u;
        } else if (aboveType == 2u) {
            if (floraState > 0u) {
                if (floraState <= 100u) floraState = 101u;
                if (fract(randVal * 66.0f) < tuning.grassSubmergedDecayChance) floraState++;
                if (floraState >= 200u) floraState = 0u;
            }
        } else if (aboveType != 5u && !isLocust(aboveType)) {
            // Anything else resting on top smothers the grass at once. Fire is excepted because it
            // burns grass down over time instead, and locusts for the same reason -- a swarm eats a
            // block over 10 to 30 of its own ticks, and smothering would delete the meal on the
            // first dispatch after it arrived, so a swarm could never actually be fed.
            floraState = 0u;
        }
    }

    uint newSleep = min(currentSleep + 1u, 255u);
    atomicCompSwap(grid[currentIndex], rawValue, pack(4u, floraState, newSleep, moisture));
}

// FUNCTION: updateWater
// Water that is genuinely dormant -- sleeping past wakeSleepThreshold AND unable to wake this
// tick -- goes fully inert and stays that way indefinitely; it does NOT age out or evaporate.
// A settled lake/pool is meant to reach a steady state and remain there. The only ways water
// leaves the system are the user's void brush and fire boiling it into steam (see updateFire),
// and cloud moisture is only ever banked by that steam venting off the top of the grid as a cloud
// block (see updateSteam) -- this function must never create one.
void updateWater(ivec3 pos, uint currentIndex, uint rawValue, uint currentDir, uint currentSleep, uint currentAge, float randVal) {
    if (currentSleep > tuning.wakeSleepThreshold) {
        bool wake = false;
        if (pos.y > 1 && getType(readCell(getIndex(pos + ivec3(0, -1, 0)))) == 0u) {
            wake = true;
        } else {
            bool hasPressure = (pos.y < HEIGHT - 2) ? (getType(readCell(getIndex(pos + ivec3(0, 1, 0)))) != 0u) : false;
            bool isStackedOnWater = (pos.y > 1) ? (getType(readCell(getIndex(pos + ivec3(0, -1, 0)))) == 2u) : false;

            for(int d = 0; d < 8; d++) {
                ivec3 nPos = pos + getHDir(d);
                if (nPos.x > 0 && nPos.x < WIDTH - 1 && nPos.z > 0 && nPos.z < DEPTH - 1) {
                    if (getType(readCell(getIndex(nPos))) == 0u) {
                        uint belowNeighbor = getType(readCell(getIndex(nPos + ivec3(0, -1, 0))));
                        if (belowNeighbor == 0u || hasPressure || isStackedOnWater || belowNeighbor == 2u) {
                            wake = true;
                            break;
                        }
                    }
                }
            }
        }
        if (!wake) return;
        currentSleep = 0u;
        currentAge = 0u;
    }

    uint newAge = currentAge + 1u;

    if (pos.y > 1) {
        ivec3 belowPos = pos + ivec3(0, -1, 0);
        if (getType(readCell(getIndex(belowPos))) == 0u) {
            if (tryMove(currentIndex, rawValue, getIndex(belowPos), pack(2u, 0u, 0u, newAge))) return;
        }
    }

    uint newDir = currentDir;
    
    if (newDir == 0u || newDir == 9u) {
        float r = fract(randVal * 77.0f);
        if (r < 0.25f) newDir = 1u;      
        else if (r < 0.50f) newDir = 2u; 
        else if (r < 0.75f) newDir = 3u; 
        else newDir = 4u;                  
    }
    
    if (newAge % 3u == 0u && newAge > 0u) {
        uint diagDir = newDir;
        if (diagDir >= 1u && diagDir <= 4u) {
            float r = fract(randVal * 133.0f);
            if (diagDir == 1u) diagDir = (r > 0.5f) ? 5u : 6u;      
            else if (diagDir == 2u) diagDir = (r > 0.5f) ? 7u : 8u; 
            else if (diagDir == 3u) diagDir = (r > 0.5f) ? 5u : 7u; 
            else if (diagDir == 4u) diagDir = (r > 0.5f) ? 6u : 8u; 
        }
        
        ivec3 stepPos = pos + getHDir(int(diagDir) - 1);
        if (stepPos.x > 0 && stepPos.x < WIDTH - 1 && stepPos.z > 0 && stepPos.z < DEPTH - 1) {
            if (getType(readCell(getIndex(stepPos))) == 0u) {
                uint newValue = pack(2u, newDir, 0u, newAge);
                if (tryMove(currentIndex, rawValue, getIndex(stepPos), newValue)) return;
            }
        }
    }

    ivec3 bestDropPos = pos;
    bool foundDrop = false;
    
    uint blockedMask = 0u;
    int startDir = int(fract(randVal * 8.0f) * 8.0f);

    // The most expensive loop in the simulation: 8 directions x waterSpreadRadius reads per awake
    // water voxel per dispatch. Measured against the Simulation Speed slider, this is effectively the
    // only compute cost that scales -- every other material sleeps or is inert.
    int waterReach = int(clamp(tuning.waterSpreadRadius, 1u, uint(max(WIDTH, HEIGHT))));

    for (int r = 1; r <= waterReach; r++) {
        if (blockedMask == 255u) break;

        for (int i = 0; i < 8; i++) {
            int d = (startDir + i) % 8;

            if ((blockedMask & (1u << d)) == 0u) {
                ivec3 c = pos + getHDir(d) * r;
                
                if (c.x <= 0 || c.x >= WIDTH - 1 || c.z <= 0 || c.z >= DEPTH - 1 || getType(readCell(getIndex(c))) != 0u) {
                    blockedMask |= (1u << d);
                } else if (c.y > 1 && getType(readCell(getIndex(c + ivec3(0, -1, 0)))) == 0u) {
                    bestDropPos = c; 
                    foundDrop = true; 
                    break;
                }
            }
        }
        if (foundDrop) break;
    }
    
    if (foundDrop) {
        uint newValue = pack(2u, 0u, 0u, 0u); 
        if (tryMove(currentIndex, rawValue, getIndex(bestDropPos), newValue)) return;
    } else {
        bool hasPressure = (pos.y < HEIGHT - 2) ? (getType(readCell(getIndex(pos + ivec3(0, 1, 0)))) != 0u) : false;
        bool isStackedOnWater = (pos.y > 1) ? (getType(readCell(getIndex(pos + ivec3(0, -1, 0)))) == 2u) : false;
        
        bool canStepOntoPool = false;
        for(int d = 0; d < 8; d++) {
            ivec3 nPos = pos + getHDir(d);
            if(nPos.x > 0 && nPos.x < WIDTH - 1 && nPos.z > 0 && nPos.z < DEPTH - 1) {
                if(getType(readCell(getIndex(nPos))) == 0u && pos.y > 1 && getType(readCell(getIndex(nPos + ivec3(0,-1,0)))) == 2u) {
                    canStepOntoPool = true; 
                    break;
                }
            }
        }
        
        if (hasPressure || isStackedOnWater || canStepOntoPool) {
            int startSpreadDir = int(fract(randVal * 8.0f) * 8.0f);
            for(int i = 0; i < 8; i++) {
                int d = (startSpreadDir + i) % 8;
                ivec3 targetPos = pos + getHDir(d);
                if (targetPos.x > 0 && targetPos.x < WIDTH - 1 && targetPos.z > 0 && targetPos.z < DEPTH - 1) {
                    if (getType(readCell(getIndex(targetPos))) == 0u) {
                        uint newValue = pack(2u, uint(d + 1), 0u, newAge);
                        if (tryMove(currentIndex, rawValue, getIndex(targetPos), newValue)) return;
                    }
                }
            }
        }
    }
    
    uint newSleep = min(currentSleep + 1u, 255u);
    uint sleepValue = pack(2u, 0u, newSleep, newAge);
    atomicCompSwap(grid[currentIndex], rawValue, sleepValue);
}

// FUNCTION: lavaInteract
// One pass over the six orthogonal neighbours, acting on the first thing worth acting on and then
// stopping. Bounded at six reads, and the start direction is randomised so every neighbour gets its
// turn across a handful of ticks -- the same trick updateSand uses for moisture transfer.
void lavaInteract(ivec3 pos, inout uint coolness, float randVal) {
    int startDir = int(fract(randVal * 17.0f) * 6.0f);

    for (int i = 0; i < 6; i++) {
        int d = (startDir + i) % 6;
        ivec3 nPos = pos + getOrthoDir(d);
        if (nPos.x <= 0 || nPos.x >= WIDTH - 1 ||
            nPos.y <= 0 || nPos.y >= HEIGHT - 1 ||
            nPos.z <= 0 || nPos.z >= DEPTH - 1) continue;

        uint nIndex = getIndex(nPos);
        uint nVal = readCell(nIndex);
        uint nType = getType(nVal);

        if (nType == 2u) {
            // Water flashes straight to steam, and what it cost to boil lands on the lava.
            if (atomicCompSwap(grid[nIndex], nVal, pack(6u, 0u, 0u, 0u)) == nVal) {
                decWater();
                coolness = min(coolness + tuning.lavaWaterCool, 255u);
                return;
            }
        } else if (nType == TREE_LEAF) {
            // Leaves are simply gone, with no roll and no cooling paid for them. Grass gets fire set
            // in the air above it and left to the fire rules, but a canopy has to actually open: a
            // probabilistic burn would leave a lava flow perched on a roof of leaves it was slowly
            // negotiating with, instead of pouring through it.
            if (atomicCompSwap(grid[nIndex], nVal, 0u) == nVal) return;
        } else if (nType == TREE_TRUNK) {
            // Wood burns rather than vanishing. The trunk becomes an ordinary fire voxel, which then
            // ages out and lights the rest of the tree through the normal fire rules -- so a flow
            // that reaches one trunk of a stand can take the whole stand with it, without lava
            // needing any idea that trees are connected.
            if (atomicCompSwap(grid[nIndex], nVal, pack(5u, 0u, 0u, 0u)) == nVal) return;
        } else if (nType == 3u) {
            // Stone scorches to dark stone on contact. 255 rather than the solidify threshold, and
            // that is forced rather than chosen: the DARK_STONE branch below draws a unit of
            // coolness out of a neighbour on contact and re-melts it the moment it falls under the
            // threshold, so scorched rock seeded AT the threshold would liquefy on the very next
            // touch and lava would tunnel through stone indefinitely. Starting at the ceiling leaves
            // the whole 255-to-threshold span to be drawn down first, and the lava solidifies long
            // before it gets there.
            if (atomicCompSwap(grid[nIndex], nVal, pack(DARK_STONE, 0u, 0u, 255u)) == nVal) return;
        } else if (nType == 1u || nType == 4u) {
            uint moisture = getAge(nVal);
            uint flora = getDir(nVal);

            // Grass goes before the soil does. Fire is placed in the air above it rather than the
            // grass being burned directly, so the existing fire rules carry it from there and lava
            // does not need its own copy of how burning works.
            if (nType == 4u && flora > 10u && flora <= 100u) {
                ivec3 abovePos = nPos + ivec3(0, 1, 0);
                if (abovePos.y < HEIGHT - 1 && getType(readCell(getIndex(abovePos))) == 0u &&
                    fract(randVal * 41.0f) < tuning.lavaIgniteChance) {
                    if (atomicCompSwap(grid[getIndex(abovePos)], 0u, pack(5u, 0u, 0u, 0u)) == 0u) return;
                }
            } else if (moisture > 0u) {
                // Boil it dry before eating it, so waterlogged ground visibly resists for a while.
                if (atomicCompSwap(grid[nIndex], nVal, pack(nType, flora, 0u, moisture - 1u)) == nVal) {
                    coolness = min(coolness + tuning.lavaMoistureCool, 255u);
                    return;
                }
            } else if (fract(randVal * 53.0f) < tuning.lavaConsumeChance) {
                // Dry now, so it goes. Cleared rather than converted: turning it to lava would let
                // a single voxel eat a dune and multiply itself doing it.
                if (atomicCompSwap(grid[nIndex], nVal, 0u) == nVal) return;
            }
        } else if (isLava(nType)) {
            // Equalise by moving ONE unit down the gradient rather than assigning both sides the
            // mean. Both voxels run this independently, and a mean written from two invocations at
            // once double-counts; a one-way step is monotone, so a race costs a tick rather than
            // correctness, and repeated steps converge on the mean anyway.
            uint nCool = getAge(nVal);
            if (coolness > nCool + 1u) {
                uint raised = nCool + 1u;
                uint raisedType = (raised >= lavaSolidifyCoolness()) ? DARK_STONE : lavaTypeFor(raised);
                if (atomicCompSwap(grid[nIndex], nVal, pack(raisedType, getDir(nVal), 0u, raised)) == nVal) {
                    coolness -= 1u;
                    return;
                }
            }
        } else if (nType == DARK_STONE) {
            // Stone holds a HIGH coolness, so the identical diffusion step simply runs the other way
            // and lava draws water out of it. The re-melt test lives here, on contact, and not in
            // the stone's own update: drying alone must never bring a slab back, or an isolated one
            // would eventually cross the threshold and turn itself into lava unprompted.
            uint nCool = getAge(nVal);
            bool draws = (nCool > coolness + 1u);
            uint lowered = draws ? nCool - 1u : nCool;
            bool melts = (lowered < lavaSolidifyCoolness());

            if (draws || melts) {
                uint newType = melts ? lavaTypeFor(lowered) : DARK_STONE;
                if (atomicCompSwap(grid[nIndex], nVal, pack(newType, 0u, 0u, lowered)) == nVal) {
                    if (draws) coolness = min(coolness + 1u, 255u);
                    return;
                }
            }
        }
    }
}

// FUNCTION: updateLava
// Water's shape of movement, throttled, wrapped around a cooling life cycle.
//
// Unlike water this never sleeps out of its own update. A settled pool still has to keep crusting
// over, and neighbours still have to keep equalising, so a lava voxel runs every tick until it
// solidifies. That is self-limiting rather than open-ended: what it is counting down to is becoming
// dark stone, whose update is almost free.
void updateLava(ivec3 pos, uint currentIndex, uint rawValue, uint currentDir, uint currentSleep, uint currentAge, float randVal) {
    uint coolness = currentAge;

    lavaInteract(pos, coolness, randVal);

    // Time at rest cools it as well, read off the settle counter the movement code already keeps, so
    // "has stopped moving" and "has begun to crust over" are one fact instead of two clocks.
    if (currentSleep > tuning.wakeSleepThreshold && fract(randVal * 71.0f) < tuning.lavaRestCoolChance) {
        coolness = min(coolness + 1u, 255u);
    }

    if (coolness >= lavaSolidifyCoolness()) {
        atomicCompSwap(grid[currentIndex], rawValue, pack(DARK_STONE, 0u, 0u, coolness));
        return;
    }

    uint newType = lavaTypeFor(coolness);

    // Viscosity is a chance to attempt a move at all, not a shorter move: a step is exactly one
    // voxel and has no room to carry a rate, so the rate has to live in how often it is taken. Same
    // reasoning as orbital speed in updateOrbital.
    if (fract(randVal * 89.0f) < tuning.lavaViscosity) {
        if (pos.y > 1) {
            ivec3 belowPos = pos + ivec3(0, -1, 0);
            if (getType(readCell(getIndex(belowPos))) == 0u) {
                if (tryMove(currentIndex, rawValue, getIndex(belowPos), pack(newType, currentDir, 0u, coolness))) return;
            }
        }

        if (pos.y > 1) {
            int slideDir = (fract(randVal * 10.0f) > 0.5f) ? 1 : -1;
            ivec3 slide[2];
            if (fract(randVal * 100.0f) > 0.5f) {
                slide[0] = pos + ivec3(slideDir, -1, 0); slide[1] = pos + ivec3(0, -1, slideDir);
            } else {
                slide[0] = pos + ivec3(0, -1, slideDir); slide[1] = pos + ivec3(slideDir, -1, 0);
            }
            for (int s = 0; s < 2; s++) {
                ivec3 sPos = slide[s];
                if (sPos.x > 0 && sPos.x < WIDTH - 1 && sPos.z > 0 && sPos.z < DEPTH - 1) {
                    if (getType(readCell(getIndex(sPos))) == 0u) {
                        if (tryMove(currentIndex, rawValue, getIndex(sPos), pack(newType, currentDir, 0u, coolness))) return;
                    }
                }
            }
        }

        if (currentSleep <= tuning.wakeSleepThreshold) {
            // Look sideways for somewhere to fall, but only a few cells out. Water searches up to
            // 128, which is exactly what lets it cross a basin in a single tick; capping the reach
            // is most of what makes lava read as thick rather than merely slow.
            uint blockedMask = 0u;
            int searchStart = int(fract(randVal * 8.0f) * 8.0f);
            int reach = int(max(tuning.lavaSpreadRadius, 1u));

            for (int r = 1; r <= reach; r++) {
                if (blockedMask == 255u) break;
                for (int i = 0; i < 8; i++) {
                    int d = (searchStart + i) % 8;
                    if ((blockedMask & (1u << d)) != 0u) continue;

                    ivec3 c = pos + getHDir(d) * r;
                    if (c.x <= 0 || c.x >= WIDTH - 1 || c.z <= 0 || c.z >= DEPTH - 1 ||
                        getType(readCell(getIndex(c))) != 0u) {
                        blockedMask |= (1u << d);
                    } else if (c.y > 1 && getType(readCell(getIndex(c + ivec3(0, -1, 0)))) == 0u) {
                        if (tryMove(currentIndex, rawValue, getIndex(c), pack(newType, 0u, 0u, coolness))) return;
                        blockedMask |= (1u << d);
                    }
                }
            }

            // Nowhere to fall, so level out under pressure -- the same condition water settles by,
            // which is what lets a lava pool find a flat top before it freezes in place.
            bool hasPressure = (pos.y < HEIGHT - 2) ? (getType(readCell(getIndex(pos + ivec3(0, 1, 0)))) != 0u) : false;
            bool stackedOnLava = (pos.y > 1) ? isLava(getType(readCell(getIndex(pos + ivec3(0, -1, 0))))) : false;

            if (hasPressure || stackedOnLava) {
                int spreadStart = int(fract(randVal * 8.0f) * 8.0f);
                for (int i = 0; i < 8; i++) {
                    int d = (spreadStart + i) % 8;
                    ivec3 targetPos = pos + getHDir(d);
                    if (targetPos.x > 0 && targetPos.x < WIDTH - 1 && targetPos.z > 0 && targetPos.z < DEPTH - 1) {
                        if (getType(readCell(getIndex(targetPos))) == 0u) {
                            if (tryMove(currentIndex, rawValue, getIndex(targetPos), pack(newType, uint(d + 1), 0u, coolness))) return;
                        }
                    }
                }
            }
        }
    }

    uint newSleep = min(currentSleep + 1u, 255u);
    atomicCompSwap(grid[currentIndex], rawValue, pack(newType, currentDir, newSleep, coolness));
}

// FUNCTION: updateDarkStone
// Cooled lava. It falls straight down and, once landed, does nothing but shed the water it trapped,
// very slowly.
//
// Falling is strictly vertical -- no diagonal slide, no spreading. That is what separates it from
// sand: a solidified flow should drop out from under itself if you dig beneath it and otherwise hold
// its shape exactly, including overhangs and ledges, rather than slumping into a pile.
//
// It deliberately cannot re-melt itself. Drying only lowers the bar for adjacent lava to reclaim it
// (see the DARK_STONE branch of lavaInteract). Were the melt test here instead, an isolated slab
// would dry past the threshold on its own and turn back into lava with nothing having melted it.
void updateDarkStone(ivec3 pos, uint currentIndex, uint rawValue, uint currentAge, float randVal) {
    if (pos.y > 1) {
        ivec3 belowPos = pos + ivec3(0, -1, 0);
        if (getType(readCell(getIndex(belowPos))) == 0u) {
            // Age carries the trapped water across the move -- a falling slab must not forget how
            // close it is to being reclaimed just because the ground moved out from under it.
            if (tryMove(currentIndex, rawValue, getIndex(belowPos), pack(DARK_STONE, 0u, 0u, currentAge))) return;
        }
    }

    if (currentAge > 0u && fract(randVal * 23.0f) < tuning.darkStoneDryChance) {
        atomicCompSwap(grid[currentIndex], rawValue, pack(DARK_STONE, 0u, 0u, currentAge - 1u));
    }
}

// FUNCTION: updateTrunk
// One trunk voxel. Four jobs, in the order a tree actually does them: drink, pass water up, spend it
// on height or leaves, and -- only once it is well watered -- seed the grass beside it.
void updateTrunk(ivec3 pos, uint currentIndex, uint rawValue, uint currentDir, uint currentAge, float randVal) {
    uint height = currentDir;
    uint water = currentAge;
    bool changed = false;

    // --- Drink ----------------------------------------------------------------------------------
    // From the soil directly below and the eight beside it, which in practice means the base of the
    // column: everything above it is surrounded by air.
    //
    // The reserve is the important part. Grass needs moisture 5 to grow, so a tree that could drink
    // a block dry would kill the grass under itself and every neighbour it was about to seed into --
    // it would strip the ground it depends on. Leaving that floor alone makes trees and grass share
    // the water table instead of competing to extinction.
    // The reachable soil is the 3x3 patch UNDER the trunk -- the block below and the eight around
    // it -- plus the eight at its own level. The diagonals-below are the ones that matter and were
    // the easy thing to leave out: a trunk standing on the ground has nothing but air beside it, so
    // limiting "adjacent" to its own level leaves it drinking from exactly one block. Simulated that
    // way, a tree drained its single root block to the reserve within seconds and then spent the
    // rest of its life rate-limited by rainfall on one square metre -- it took 3000 ticks to reach
    // full height with the world's soil sitting unused at three times the moisture it needed.
    if (water < tuning.treeWaterMax && fract(randVal * 13.0f) < tuning.treeDrinkChance) {
        int start = int(fract(randVal * 101.0f) * 17.0f);
        for (int k = 0; k < 17; k++) {
            int i = (start + k) % 17;
            ivec3 c = (i == 0) ? (pos + ivec3(0, -1, 0))
                    : (i < 9)  ? (pos + getHDir(i - 1) + ivec3(0, -1, 0))
                               : (pos + getHDir(i - 9));
            if (!treeInBounds(c)) continue;

            uint idx = getIndex(c);
            uint v = readCell(idx);
            if (getType(v) != 4u) continue;

            uint moisture = getAge(v);
            if (moisture <= tuning.treeSoilReserve) continue;

            if (atomicCompSwap(grid[idx], v, pack(4u, getDir(v), getSleep(v), moisture - 1u)) == v) {
                water += 1u;
                changed = true;
                break;
            }
        }
    }

    // --- Pump water up ----------------------------------------------------------------------------
    // Unconditionally toward the trunk above, not as a diffusion step toward whichever side holds
    // less. That distinction is the difference between a tree and a stump.
    //
    // Diffusion was the obvious first answer and it is quietly fatal here: water arrives at one unit
    // per drink and levels out across the column faster than it comes in, so every voxel converges
    // on the same small amount and NONE of them ever reaches the cost of a growth step. Simulated,
    // a tree sat at three voxels tall holding 15, 15, 16 against a cost of 20, forever.
    //
    // Growth and leaves both happen at the tip, so the tip is where the water has to end up. A real
    // tree pumps to its growing point for the same reason. The tip has no trunk above it, so it is
    // the one voxel that keeps what it is given.
    ivec3 upPos = pos + ivec3(0, 1, 0);
    bool upIsTrunk = false;
    uint upValue = 0u;
    uint upIndex = 0u;
    if (treeInBounds(upPos)) {
        upIndex = getIndex(upPos);
        upValue = readCell(upIndex);
        upIsTrunk = (getType(upValue) == TREE_TRUNK);
    }

    if (upIsTrunk && water > 0u && getAge(upValue) < 255u && fract(randVal * 29.0f) < tuning.treeFlowChance) {
        uint lifted = pack(TREE_TRUNK, getDir(upValue), 0u, getAge(upValue) + 1u);
        if (atomicCompSwap(grid[upIndex], upValue, lifted) == upValue) {
            water -= 1u;
            changed = true;
        }
    }

    // --- Grow, or crown ---------------------------------------------------------------------------
    if (height + 1u < tuning.treeMaxHeight) {
        // Still a sapling: put the water into height. Growing into a leaf is allowed and wanted --
        // a crown put out early would otherwise cap the tree at whatever height it first branched.
        if (water >= tuning.treeGrowCost && treeInBounds(upPos)) {
            uint upType = getType(upValue);
            if (upType == 0u || upType == TREE_LEAF) {
                uint sapling = pack(TREE_TRUNK, height + 1u, 0u, 0u);
                if (atomicCompSwap(grid[upIndex], upValue, sapling) == upValue) {
                    water -= tuning.treeGrowCost;
                    changed = true;
                }
            }
        }
    } else if (water >= tuning.treeLeafCost && fract(randVal * 37.0f) < tuning.treeLeafChance) {
        // Full height: this is the crown, and it is the only thing that seeds leaves. Everything
        // further out is a leaf spreading from a leaf, which is what bounds the canopy.
        int start = int(fract(randVal * 43.0f) * 26.0f);
        for (int i = 0; i < 26; i++) {
            ivec3 c = pos + tree26((start + i) % 26);
            if (!treeInBounds(c)) continue;

            uint idx = getIndex(c);
            if (readCell(idx) != 0u) continue;
            if (atomicCompSwap(grid[idx], 0u, pack(TREE_LEAF, 0u, 0u, 1u)) == 0u) {
                water -= tuning.treeLeafCost;
                changed = true;
                break;
            }
        }
    }

    // --- Seed the neighbours ----------------------------------------------------------------------
    // A well watered trunk puts a sapling on the grass beside it. The geometry does the filtering by
    // itself: the target must be an empty cell with grass-topped soil directly under it, which only
    // ever describes ground level, so this needs no height test of its own.
    if (water >= tuning.treeSpreadCost && fract(randVal * 59.0f) < tuning.treeSpreadChance) {
        int start = int(fract(randVal * 61.0f) * 8.0f);
        for (int i = 0; i < 8; i++) {
            ivec3 c = pos + getHDir((start + i) % 8);
            if (!treeInBounds(c)) continue;

            uint idx = getIndex(c);
            if (readCell(idx) != 0u) continue;
            if (!isGrassBlock(readCell(getIndex(c + ivec3(0, -1, 0))))) continue;

            if (atomicCompSwap(grid[idx], 0u, pack(TREE_TRUNK, 0u, 0u, 0u)) == 0u) {
                water -= tuning.treeSpreadCost;
                changed = true;
                break;
            }
        }
    }

    if (changed) {
        atomicCompSwap(grid[currentIndex], rawValue, pack(TREE_TRUNK, height, 0u, water));
    }
}

// FUNCTION: updateLeaf
// One leaf. Its whole life is the number it carries: how many leaves it is from a trunk.
//
// Gated on a roll before it does anything, because leaves are far and away the most numerous voxel
// in a forest and the support scan below reads 26 neighbours. At the default that is about 1.6 reads
// per leaf per dispatch amortised rather than 26, and "slowly" is the specified behaviour anyway.
void updateLeaf(ivec3 pos, uint currentIndex, uint rawValue, uint currentAge, float randVal) {
    if (fract(randVal * 7.0f) >= tuning.treeLeafTickChance) return;

    // --- Already falling --------------------------------------------------------------------------
    // A detached leaf is marked with LEAF_DETACHED, which is outside the range any attached leaf can
    // hold (leafReach is clamped well below it). The marker is what lets a falling leaf skip the
    // 26-neighbour support scan entirely -- it has no support by definition and is not looking for
    // any -- and it also means a leaf cannot re-attach halfway down, so a canopy that has let go
    // comes apart for good instead of catching itself on the way past its own trunk.
    //
    // It voids on landing rather than piling up. Leaf litter that stayed would slowly bury a forest
    // floor in green, and it would be the only thing here that accumulates without ever clearing.
    if (currentAge == LEAF_DETACHED) {
        ivec3 belowPos = pos + ivec3(0, -1, 0);
        if (treeInBounds(belowPos) && readCell(getIndex(belowPos)) == 0u) {
            if (tryMove(currentIndex, rawValue, getIndex(belowPos),
                        pack(TREE_LEAF, 0u, 0u, LEAF_DETACHED))) return;
        }
        atomicCompSwap(grid[currentIndex], rawValue, 0u);
        return;
    }

    uint dist = currentAge;
    uint nearest = 255u;
    bool touchesTrunk = false;

    // One pass answers both questions -- what is the closest thing to a trunk around me, and where
    // could I put a new leaf -- so the 26 reads are paid for once rather than twice.
    int start = int(fract(randVal * 71.0f) * 26.0f);
    bool haveSpot = false;
    ivec3 spot = pos;

    for (int i = 0; i < 26; i++) {
        ivec3 c = pos + tree26((start + i) % 26);
        if (!treeInBounds(c)) continue;

        uint v = readCell(getIndex(c));
        uint t = getType(v);

        // Only the CROWN anchors a canopy, not any trunk voxel. Letting the whole column anchor is
        // the obvious reading and it does not make a tree: leaves take root against every voxel of
        // the trunk, spread their full reach outward from all of them, and the result is a solid
        // rectangular hedge running from the soil to the tip with a pole buried in it. Anchoring
        // only at the top gives a canopy centred where a canopy belongs.
        if (t == TREE_TRUNK && getDir(v) + 1u >= tuning.treeMaxHeight) {
            touchesTrunk = true;
        } else if (t == TREE_LEAF) {
            nearest = min(nearest, getAge(v));
        } else if (v == 0u && !haveSpot) {
            haveSpot = true;
            spot = c;
        }
    }

    // --- Support ----------------------------------------------------------------------------------
    // Recomputed every time rather than trusted, so a canopy re-roots itself onto whatever is still
    // holding it up. Cut the trunk out and the number climbs one ring per tick until it passes the
    // reach and the canopy comes down from the inside out.
    // A neighbour that is itself falling carries LEAF_DETACHED, which is 255 -- so it lands on the
    // same "nothing found" branch as no neighbour at all and cannot prop anything up. That falls out
    // of the sentinel rather than needing a test of its own, and it is what makes a detaching canopy
    // unravel outward instead of the outer ring hanging off the inner one all the way down.
    uint supported = touchesTrunk ? 1u : (nearest >= LEAF_DETACHED ? LEAF_DETACHED : nearest + 1u);
    if (supported > tuning.treeLeafReach) {
        // Let go rather than vanish. Rolled rather than immediate so a crown comes apart leaf by
        // leaf and drifts down, instead of the whole canopy blinking out of existence in one tick.
        if (fract(randVal * 83.0f) < tuning.treeLeafFallChance) {
            atomicCompSwap(grid[currentIndex], rawValue, pack(TREE_LEAF, 0u, 0u, LEAF_DETACHED));
        }
        return;
    }

    // --- Spread ------------------------------------------------------------------------------------
    // A leaf can only ever put out one further from the trunk than itself, which is what makes the
    // canopy stop -- and what makes two trees standing close enough grow into one roof instead of
    // two, since the leaves between them are in reach of both.
    if (supported < tuning.treeLeafReach && haveSpot &&
        fract(randVal * 89.0f) < tuning.treeLeafSpreadChance) {
        atomicCompSwap(grid[getIndex(spot)], 0u, pack(TREE_LEAF, 0u, 0u, supported + 1u));
    }

    if (supported != dist) {
        atomicCompSwap(grid[currentIndex], rawValue, pack(TREE_LEAF, 0u, 0u, supported));
    }
}

// FUNCTION: locustBud
// Drops a child swarm in a random direction, trying the other seven if that cell is taken. Called
// only when a meal pushes a swarm past its cap, so the overflow becomes another swarm rather than
// being thrown away.
void locustBud(ivec3 pos, float randVal) {
    uint bud = clamp(tuning.locustBudSize, 1u, locustMaxCount());
    int start = int(fract(randVal * 31.0f) * 8.0f);

    for (int i = 0; i < 8; i++) {
        int d = (start + i) % 8;
        ivec3 c = pos + getHDir(d);
        if (!locustInBounds(c)) continue;

        uint idx = getIndex(c);
        if (readCell(idx) != 0u) continue;
        if (atomicCompSwap(grid[idx], 0u, pack(locustTypeFor(bud), 0u, 0u, bud)) == 0u) return;
    }
}

// FUNCTION: updateLocust
// One swarm, one dispatch. Most dispatches do nothing but advance the clock.
//
// The clock is the whole reason this reads as a creature rather than a particle. Every other
// material here is happy to act on every dispatch, because their rates are probabilities and a
// probability is scale-free. A locust's rules are counted, not rolled -- "loses one per tick",
// "eats for 10 to 30 ticks" -- and a dispatch is far too short a unit for counted rules: at sim
// speed 1 a fresh swarm of 30 would starve to death in half a second. So a locust tick is
// locustTickDispatches dispatches, counted per voxel in its own sleep byte, and every number in
// the rules is expressed in those.
void updateLocust(ivec3 pos, uint currentIndex, uint rawValue, uint currentDir, uint currentSleep, uint currentAge, float randVal) {
    uint type = getType(rawValue);

    // --- Fire and lava --------------------------------------------------------------------------
    // Ahead of the clock, which is the whole of what "immediately" means here. Every other rule a
    // swarm has is counted in locust ticks and therefore acts on one dispatch in
    // locustTickDispatches; burning is not a rule the swarm gets to act on but something done to
    // it, and a swarm sitting unharmed in a lava flow because its own tick has not come round yet
    // is visibly wrong for as long as that tick lasts -- which at the default rate is most of a
    // second.
    //
    // The 26 neighbours rather than the 6, matching how fire itself decides what to light: a flame
    // that catches a leaf across a corner should catch a swarm across the same corner.
    //
    // Voided rather than set alight. A swarm is not fuel: there is no locust-shaped flame to leave
    // behind, and turning one into a fire voxel would seed new fire wherever a swarm happened to
    // die, carrying the burn into ground that was never lit.
    //
    // Unconditional, so it costs 26 reads per swarm per dispatch where fire's own scan buys its way
    // out with a probability roll first. Affordable for the opposite reason to fire's: a canopy
    // fire is thousands of flames running at once, whereas swarms are counted in dozens and each
    // one already spends up to 24 reads searching for grass on the ticks it acts.
    {
        int start = int(fract(randVal * 61.0f) * 26.0f);
        for (int i = 0; i < 26; i++) {
            ivec3 nPos = pos + tree26((start + i) % 26);
            if (!locustInBounds(nPos)) continue;
            uint nType = getType(readCell(getIndex(nPos)));
            if (nType == 5u || isLava(nType)) {
                atomicCompSwap(grid[currentIndex], rawValue, 0u);
                return;
            }
        }
    }

    // --- The clock ------------------------------------------------------------------------------
    uint phase = currentSleep + 1u;
    if (phase < tuning.locustTickDispatches) {
        atomicCompSwap(grid[currentIndex], rawValue, pack(type, currentDir, phase, currentAge));
        return;
    }

    uint count = currentAge;
    ivec3 belowPos = pos + ivec3(0, -1, 0);
    uint belowIndex = getIndex(belowPos);
    uint belowValue = readCell(belowIndex);

    // --- Grazing --------------------------------------------------------------------------------
    // Standing on grass is the whole of the feeding rule: no stored "am I eating" flag, just the
    // block underneath. A swarm that is fed does not starve this tick, which is what makes a patch
    // of grassland somewhere a swarm can survive instead of merely somewhere it dies more slowly.
    if (isLocustFood(belowValue)) {
        bool onLeaf = (getType(belowValue) == TREE_LEAF);
        uint need = locustEatTicks(count);
        uint progress = currentDir + 1u; // dir is the eat timer while grazing

        if (progress < need) {
            // Thin the grass as the meal goes on, so a swarm at work is visible from outside --
            // but never below 11, the bottom of the grass band. Letting it fall out of that band
            // early would end the meal from underneath and the swarm would walk off unfed.
            //
            // A leaf has no equivalent to thin: it is eaten or it is not. It simply keeps its shape
            // until the swarm finishes and then goes.
            if (!onLeaf) {
                uint flora = (belowValue >> 8) & 0xFFu;
                uint bite = max(90u / max(need, 1u), 1u);
                uint thinned = (flora > 11u + bite) ? (flora - bite) : 11u;
                atomicCompSwap(grid[belowIndex], belowValue,
                               pack(4u, thinned, getSleep(belowValue), getAge(belowValue)));
            }
            atomicCompSwap(grid[currentIndex], rawValue, pack(type, progress, 0u, count));
            return;
        }

        // Meal finished. The food goes first: if that CAS loses, another swarm ate this block and
        // this one must not be paid for it. Grass is stripped back to bare soil; a leaf is removed
        // outright, which drops the swarm through the hole it just opened in the canopy.
        uint stripped = onLeaf ? 0u : pack(4u, 0u, getSleep(belowValue), getAge(belowValue));
        if (atomicCompSwap(grid[belowIndex], belowValue, stripped) != belowValue) return;

        uint grown = count + tuning.locustEatGain;
        if (grown > locustMaxCount()) {
            locustBud(pos, randVal);
            grown = locustMaxCount();
        }
        atomicCompSwap(grid[currentIndex], rawValue, pack(locustTypeFor(grown), 0u, 0u, grown));
        return;
    }

    // --- Starvation -----------------------------------------------------------------------------
    if (count <= 1u) {
        atomicCompSwap(grid[currentIndex], rawValue, 0u);
        return;
    }
    count -= 1u;
    uint newType = locustTypeFor(count);

    // --- Gravity --------------------------------------------------------------------------------
    // Not in the rules, and deliberately added: swarms walk on surfaces, so nothing else would ever
    // bring one down, and a swarm whose ground was eaten or dug out from under it would hang in the
    // air permanently.
    //
    // Skipped when the swarm has something to hold on to -- see locustHasGrip. A swarm on a wall is
    // climbing it, not falling off it, and applying gravity there cancels the climb rule outright.
    //
    // locustInBounds, not just "is it empty": the outer shell is walled off and main() returns
    // early for anything in it, so a swarm dropped onto y=0 would never be updated again -- it
    // would sit there permanently, immortal and inert.
    if (getType(belowValue) == 0u && locustInBounds(belowPos) && !locustHasGrip(pos)) {
        if (tryMove(currentIndex, rawValue, belowIndex,
                    pack(newType, locustArriveDir(belowPos, currentDir), 0u, count))) return;
    }

    uint heading = locustHeading(currentDir);
    uint steps = locustSteps(currentDir);

    // --- End of a run: look for grass ------------------------------------------------------------
    // Gated on the run being over rather than checked every tick, which is the rule as written --
    // commit to a heading, move three times, then look again. Checked every tick instead, a swarm
    // would lock onto the nearest grass from the moment it was in range and never wander at all.
    if (steps == 0u) {
        int start = int(fract(randVal * 17.0f) * 8.0f);
        for (int i = 0; i < 8; i++) {
            int d = (start + i) % 8;
            ivec3 c = pos + getHDir(d);

            // Level, then up one, then down one: ground that steps should still be followable.
            for (int rise = 0; rise < 3; rise++) {
                ivec3 t = c + ivec3(0, (rise == 1) ? 1 : ((rise == 2) ? -1 : 0), 0);
                if (!locustInBounds(t)) continue;
                if (readCell(getIndex(t)) != 0u) continue;
                if (!locustFoodAt(t + ivec3(0, -1, 0))) continue;
                // Arrives with a zeroed dir byte because it is landing on grass: the meal starts now.
                if (tryMove(currentIndex, rawValue, getIndex(t), pack(newType, 0u, 0u, count))) return;
            }
        }

        heading = uint(fract(randVal * 23.0f) * 8.0f) & 7u;
        steps = locustRunSteps();
    }

    // --- Advance along the heading ----------------------------------------------------------------
    ivec3 target = pos + getHDir(int(heading));
    bool blocked = !locustInBounds(target) || readCell(getIndex(target)) != 0u;

    if (!blocked) {
        // Cliff rule: a clear cell with nothing under it is a drop, and a swarm turns back rather
        // than take it. Only the grass search above is allowed to step down, and only by one.
        //
        // The bounds test makes the world's own floor count as ground rather than as a bottomless
        // drop. Without it a swarm walking at y=1 reads every direction as a cliff, turns on the
        // spot until it starves, and the bottom layer of the world becomes quietly lethal.
        ivec3 footing = target + ivec3(0, -1, 0);
        if (locustInBounds(footing) && readCell(getIndex(footing)) == 0u) {
            // "Prefer to turn around" is a preference, not a reflex, and it has to be written as one.
            // Reversing unconditionally makes a swarm on a ledge flip between the same two headings
            // forever: both are cliffs, each turn produces the other, and it never rolls one of the
            // other six -- so it never reaches the blocked branch below, where climbing lives. A
            // swarm clinging to the side of a plateau would starve inches beneath the top of it.
            //
            // So: take the about-face when the about-face is actually walkable, and otherwise pick
            // a fresh heading and start a new run.
            uint back = locustReverse(heading);
            ivec3 backPos = pos + getHDir(int(back));
            ivec3 backFoot = backPos + ivec3(0, -1, 0);
            bool backOpen = locustInBounds(backPos) && readCell(getIndex(backPos)) == 0u &&
                            !(locustInBounds(backFoot) && readCell(getIndex(backFoot)) == 0u);

            uint turnedNav = backOpen
                ? locustPackNav(back, steps)
                : locustPackNav(uint(fract(randVal * 71.0f) * 8.0f) & 7u, locustRunSteps());

            atomicCompSwap(grid[currentIndex], rawValue, pack(newType, turnedNav, 0u, count));
            return;
        }

        uint nav = locustPackNav(heading, steps - 1u);
        if (tryMove(currentIndex, rawValue, getIndex(target),
                    pack(newType, locustArriveDir(target, nav), 0u, count))) return;
    } else {
        // Something in the way: climb it or turn, decided by a roll.
        if (fract(randVal * 41.0f) < tuning.locustClimbChance) {
            // Onto the top of the obstacle first, straight up only as a fallback. Mounting the
            // obstacle keeps the swarm travelling in the direction it was already going -- it is a
            // step of the run and is counted as one -- where climbing a wall face is not progress
            // along anything and leaves the run where it was.
            ivec3 overTop = target + ivec3(0, 1, 0);
            if (locustInBounds(overTop) && readCell(getIndex(overTop)) == 0u) {
                uint nav = locustPackNav(heading, steps - 1u);
                if (tryMove(currentIndex, rawValue, getIndex(overTop),
                            pack(newType, locustArriveDir(overTop, nav), 0u, count))) return;
            }

            ivec3 up = pos + ivec3(0, 1, 0);
            if (locustInBounds(up) && readCell(getIndex(up)) == 0u) {
                uint nav = locustPackNav(heading, steps);
                if (tryMove(currentIndex, rawValue, getIndex(up),
                            pack(newType, locustArriveDir(up, nav), 0u, count))) return;
            }
        }

        heading = uint(fract(randVal * 53.0f) * 8.0f) & 7u;
        steps = locustRunSteps();
    }

    // Reached when the swarm turned instead of moving, or when a move lost its CAS. The write still
    // has to happen: this tick's starvation and heading change are real whether or not it stepped.
    atomicCompSwap(grid[currentIndex], rawValue,
                   pack(newType, locustPackNav(heading, steps), 0u, count));
}

// FUNCTION: updateFire
void updateFire(ivec3 pos, uint currentIndex, uint rawValue, uint currentDir, uint currentSleep, uint currentAge, float randVal) {
    uint newAge = currentAge + 1u;
    bool isBurningGrass = false;

    for (int i = 0; i < 6; i++) {
        ivec3 nPos = pos + getOrthoDir(i);
        if (nPos.x > 0 && nPos.x < WIDTH-1 && nPos.y > 0 && nPos.y < HEIGHT-1 && nPos.z > 0 && nPos.z < DEPTH-1) {
            uint nIndex = getIndex(nPos);
            uint nVal = readCell(nIndex);
            if (getType(nVal) == 2u) {
                if (atomicCompSwap(grid[nIndex], nVal, pack(6u, 0u, 0u, 0u)) == nVal) {
                    decWater(); // water voxel became steam; it is no longer a water voxel
                    atomicExchange(grid[currentIndex], 0u);
                    return;
                }
            }
        }
    }

    // --- Trees catch --------------------------------------------------------------------------
    // A leaf or a trunk next to a flame becomes a flame. That single substitution is all a forest
    // fire needs: the new flame is an ordinary fire voxel, so it ages out, lights ITS neighbours,
    // and the burn walks the tree on its own -- up the trunk, out through the crown, and across to
    // the next tree over the leaves that bridge them. Nothing here knows what a forest is.
    //
    // Checked over the 26 neighbours rather than the 6, so fire climbs diagonally instead of
    // stalling wherever two leaves happen to only touch at a corner.
    //
    // Wood takes slower than foliage, and the two rates share one roll rather than costing two.
    // Roll once against the higher of the pair to decide whether to look at all, then compare that
    // SAME value against whichever rate the thing found actually wants: for r uniform, P(r < rate)
    // is the rate, so each material burns at exactly its own chance and the scan still gets skipped
    // on the dispatches nothing was going to happen anyway. A canopy fire is thousands of flames
    // running this at once, and 26 reads apiece is not free.
    float burnRoll = fract(randVal * 47.0f);
    if (burnRoll < max(tuning.treeLeafBurnChance, tuning.treeTrunkBurnChance)) {
        int start = int(fract(randVal * 31.0f) * 26.0f);
        for (int i = 0; i < 26; i++) {
            ivec3 nPos = pos + tree26((start + i) % 26);
            if (!treeInBounds(nPos)) continue;

            uint nIndex = getIndex(nPos);
            uint nVal = readCell(nIndex);
            uint nType = getType(nVal);
            if (nType != TREE_LEAF && nType != TREE_TRUNK) continue;

            float need = (nType == TREE_LEAF) ? tuning.treeLeafBurnChance : tuning.treeTrunkBurnChance;
            if (burnRoll < need) {
                atomicCompSwap(grid[nIndex], nVal, pack(5u, 0u, 0u, 0u));
            }
            break;
        }
    }

    if (pos.y > 1) {
        ivec3 belowPos = pos + ivec3(0, -1, 0);
        uint belowIndex = getIndex(belowPos);
        uint belowValue = readCell(belowIndex);
        uint belowType = getType(belowValue);

        if (belowType == 0u) {
            if (tryMove(currentIndex, rawValue, belowIndex, pack(5u, 0u, 0u, newAge))) return;
        } else if (belowType == 2u) {
            atomicExchange(grid[currentIndex], 0u);
            return;
        } else if (belowType == 1u) {
            uint moisture = getAge(belowValue);
            if (moisture > 0u) {
                uint newMoisture = (moisture > tuning.fireDryRate) ? moisture - tuning.fireDryRate : 0u;
                uint newVal = pack(1u, getDir(belowValue), 0u, newMoisture);
                if (atomicCompSwap(grid[belowIndex], belowValue, newVal) == belowValue) {
                    atomicExchange(grid[currentIndex], 0u);
                    return;
                }
            }
        } else if (belowType == 4u) {
            uint flora = (belowValue >> 8) & 0xFFu;
            if (flora > 10u && flora <= 100u) {
                isBurningGrass = true;
                newAge = 0u;

                if (fract(randVal * 100.0f) < tuning.fireBurnGrassChance) {
                    uint newFlora = flora - 1u;
                    uint newVal = pack(4u, newFlora, 0u, getAge(belowValue));
                    atomicCompSwap(grid[belowIndex], belowValue, newVal);
                }

                if (fract(randVal * 100.0f) < tuning.fireSpreadChance) {
                    int d = int(fract(randVal * 10.0f) * 8.0f);
                    ivec3 targetPos = pos + getHDir(d);
                    if (targetPos.x > 0 && targetPos.x < WIDTH-1 && targetPos.z > 0 && targetPos.z < DEPTH-1) {
                        uint targetIndex = getIndex(targetPos);
                        if (getType(readCell(targetIndex)) == 0u) {
                            ivec3 targetBelow = targetPos + ivec3(0, -1, 0);
                            uint tBelowVal = readCell(getIndex(targetBelow));
                            if (getType(tBelowVal) == 4u) {
                                uint tFlora = (tBelowVal >> 8) & 0xFFu;
                                if (tFlora > 10u && tFlora <= 100u) {
                                    atomicCompSwap(grid[targetIndex], 0u, pack(5u, 0u, 0u, 0u));
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if (newAge > tuning.fireLifetime) {
        atomicExchange(grid[currentIndex], 0u);
        return;
    }

    atomicCompSwap(grid[currentIndex], rawValue, pack(5u, 0u, 0u, newAge));
}


// FUNCTION: updateSimState
// Drives the rain state machine: 0 = accumulating (white), 1 = darkening (waiting to rain),
// 2 = raining (draining), and sweeps the black hole table. Only invocation (0,0,0) performs
// transitions and eases the cloud charge, keeping those single-writer rather than having every
// voxel in the grid contend on the same atomics. Other invocations may observe a transition up to
// one dispatch late, which is invisible at this timescale.
void updateSimState() {
    if (gl_GlobalInvocationID.x != 0u || gl_GlobalInvocationID.y != 0u || gl_GlobalInvocationID.z != 0u) return;

    // --- Black hole table sweep ------------------------------------------------------------------
    // Slots are validated here, once, rather than by each captured particle. Every mobile voxel in
    // the grid reads this table every dispatch, so a per-particle "is that voxel still a hole?"
    // check would multiply one cheap confirmation into millions. Recomputing the count from scratch
    // also means it can never drift: a hole erased by the void brush frees its slot immediately,
    // and one erased any other way is reaped on the next dispatch.
    uint live = 0u;
    for (int i = 0; i < BLACK_HOLE_MAX; i++) {
        uint code = blackHoles[i];
        if (code == 0u) continue;

        uint voxel = code & BH_INDEX_MASK;
        if (getType(readCell(voxel)) != 7u) {
            blackHoles[i] = 0u;
            continue;
        }

        // --- Starvation ----------------------------------------------------------------------
        // Advanced here, and zeroed by any captured particle in updateOrbital. Incrementing from
        // the single-writer sweep rather than having holes time themselves means the clock ticks
        // once per dispatch no matter how much matter is in flight, which is what makes the grace
        // period a predictable duration instead of something that depends on the scene.
        uint starve = blackHoleStarve[i] + 1u;
        blackHoleStarve[i] = starve;

        // The purge hole runs the identical starve-shrink-vanish path, just far faster. That path is
        // already exactly "once there is nothing left to catch, shrink and disappear", so the purge
        // needed no ending of its own -- only a shorter fuse and a bigger burn.
        bool purge = bhIsPurge(code);
        uint grace = purge ? tuning.purgeStarveGrace : tuning.blackHoleStarveGrace;
        uint decay = purge ? tuning.purgeDecayRate : tuning.blackHoleDecayRate;

        if (starve > grace) {
            uint mass = blackHoleMass[i];
            if (mass == 0u) {
                // Nothing left to shed and nothing coming in: the hole evaporates. Clearing the
                // voxel and the slot together is what keeps this from leaving an untracked black
                // voxel behind -- and doing it from the sweep means it happens exactly once.
                writeCell(voxel, 0u);
                blackHoles[i] = 0u;
                continue;
            }
            blackHoleMass[i] = mass - min(mass, decay);
        }

        live++;
    }
    blackHoleCount = live;

    // Weather is driven by the cloud field going still, not by a water deficit. waterHighMark,
    // rainTargetLevel and the deficit maths that used to live here are gone with it -- see the
    // comments on those fields in SimStats.

    // --- Occupied-height ceiling ---------------------------------------------------------------
    // maxOccupiedY is a running high-water mark for "how high does matter reach", and the renderer
    // uses it to avoid marching the empty sky above the world's contents. It has to be cheap and it
    // has to never under-report, and those two pull against each other: a per-dispatch reset would
    // let the value be rebuilt from scratch, but nothing can order a clear ahead of the atomicMaxes
    // in the same dispatch, so a racing voxel's contribution would be lost and its matter would
    // vanish from the screen for a frame.
    //
    // So it decays instead of resetting: one unit per dispatch from here, re-asserted by any voxel
    // that sits above it (see main). atomicAdd composes with those atomicMaxes in either order, so
    // the published value is never more than 1 below the truth -- which is why the renderer's clip
    // adds 2 rather than trusting it exactly. When the world empties, the mark walks down at one
    // voxel per dispatch and costs only a little extra marching on the way.
    if (maxOccupiedY > 0u) atomicAdd(maxOccupiedY, 0xFFFFFFFFu); // -1, without risking wrap at 0

    // Rotate the rainable-column census: last dispatch's tally becomes this dispatch's divisor,
    // and a fresh tally starts. Columns racing this swap land in one bucket or the other, which
    // only jitters the estimate slightly -- it is a denominator for probability, not a hard
    // allowance, so being a little stale costs nothing and no drop is ever lost to the race.
    rainCandidateEstimate = rainCandidateCount;
    rainCandidateCount = 0u;

    // --- The storm check ------------------------------------------------------------------------
    // Every cloudCheckIntervalTicks dispatches, ask one question: did any cloud block move on the
    // dispatch just gone? If none did, the field has settled and a rain event begins.
    //
    // Periodic rather than a run of consecutive still ticks, which is what this used to be. A run
    // resets on any movement, so one block jostling once every few hundred ticks postponed weather
    // indefinitely; sampling instead asks only whether the sky is still at the moment it is asked.
    //
    // cloudMovedCount is read before the clear, so it is the tally accumulated since the last clear
    // -- exactly one dispatch's worth, wherever in the dispatch this single writer happens to run.
    simTick = simTick + 1u;
    uint movedLastTick = cloudMovedCount;
    uint liveClouds = cloudBlockCount;
    cloudBlockCount = 0u;
    cloudMovedCount = 0u;

    // The band, rotated the same way. The min accumulator restarts at the maximum a uint can hold
    // rather than at zero, which is what makes atomicMin meaningful -- and leaves min > max as an
    // unambiguous "there is no cloud", which the renderer uses to skip the march entirely.
    cloudMinY = cloudMinYAcc;
    cloudMaxY = cloudMaxYAcc;
    cloudMinYAcc = 0xFFFFFFFFu;
    cloudMaxYAcc = 0u;

    // --- Group cloud charge ---------------------------------------------------------------------
    // One value the whole sky renders from, so it thickens and greys together rather than cloud by
    // cloud. Clear while gathering, full once it is raining. Eased rather than assigned, so the
    // change is gradual.
    float chargeTarget = (rainPhase == 0u) ? 0.0f : 1.0f;
    float charge = uintBitsToFloat(cloudChargeBits);
    charge += (chargeTarget - charge) * clamp(tuning.cloudChargeEaseRate, 0.0f, 1.0f);
    cloudChargeBits = floatBitsToUint(clamp(charge, 0.0f, 1.0f));

    if (rainPhase == 0u) {
        uint interval = max(tuning.cloudCheckIntervalTicks, 1u);
        if (simTick % interval == 0u && liveClouds > 0u && movedLastTick == 0u) {
            rainPhase = 2u;
            rainPhaseTimeBits = floatBitsToUint(pc.time);
            lastRainTick = simTick;   // read back by the profiler; nothing in the sim uses it
        }
    } else {
        // Raining. Every cloud block became a raincloud, and each makes its own way to the ceiling,
        // waits out its counter and falls as water. The storm is over exactly when the last one has
        // gone -- there is no target level to reach and nothing to overshoot, because the water that
        // comes down is the water that went up, one block for one voxel.
        if (liveClouds == 0u) {
            rainPhase = 0u;
            rainPhaseTimeBits = 0u;
        }
    }
}

// FUNCTION: updateSteam
void updateSteam(ivec3 pos, uint currentIndex, uint rawValue, uint currentSleep, uint currentAge, float randVal) {
    if (pos.y >= HEIGHT - 2) {
        // Still no decWater(): this voxel stopped counting as water back when fire turned it into
        // steam, and that is where the decrement already happened. What changed is where the
        // moisture goes -- it used to become an abstract tally in cloudWaterCount, and now it
        // becomes an actual cloud block occupying this cell in the cloud field.
        //
        // The cloud write has to succeed before the steam is cleared, or a steam voxel is destroyed
        // and its moisture with it.
        // Touching the roof always ends the steam, one way or the other. Letting it fall through to
        // ordinary movement is what produced steam skating along the underside of the cube looking
        // for a free cell, which should not be possible: reaching the top IS becoming cloud.
        uint newKind = (rainPhase == 2u) ? CLOUD_RAIN : CLOUD_CALM;
        if (atomicCompSwap(cloudCells[currentIndex], 0u, packCloud(newKind, false, 0u, 0u)) == 0u) {
            atomicExchange(grid[currentIndex], 0u);
            return;
        }
        // A cloud block already occupies this cell, so there is no slot to condense into. The steam
        // merges into it and is gone rather than skating away. That does lose one voxel of moisture
        // from the cycle, which is worth being explicit about -- but it is bounded and rare: steam
        // treats clouded cells as solid (see the movement checks below), so the only way to be here
        // is to have been created inside one, which means water boiled directly beneath the layer.
        atomicExchange(grid[currentIndex], 0u);
        return;
    }

    uint newAge = min(currentAge + 1u, 255u);

    // 0. Stalled steam condenses where it stands.
    //
    // The rules below cover steam that reaches the roof and steam that rises into settled cloud, but
    // not steam a cloud block has risen INTO -- the two fields do not look at each other, so a cloud
    // can occupy the cell a steam voxel is already in, and that steam is touching cloud without
    // being under it. It has nowhere to rise to and no rule to catch it, so it hangs in the air.
    //
    // A timeout catches that and anything else like it without having to enumerate them. A block
    // that has genuinely nowhere to go is, physically, a block that should have condensed.
    if (currentSleep >= tuning.steamCondenseTicks) {
        // The compare-and-swap is allowed to fail: failing means a cloud block already occupies this
        // cell, which is exactly the case that stranded this voxel, and the steam merges into it.
        // Either way the steam is gone, so the grid write is unconditional.
        uint newKind = (rainPhase == 2u || cloudTouchesRain(pos)) ? CLOUD_RAIN : CLOUD_CALM;
        atomicCompSwap(cloudCells[currentIndex], 0u, packCloud(newKind, false, 0u, 0u));
        atomicExchange(grid[currentIndex], 0u);
        return;
    }

    // 1. Scatter randomly (horizontal or vertical)
    if (fract(randVal * 88.0f) < tuning.steamScatterChance) {
        int d = int(fract(randVal * 13.0f) * 6.0f);
        ivec3 scatterPos = pos + getOrthoDir(d);
        if (scatterPos.x > 0 && scatterPos.x < WIDTH - 1 && scatterPos.y > 0 && scatterPos.y < HEIGHT - 1 && scatterPos.z > 0 && scatterPos.z < DEPTH - 1) {
            uint sType = getType(readCell(getIndex(scatterPos)));
            // A clouded cell is closed to steam. Without this steam wanders into the layer, and a
            // steam voxel sharing a cell with a cloud block has nowhere to condense.
            if ((sType == 0u || sType == 5u) &&
                getCloudKind(cloudCells[getIndex(scatterPos)]) == CLOUD_NONE) {
                // Carries the sleep counter forward rather than resetting it. Scattering is a
                // lateral random walk, not progress towards the roof, and the counter exists to
                // detect steam that cannot ascend. Resetting it here meant a voxel blocked from
                // above kept clearing its own timer by drifting sideways -- ten CONSECUTIVE still
                // ticks at a 30% scatter chance is a 2.8% event, so stalled steam wandered for
                // hundreds of ticks instead of condensing. Only a successful rise resets it.
                uint carried = min(currentSleep + 1u, 255u);
                if (tryMove(currentIndex, rawValue, getIndex(scatterPos),
                            pack(6u, 0u, carried, newAge))) return;
            }
        }
    }

    ivec3 checkPos[3];
    checkPos[0] = pos + ivec3(0, 1, 0);
    int dir = (fract(randVal * 10.0f) > 0.5f) ? 1 : -1;
    if (fract(randVal * 100.0f) > 0.5f) {
        checkPos[1] = pos + ivec3(dir, 1, 0); checkPos[2] = pos + ivec3(0, 1, dir);
    } else {
        checkPos[1] = pos + ivec3(0, 1, dir); checkPos[2] = pos + ivec3(dir, 1, 0);
    }

    // 2. Condense onto the underside of the cloud layer.
    //
    // This is the other half of how cloud forms, and without it the layer could only ever be one
    // voxel deep: steam became cloud only at HEIGHT-2, so once that single row was full every
    // further wisp had nowhere to go and simply milled about forever, which is what made steam look
    // like a liquid that never settles. Rain was a drip for the same reason -- a storm can only
    // return as many drops as there were blocks, and there were almost none.
    //
    // Rising into a settled cloud block turns this steam into cloud where it stands, so the layer
    // thickens downward from the roof as more moisture arrives.
    {
        ivec3 upPos = pos + ivec3(0, 1, 0);
        bool underSettled = cloudCellInBounds(upPos) && cloudIsAtRest(cloudCells[getIndex(upPos)]);
        // Steam touching a raincloud joins the storm directly, which is what stops a rain event
        // leaving a fog of steam behind that would have to condense and wait for the next one.
        bool touchingRain = cloudTouchesRain(pos);

        if (underSettled || touchingRain) {
            // The compare-and-swap is allowed to fail, and the grid write happens either way.
            //
            // Failing means a cloud block already holds this cell -- steam suspended INSIDE the
            // layer rather than under it, which is what a cloud block rising into a steam voxel
            // produces. That steam has merged and is gone.
            //
            // Returning without writing, as this did, was an outright hang: the tail of this
            // function is what advances the condense timer, so a voxel that took this branch every
            // dispatch never aged, never tripped the failsafe, and hung between cloud blocks for
            // the rest of the session. The timer cannot rescue a path that returns before it.
            uint newKind = (touchingRain || rainPhase == 2u) ? CLOUD_RAIN : CLOUD_CALM;
            atomicCompSwap(cloudCells[currentIndex], 0u, packCloud(newKind, false, 0u, 0u));
            atomicExchange(grid[currentIndex], 0u);
            return;
        }
    }

    // 3. Check for moisture-absorbing blocks (Sand = 1u, Dirt = 4u)
    for (int i = 0; i < 3; i++) {
        ivec3 cPos = checkPos[i];
        if (cPos.x > 0 && cPos.x < WIDTH - 1 && cPos.z > 0 && cPos.z < DEPTH - 1) {
            uint cIndex = getIndex(cPos);
            uint cVal = readCell(cIndex);
            uint cType = getType(cVal);
            
            if (cType == 1u || cType == 4u) {
                uint moisture = getAge(cVal);
                uint capacity = (cType == 4u) ? tuning.dirtMoistureCapacity : tuning.sandMoistureCapacity;
                if (moisture < capacity) {
                    if (atomicCompSwap(grid[currentIndex], rawValue, 0u) == rawValue) {
                        atomicAdd(grid[cIndex], 1u << 24);
                        return; 
                    }
                }
            }
        }
    }

    // 4. Try moving upwards or diagonally upwards (Air = 0u, Fire = 5u)
    //
    // The Y bound is new and load-bearing. This function used to return before reaching here
    // whenever pos.y was at HEIGHT-2, so a rise target could never be the border row; steam at the
    // ceiling now falls through, and without this it would step into the border and freeze there
    // permanently, since main() never simulates it again.
    for (int i = 0; i < 3; i++) {
        ivec3 sPos = checkPos[i];
        if (sPos.y < HEIGHT - 1 &&
            sPos.x > 0 && sPos.x < WIDTH - 1 && sPos.z > 0 && sPos.z < DEPTH - 1) {
            uint sType = getType(readCell(getIndex(sPos)));
            if ((sType == 0u || sType == 5u) &&
                getCloudKind(cloudCells[getIndex(sPos)]) == CLOUD_NONE) {
                if (tryMove(currentIndex, rawValue, getIndex(sPos), pack(6u, 0u, 0u, newAge))) return;
            }
        }
    }
    
    uint newSleep = min(currentSleep + 1u, 255u);
    atomicCompSwap(grid[currentIndex], rawValue, pack(6u, 0u, newSleep, newAge));
}

// FUNCTION: tryMoveCloud
// Moves a cloud block one cell, in the cloud field only. The value written at the destination is
// passed separately from the one expected at the source, because a moving block resets its sleep
// counter on arrival.
//
// Destination claimed before the source is released, which is the opposite order from tryMove on
// the main grid and deliberate: the failure it guards against is different. On the grid a voxel
// briefly existing twice would be visible matter appearing from nowhere; here a cloud block briefly
// existing twice is one dispatch of a slightly denser column, which nothing can see, while losing
// one permanently removes moisture from a closed system.
bool tryMoveCloud(uint fromIndex, uint newValue, uint toIndex, uint expectedFromValue) {
    if (atomicCompSwap(cloudCells[toIndex], 0u, newValue) != 0u) return false;
    if (atomicCompSwap(cloudCells[fromIndex], expectedFromValue, 0u) != expectedFromValue) {
        // The source changed under us, so this block is not ours to move after all. Hand the
        // destination back rather than leaving a copy behind.
        atomicExchange(cloudCells[toIndex], 0u);
        return false;
    }
    return true;
}

// FUNCTION: updateCloudBlock
// The whole cloud simulation, run by every invocation for its own cell.
//
// It touches the main grid in exactly two places -- a raincloud finishing its count and becoming
// water, and the census of steam it converts. Everywhere else it reads and writes cloudCells alone,
// and that is what makes a cloud block able to share a cell with stone: the two fields never look at
// each other, so neither can disturb the other.
//
// Cloud blocks fall upward: straight up, then one of two diagonals, exactly as a grain falls
// downward. There is deliberately NO cohesion rule. Sand spreads because a blocked grain slides
// aside; adding the clump test made a pile hold its shape instead, which is dirt's behaviour, and
// cloud stacked into towers rather than spreading along the ceiling.
void updateCloudBlock(ivec3 pos) {
    uint idx = getIndex(pos);
    uint base = cloudColumnBase(pos.x, pos.z);

    // Rotate this column's census. y == 0 is in every column and is visited exactly once per
    // dispatch, which makes it the natural single writer for the column.
    if (pos.y == 0) {
        // Eased into the published pair rather than copied, and held in sixteenths.
        //
        // The block field is never still, so a surface drawn straight from this dispatch's tally
        // changes every dispatch and the deck boils -- which is what the edge flicker is, once the
        // fill pattern itself was made stable. An exponential average lets the drawn shape drift
        // toward the truth over tens of dispatches instead of chasing it every one.
        //
        // Sixteenths because the average has to be able to move by less than a whole block: at
        // integer resolution a rate of 0.08 against a difference of one truncates to zero and the
        // value sticks forever, one short of where it should be.
        float rate = clamp(tuning.cloudSmoothRate, 0.01f, 1.0f);
        uint tallied = cloudColumn[base + 0u];

        cloudColumn[base + 2u] = easeTowards(cloudColumn[base + 2u], float(tallied) * 16.0f, rate);

        // The height is only eased when this window actually counted something, and that guard is
        // the whole point of it.
        //
        // The height accumulator is an atomicMax reset to zero, so a column that happened to hold no
        // block during one window publishes a height of zero -- not "unchanged", but "the floor".
        // Easing toward that dragged the drawn surface down through the world and then let it climb
        // back as blocks reappeared, which is the cloud seen bubbling upward from under the roof,
        // with pieces of deck stranded well below it. A window with nothing in it says nothing about
        // where the cloud is; the previous height stands, and the count easing to zero is what makes
        // an emptied column fade out.
        if (tallied > 0u) {
            cloudColumn[base + 3u] = easeTowards(cloudColumn[base + 3u],
                                                 float(cloudColumn[base + 1u]) * 16.0f, rate);
        }

        cloudColumn[base + 0u] = 0u;
        cloudColumn[base + 1u] = 0u;
    }

    uint cell = cloudCells[idx];
    uint kind = getCloudKind(cell);
    if (kind == CLOUD_NONE) return;

    atomicAdd(cloudBlockCount, 1u);
    atomicAdd(cloudColumn[base + 0u], 1u);
    atomicMax(cloudColumn[base + 1u], uint(pos.y));
    atomicMin(cloudMinYAcc, uint(pos.y));
    atomicMax(cloudMaxYAcc, uint(pos.y));

    // --- Becoming a raincloud -------------------------------------------------------------------
    // Two ways in, and both matter. A rain event converts the whole field at once, which is what
    // makes a storm a storm rather than a drizzle; and a calm block touching an existing raincloud
    // joins it, which mops up whatever formed after the event began so a storm ends cleanly instead
    // of leaving islands of calm cloud behind.
    if (kind == CLOUD_CALM && (rainPhase == 2u || cloudTouchesRain(pos))) {
        uint newCell = packCloud(CLOUD_RAIN, false, 0u, 0u);
        if (atomicCompSwap(cloudCells[idx], cell, newCell) != cell) return;
        cell = newCell;
        kind = CLOUD_RAIN;
    }

    if (pos.y >= HEIGHT - 2) {
        // At the ceiling. A calm block simply sits here -- there is nothing above to rise into, so
        // it is at rest by construction and its moved bit must read false.
        if (kind != CLOUD_RAIN) {
            if (getCloudMoved(cell)) {
                atomicCompSwap(cloudCells[idx], cell, packCloud(kind, false, 0u, 0u));
            }
            return;
        }

        // A raincloud at the ceiling picks how long to hang there, once, then counts up to it.
        // Target zero means "not yet chosen" -- a real target is always at least rainWaitMinTicks,
        // which the schema floors at 1, so zero is unambiguous.
        uint target = getCloudTarget(cell);
        if (target == 0u) {
            uint lo = min(tuning.rainWaitMinTicks, tuning.rainWaitMaxTicks);
            uint hi = max(tuning.rainWaitMinTicks, tuning.rainWaitMaxTicks);
            float r = hash(vec3(pos) + vec3(pc.time, 17.0f, 3.0f));
            target = lo + uint(r * float(hi - lo + 1u));
            atomicCompSwap(cloudCells[idx], cell, packCloud(CLOUD_RAIN, false, 0u, target));
            return;
        }

        uint counter = getCloudCounter(cell);
        if (counter < target) {
            atomicCompSwap(cloudCells[idx], cell, packCloud(CLOUD_RAIN, false, counter + 1u, target));
            return;
        }

        // Time is up: become water. Never outside the simulated interior -- a water voxel in the
        // border row is one main() would never update again, so it would hang on the wall forever.
        if (!cloudCellInBounds(pos)) return;

        uint g = readCell(idx);
        if (getType(g) != 0u) return;   // occupied: hold the block and try again next dispatch
        if (atomicCompSwap(grid[idx], g, pack(2u, 0u, 0u, 0u)) != g) return;

        // Unconditional, not a compare-and-swap: nothing can move into an occupied cloud cell and
        // only this invocation owns this cell, so there is no race -- and a compare-and-swap that
        // failed for any reason would leave a cloud block standing over water it had already made.
        atomicExchange(cloudCells[idx], 0u);
        incWater();
        if (uint(pos.y) > maxOccupiedY) atomicMax(maxOccupiedY, uint(pos.y));
        return;
    }

    // --- Rise, the way a grain falls ------------------------------------------------------------
    float randVal = hash(vec3(pos) + vec3(pc.time * 2.3f, 7.0f, 13.0f));
    uint counter = getCloudCounter(cell);
    uint target  = getCloudTarget(cell);

    ivec3 upPos = pos + ivec3(0, 1, 0);
    if (cloudCellInBounds(upPos) && getCloudKind(cloudCells[getIndex(upPos)]) == CLOUD_NONE) {
        if (tryMoveCloud(idx, packCloud(kind, true, counter, target), getIndex(upPos), cell)) {
            atomicAdd(cloudMovedCount, 1u);
            return;
        }
    }

    int dir = (fract(randVal * 10.0f) > 0.5f) ? 1 : -1;
    ivec3 slide1, slide2;
    if (fract(randVal * 100.0f) > 0.5f) {
        slide1 = pos + ivec3(dir, 1, 0); slide2 = pos + ivec3(0, 1, dir);
    } else {
        slide1 = pos + ivec3(0, 1, dir); slide2 = pos + ivec3(dir, 1, 0);
    }

    for (int i = 0; i < 2; i++) {
        ivec3 t = (i == 0) ? slide1 : slide2;
        if (!cloudCellInBounds(t)) continue;
        uint tIndex = getIndex(t);
        if (getCloudKind(cloudCells[tIndex]) != CLOUD_NONE) continue;
        if (tryMoveCloud(idx, packCloud(kind, true, counter, target), tIndex, cell)) {
            atomicAdd(cloudMovedCount, 1u);
            return;
        }
    }

    // Went nowhere. Clear the moved bit so the next dispatch sees a block at rest -- this is the
    // only thing that makes "did anything move last tick" mean last tick rather than ever.
    if (getCloudMoved(cell)) {
        atomicCompSwap(cloudCells[idx], cell, packCloud(kind, false, counter, target));
    }
}

// FUNCTION: main
void main() {
    ivec3 pos = ivec3(gl_GlobalInvocationID.xyz);

    // The dispatch rounds up to whole 8-voxel workgroups, so with a grid size that is not a multiple
    // of 8 some invocations land outside the world. They must leave before anything indexes the grid
    // -- the spawn block below runs ahead of the usual interior-bounds test and would write out of
    // bounds. Invocation (0,0,0) is always inside, so the single-writer sweep is unaffected.
    if (pos.x >= WIDTH || pos.y >= HEIGHT || pos.z >= DEPTH) return;

    updateSimState();

    // Before the interior-bounds test below: cloud blocks live in the border columns too, and a
    // column that is never censused would have no cloud drawn over it.
    updateCloudBlock(pos);

    if (pc.spawnActive == 1 && inBrush(pos)) {
        uint spawnIndex = getIndex(pos);
        uint oldType = getType(readCell(spawnIndex));
        uint newType = uint(pc.spawnType);

        // Clicking an existing black hole is the one no-op: re-placing it would burn a second table
        // slot on a voxel that already has one.
        if (newType != 7u || oldType != 7u) {
            if (oldType != newType) {
                if (oldType == 2u) {
                    // Just the count. There is no high mark to lower any more: erasing water by
                    // hand used to read as a deficit the sky would spend a storm refilling, and
                    // weather no longer works by measuring the water level at all.
                    decWater();
                }
                if (oldType == 7u) bhRelease(pos);
                if (newType == 2u) incWater();
            }

            // Lava stages, dark stone and locust swarms are all views of a number in the age byte,
            // so a hand-placed voxel has to be seeded with one. Without it a stage-3 lava dropped
            // from the dropdown would carry coolness 0 and be retyped straight back to stage 0 on
            // its first update, and a placed swarm would be a swarm of nobody and die immediately.
            uint seedAge = isLocust(newType) ? locustSpawnCount(newType) : lavaSpawnCoolness(newType);
            writeCell(spawnIndex, pack(newType, 0u, 0u, seedAge));

            if (newType == 7u) {
                // The voxel is published BEFORE the slot is claimed, and the barrier is what makes
                // that ordering real. This dispatch's table sweep may run at any point relative to
                // this code, and it frees any slot whose voxel is not a hole -- so a slot becoming
                // visible ahead of its voxel would get reaped instantly, leaving a black cube that
                // pulls on nothing.
                //
                // There is no web equivalent, and this is not a translation gap that can be closed.
                // GLSL's memoryBarrierBuffer orders THIS invocation's memory operations and
                // synchronises nothing, so it is legal here, inside a per-voxel branch. WGSL's
                // nearest spelling, storageBarrier, is a different instrument: a workgroup
                // execution barrier every invocation must reach, and therefore illegal in divergent
                // control flow -- Tint rejects it outright with "must only be called from uniform
                // control flow". WGSL has no memory fence without the rendezvous.
                //
                // So the web build goes without, and the race it guards is live there: a black hole
                // placed on the same dispatch its table sweep runs could be reaped between the two
                // writes and leave an inert black voxel. Narrow, and currently unreachable anyway
                // because placing blocks needs the mouse raycast, which the web renderer has not
                // ported yet. Worth revisiting when it is.
#ifndef SAND_WEB
                memoryBarrierBuffer();
#endif
                if (!bhRegister(pos)) {
                    writeCell(spawnIndex, 0u); // table full: roll back rather than leave an inert hole
                }
            }
        }
    }

    if (pos.x < 1 || pos.x >= WIDTH - 1 ||
        pos.y < 1 || pos.y >= HEIGHT - 1 ||
        pos.z < 1 || pos.z >= DEPTH - 1) {
        return;
    }

    uint currentIndex = getIndex(pos);
    uint rawValue = readCell(currentIndex);
    uint currentType = getType(rawValue);

    // --- RAIN: while draining, void cells at the top boundary (same layer steam vents from)
    // may become falling water. The rate is constant for the whole storm and set by
    // rainDropsPerTick; what varies is the storm's LENGTH, which is proportional to how much
    // water was evaporated. There is deliberately no time-based ramp -- a ramp made the rate
    // depend on when you happened to look, which is what made this so hard to reason about.
    // Rain columns. Rain is no longer spawned here by probability -- drops arrive as storm blocks
    // reaching the ceiling and turning into water (see updateCloudBlock). What survives is the
    // census, because it is still the honest answer to "how much of the sky is currently raining"
    // and it costs one atomic on the top layer.
    //
    // The ellipsoid test this used to do is gone with the placement maths it read. A column is under
    // cloud when it has cloud blocks in it, which is now a single lookup and, unlike the ellipsoids,
    // is the same thing the renderer draws by construction rather than by two copies of one formula
    // agreeing.
    if (currentType == 0u && rainPhase >= 1u && pos.y == HEIGHT - 2) {
        if (cloudColumn[cloudColumnBase(pos.x, pos.z) + 2u] != 0u) {
            atomicAdd(rainCandidateCount, 1u);
        }
    }

    if (currentType == 0u) return;

    // Raise the occupied-height ceiling if this voxel sits above it. The read-then-atomic shape is
    // what keeps this affordable: the plain read is uniform across the dispatch and costs a cached
    // load, and the atomic only fires for the thin layer of voxels above the current mark -- so in a
    // settled world it fires only on the dispatches where the decay above dropped the mark by one.
    // Reached after the brush write (rawValue is re-read below it), so hand-placed matter publishes
    // its own height on the dispatch it appears.
    if (uint(pos.y) > maxOccupiedY) atomicMax(maxOccupiedY, uint(pos.y));

    float randVal = hash(vec3(pos) + vec3(pc.time));

    // Checked ahead of the stone early-out on purpose: a black hole tears a stone wall apart the
    // same as anything else, and a hole buried inside one should not be walled off from its own
    // orbit field.
    if (currentType != 7u && captureByBlackHole(pos, currentIndex, rawValue, randVal)) return;

    if (currentType == 3u || currentType == 7u) return;

    uint currentDir = getDir(rawValue);
    uint currentSleep = getSleep(rawValue);
    uint currentAge = getAge(rawValue);

    switch (currentType) {
        case 1u:
            updateSand(pos, currentIndex, rawValue, currentSleep, currentAge, randVal);
            break;
        case 2u:
            updateWater(pos, currentIndex, rawValue, currentDir, currentSleep, currentAge, randVal);
            break;
        case 4u:
            updateDirt(pos, currentIndex, rawValue, currentDir, currentSleep, currentAge, randVal);
            break;
        case 5u:
            updateFire(pos, currentIndex, rawValue, currentDir, currentSleep, currentAge, randVal);
            break;
        case 6u:
            updateSteam(pos, currentIndex, rawValue, currentSleep, currentAge, randVal);
            break;
        case 8u:
        case 9u:
        case 10u:
        case 11u:
            updateLava(pos, currentIndex, rawValue, currentDir, currentSleep, currentAge, randVal);
            break;
        case 12u:
            updateDarkStone(pos, currentIndex, rawValue, currentAge, randVal);
            break;
        case 13u:
        case 14u:
        case 15u:
        case 16u:
        case 17u:
            updateLocust(pos, currentIndex, rawValue, currentDir, currentSleep, currentAge, randVal);
            break;
        case 18u:
            updateTrunk(pos, currentIndex, rawValue, currentDir, currentAge, randVal);
            break;
        case 19u:
            updateLeaf(pos, currentIndex, rawValue, currentAge, randVal);
            break;
        default:
            break;
    }
}
