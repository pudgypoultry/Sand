#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(std430, binding = 0) buffer VoxelGrid {
    uint grid[];
};

// Black holes are the one thing in the sim that acts at a distance, so unlike every other
// material they cannot be discovered by looking at neighbouring voxels. They live in a tiny fixed
// table instead, which every captured particle scans in full -- 8 entries is cheap enough to read
// per voxel per dispatch, and it means the orbit field is exact rather than sampled.
const int BLACK_HOLE_MAX = 8;

// The per-slot reveal/footprint arrays are gone: the cloud field is now a fixed drifting
// population whose layout is a pure function of (index, time), so there is nothing per-cloud
// left to store. See the CLOUD FIELD section below.
layout(std430, binding = 1) buffer SimStats {
    uint waterVoxelCount;
    uint waterHighMark;          // peak water level ever observed -- the target rain restores to
    uint cloudWaterCount;        // steam banked since the last storm; drives how charged the sky looks
    uint rainPhase;
    uint rainPhaseTimeBits;
    uint rainTargetLevel;        // water level this storm rains toward (deficit + overshoot)
    uint rainCandidateCount;     // census of rainable columns, rebuilt every dispatch
    uint rainCandidateEstimate;  // last dispatch's census -- the divisor that sets drop odds
    uint cloudChargeBits;        // float bits: eased 0..1 group-wide cloud opacity/greyness
    uint blackHoleCount;         // live table entries; 0 lets every voxel skip the scan entirely
    uint blackHoles[BLACK_HOLE_MAX];      // 0 = free slot, else BH_ACTIVE | linear voxel index
    uint blackHoleMass[BLACK_HOLE_MAX];   // voxels swallowed; the hole's body size is derived from it
    uint blackHoleStarve[BLACK_HOLE_MAX]; // dispatches since it last had anything captured
};

layout(std140, binding = 2) uniform TuningParams {
    uint rainStartLayers;
    uint rainDropsPerTick;
    float rainOvershoot;
    float rainDarkenDelay;
    uint cloudCount;
    float cloudDriftSpeed;
    float cloudEdgeFadeDist;
    float cloudChargeSaturation;
    float cloudChargeEaseRate;
    float cloudMinAlpha;
    float cloudMaxAlpha;
    float cloudVoxelSize;
    float cloudEdgeThresholdMin;
    float cloudEdgeThresholdMax;
    uint maxCloudSteps;
    uint sandMoistureCapacity;
    uint dirtMoistureCapacity;
    uint sandWaterAbsorbUnit;
    uint sandClumpThreshold;
    uint dirtClumpThreshold;
    uint wakeSleepThreshold;
    uint emptyBelowWakeCount;
    uint fireLifetime;
    uint fireDryRate;
    float grassGrowChance;
    float grassSubmergedDecayChance;
    float fireBurnGrassChance;
    float fireSpreadChance;
    float steamScatterChance;
    uint blackHoleHorizon;
    uint blackHoleRadius;
    float blackHoleOrbitSpeed;
    float blackHoleInfall;
    float blackHolePlaneGrip;
    float blackHoleGlow;
    uint blackHoleOrbitPlanes;
    float blackHoleGrowthCost;
    uint blackHoleMaxLevel;
    uint blackHoleStarveGrace;
    uint blackHoleDecayRate;
    float waterShadowTransmit;
} tuning;

const uint LAYER_SIZE = 128u * 128u; // 16384 — one layer

layout(push_constant) uniform Constants {
    float time;
    float pitch;
    float yaw;
    float camX;
    float camY;
    float camZ;
    int spawnX;
    int spawnY;
    int spawnZ;
    int spawnActive;
    int spawnType;
    int spawnSize;
    float fovDistance;
    float perspectiveBlend;
    int spawnShape; // 0 = cube, 1 = sphere
} pc;

const int WIDTH = 128;
const int HEIGHT = 128;
const int DEPTH = 128;

// FUNCTION: getHDir
ivec3 getHDir(int d) {
    if (d == 0) return ivec3(1, 0, 0);
    if (d == 1) return ivec3(-1, 0, 0);
    if (d == 2) return ivec3(0, 0, 1);
    if (d == 3) return ivec3(0, 0, -1);
    if (d == 4) return ivec3(1, 0, 1);
    if (d == 5) return ivec3(1, 0, -1);
    if (d == 6) return ivec3(-1, 0, 1);
    return ivec3(-1, 0, -1);
}

// FUNCTION: getOrthoDir
ivec3 getOrthoDir(int d) {
    if (d == 0) return ivec3(1, 0, 0);
    if (d == 1) return ivec3(-1, 0, 0);
    if (d == 2) return ivec3(0, 1, 0);
    if (d == 3) return ivec3(0, -1, 0);
    if (d == 4) return ivec3(0, 0, 1);
    return ivec3(0, 0, -1);
}

// FUNCTION: getIndex
uint getIndex(ivec3 pos) {
    return uint(pos.x + (pos.y * WIDTH) + (pos.z * WIDTH * HEIGHT));
}

// FUNCTION: pack
uint pack(uint type, uint dir, uint sleep, uint age) {
    return (type & 0xFFu) | ((dir & 0xFFu) << 8) | ((sleep & 0xFFu) << 16) | ((age & 0xFFu) << 24);
}

// FUNCTION: getType
uint getType(uint val) {
    return val & 0xFFu;
}

// FUNCTION: getDir
uint getDir(uint val) {
    return (val >> 8) & 0xFFu;
}

// FUNCTION: getSleep
uint getSleep(uint val) {
    return (val >> 16) & 0xFFu;
}

// FUNCTION: getAge
uint getAge(uint val) {
    return (val >> 24) & 0xFFu;
}

// FUNCTION: hash
float hash(vec3 p) {
    return fract(sin(dot(p, vec3(12.9898f, 78.233f, 45.164f))) * 43758.5453f);
}

// FUNCTION: incWater / decWater
// waterVoxelCount tracks exactly one thing: how many type-2 water voxels currently exist in
// the grid. Not "water in the system" -- water stored as soil moisture or as airborne steam is
// deliberately NOT counted, because those are different storage forms with their own state.
// Keeping this to a single, directly-observable meaning is what makes the conservation loop
// auditable: water voxel -> steam (dec) -> vents off the top (cloudWaterCount +1) -> rains back
// down (cloudWaterCount -1, inc) balances exactly, and soil absorption (dec) / percolation (inc)
// balance against each other. Every transition that creates or destroys a water voxel must call
// one of these. decWater relies on uint wraparound (adding 0xFFFFFFFFu == -1 under modular
// arithmetic) since atomicAdd has no signed form.
void incWater() { atomicAdd(waterVoxelCount, 1u); }
void decWater() { atomicAdd(waterVoxelCount, 0xFFFFFFFFu); }

// FUNCTION: getRainThreshold
// Was a compile-time `const` before its input moved into the TuningParams UBO; GLSL const
// initializers can't reference a uniform, so it's computed on demand here instead.
uint getRainThreshold() { return tuning.rainStartLayers * LAYER_SIZE; }

// =================================================================================================
// BLACK HOLE TABLE
//
// A slot holds a black hole's voxel index with the top bit set, so 0 is unambiguously "free" even
// though voxel index 0 is a real (if unreachable) address. 128^3 needs 21 bits, leaving bit 31
// free for the flag.
// =================================================================================================
const uint BH_ACTIVE = 0x80000000u;
const uint BH_INDEX_MASK = 0x7FFFFFFFu;

// FUNCTION: bhDecode
ivec3 bhDecode(uint code) {
    uint i = code & BH_INDEX_MASK;
    return ivec3(int(i % uint(WIDTH)), int((i / uint(WIDTH)) % uint(HEIGHT)), int(i / uint(WIDTH * HEIGHT)));
}

// FUNCTION: bhRegister
// Claims a slot for a new hole, or reports failure when the table is full -- the caller must not
// place the voxel unless this succeeds, or the grid would hold a black cube that pulls on nothing.
bool bhRegister(ivec3 p) {
    uint code = BH_ACTIVE | getIndex(p);
    for (int i = 0; i < BLACK_HOLE_MAX; i++) {
        if (atomicCompSwap(blackHoles[i], 0u, code) == 0u) {
            blackHoleMass[i] = 0u;   // a fresh hole starts at level 0, whatever the last tenant ate
            blackHoleStarve[i] = 0u; // and gets a full grace period before it can evaporate
            return true;
        }
    }
    return false;
}

// FUNCTION: bhRelease
void bhRelease(ivec3 p) {
    uint code = BH_ACTIVE | getIndex(p);
    for (int i = 0; i < BLACK_HOLE_MAX; i++) {
        atomicCompSwap(blackHoles[i], code, 0u);
    }
}

// FUNCTION: bhBodyRadius
// The hole's body is a ball, so its diameter runs 1, 3, 5, ... voxels as it grows.
float bhBodyRadius(uint level) { return float(level) + 0.5f; }

// FUNCTION: bhLevel
// Size of the hole's body. It advances a level once it has swallowed as many voxels as the next size
// would itself occupy, so its body ends up about as big as what it ate.
//
// Derived from the swallowed count rather than stored alongside it. There is deliberately no
// separate "current size" field to keep in step: the drawn body and the eaten total cannot disagree
// if only one of them exists, and the growth threshold can be retuned in the config without
// stranding holes at a size they could no longer justify.
//
// DUPLICATED IN raymarch.frag -- the renderer sizes the body from the same count, so if you change
// the curve here you MUST change it there or the drawn body will stop matching the one that eats.
uint bhLevel(uint mass) {
    uint level = 0u;
    for (uint l = 1u; l <= min(tuning.blackHoleMaxLevel, 16u); l++) {
        float r = bhBodyRadius(l);
        float volume = 4.18879f * r * r * r; // 4/3 pi r^3
        if (float(mass) < tuning.blackHoleGrowthCost * volume) break;
        level = l;
    }
    return level;
}

// FUNCTION: bhPlaneNormal
// One candidate orbital plane out of the hole's fan, as its normal.
//
// Spread over a HEMISPHERE, not a full sphere: n and -n describe the same plane, so sampling the
// whole sphere would produce pairs of near-identical candidates for a particle to flip between.
// z is uniform in (0,1), which is uniform by area on a hemisphere, and the golden angle keeps
// successive normals from clumping into a stripe. `seed` rotates the whole fan per hole so two
// holes side by side don't share inclinations.
vec3 bhPlaneNormal(int k, int planeCount, float seed) {
    float z = (float(k) + 0.5f) / float(planeCount);
    float r = sqrt(max(0.0f, 1.0f - z * z));
    float a = 2.399963f * float(k) + seed; // golden angle
    return vec3(r * cos(a), z, r * sin(a));
}

// FUNCTION: bhOrbitAxis
// The axis of the orbit this particle is on -- the signed normal of its own plane.
//
// A great circle through the centre lies in a plane that CONTAINS the particle's position, and that
// is what makes a purely geometric choice self-sustaining: the particle takes whichever candidate
// most nearly contains it right now, and because its orbit then keeps it inside that plane, the same
// candidate keeps winning on every later tick. Each plane's "winning region" is the band around its
// own great circle, so an orbit never wanders out of the region that selected it.
//
// Hashing a plane per particle instead cannot work here. Nothing identifies a particle across ticks
// -- there is no id to hash, only a position, and a position-seeded plane would re-roll the instant
// the particle moved, producing a random walk rather than an orbit.
//
// The circulation sense is hashed per plane index, which is stable because the index is, so roughly
// half the fan runs retrograde and the shell doesn't read as all-one-way swirl.
vec3 bhOrbitAxis(ivec3 center, ivec3 pos) {
    vec3 radial = normalize(vec3(pos - center));
    int planeCount = int(clamp(tuning.blackHoleOrbitPlanes, 1u, 32u));
    float seed = hash(vec3(center) + vec3(29.0f, 3.0f, 71.0f)) * 6.28318f;

    vec3 best = vec3(0.0f, 1.0f, 0.0f);
    float bestAlign = 2.0f;
    int bestK = 0;

    for (int k = 0; k < planeCount; k++) {
        vec3 n = bhPlaneNormal(k, planeCount, seed);
        float align = abs(dot(n, radial)); // 0 when the plane contains the particle exactly
        if (align < bestAlign) {
            bestAlign = align;
            best = n;
            bestK = k;
        }
    }

    float sense = (hash(vec3(center) + vec3(float(bestK) * 13.0f, 101.0f, 47.0f)) < 0.5f) ? -1.0f : 1.0f;
    return best * sense;
}

// FUNCTION: inBrush
// The set of voxels the spawn brush writes. Cube bounds are tested first because they are cheap and
// are exactly the region the box cursor draws; the sphere test then carves the round brush out of
// that.
//
// The sphere test is done entirely in world coordinates -- voxel CENTRES against a centre derived
// from the same bounds the renderer's outline uses -- because a voxel's integer position is its min
// corner, and testing corners instead would place the sphere half a voxel off the one drawn.
bool inBrush(ivec3 pos) {
    int halfMin = pc.spawnSize / 2;
    int halfMax = (pc.spawnSize - 1) / 2;

    if (pos.x < pc.spawnX - halfMin || pos.x > pc.spawnX + halfMax) return false;
    if (pos.y < pc.spawnY - halfMin || pos.y > pc.spawnY + halfMax) return false;
    if (pos.z < pc.spawnZ - halfMin || pos.z > pc.spawnZ + halfMax) return false;

    if (pc.spawnShape != 1) return true;

    vec3 center = vec3(pc.spawnX, pc.spawnY, pc.spawnZ) + vec3(float(halfMax - halfMin + 1) * 0.5f);
    vec3 d = (vec3(pos) + 0.5f) - center;
    float radius = float(pc.spawnSize) * 0.5f;
    return dot(d, d) <= radius * radius;
}

// =================================================================================================
// CLOUD FIELD -- shared placement math. THIS BLOCK IS DUPLICATED VERBATIM IN raymarch.frag.
//
// Cloud layout is a pure function of (index, time) and is stored nowhere. Both stages receive the
// same pc.time in a single vkCmdPushConstants call, so the compute stage (deciding which columns
// sit under a cloud and may rain) and the fragment stage (drawing them) derive byte-identical
// positions with no synchronisation and no per-slot buffer. If you edit one copy you MUST edit
// the other, or rain will fall out of a clear sky.
//
// The population is fixed: clouds scroll along +X and wrap, so one drifts out of the far border
// exactly as another drifts in at the near one. Nothing is ever "revealed" or "retired".
// =================================================================================================
const int CLOUD_MAX = 64;

// FUNCTION: cloudRadii
vec3 cloudRadii(int i) {
    float h4 = hash(vec3(float(i), 211.0f, 5.0f));
    float h5 = hash(vec3(float(i), 71.0f, 61.0f));
    float h6 = hash(vec3(float(i), 19.0f, 173.0f));
    float rxz = 10.0f + h4 * 18.0f;
    return vec3(rxz, 4.0f + h5 * 6.0f, rxz * (0.7f + h6 * 0.6f));
}

// FUNCTION: cloudCenterXZ
vec2 cloudCenterXZ(int i, float t) {
    float h1 = hash(vec3(float(i), 11.0f, 3.0f));
    float h2 = hash(vec3(float(i), 47.0f, 91.0f));
    float phase = hash(vec3(float(i), 91.0f, 250.0f)) * 6.28318f;

    float x = mod(h1 * 128.0f + t * tuning.cloudDriftSpeed, 128.0f);
    float z = mod(h2 * 128.0f + sin(t * 0.12f + phase) * 3.0f, 128.0f);
    return vec2(x, z);
}

// FUNCTION: cloudEdgeFade
// 1 over the middle of the cube, falling to 0 at each border. The fade has to happen INSIDE the
// footprint because the renderer already hard-clips clouds to the cube's XZ column -- fading
// outside it would be invisible and clouds would still pop at the boundary. This is what makes a
// cloud dissolve as it reaches the border and re-emerge on the opposite side.
float cloudEdgeFade(vec2 c) {
    float d = max(tuning.cloudEdgeFadeDist, 0.001f);
    float fx = smoothstep(0.0f, d, c.x) * smoothstep(0.0f, d, 128.0f - c.x);
    float fz = smoothstep(0.0f, d, c.y) * smoothstep(0.0f, d, 128.0f - c.y);
    return fx * fz;
}

// FUNCTION: getWaterDeficit
// How far the cube's water level has fallen below its peak -- this, not a running tally of
// evaporation events, is what a storm has to repay. Counting events could only ever undercount
// the real loss, because water leaves the visible pool through paths that were never credited:
// steam absorbed into soil on the way up never reaches the top to be banked, and rain absorbed
// into soil on the way down repaid the old debt while adding no water back. Measuring the level
// directly is immune to all of that -- however water went missing, and wherever it went, the
// deficit reflects it, and rain keeps falling until the level is actually restored.
uint getWaterDeficit() {
    return (waterHighMark > waterVoxelCount) ? (waterHighMark - waterVoxelCount) : 0u;
}

// FUNCTION: tryMove
bool tryMove(uint currentIndex, uint currentValue, uint targetIndex, uint newValue) {
    uint targetValue = grid[targetIndex];
    uint targetType = getType(targetValue);
    uint currentType = getType(currentValue);

    if (targetType == 0u || ((currentType == 1u || currentType == 4u) && targetType == 2u) || (currentType == 6u && targetType == 5u)) {
        if (atomicCompSwap(grid[currentIndex], currentValue, 0u) == currentValue) {
            uint actual = atomicCompSwap(grid[targetIndex], targetValue, newValue);
            if (actual == targetValue) {
                if (targetType != 0u) {
                    atomicExchange(grid[currentIndex], targetValue); 
                }
                return true;
            } else {
                atomicCompSwap(grid[currentIndex], 0u, currentValue);
            }
        }
    }
    return false;
}

// FUNCTION: tryDisplace
bool tryDisplace(uint currentIndex, uint currentValue, uint targetIndex, uint targetValue, uint pushIndex) {
    if (atomicCompSwap(grid[currentIndex], currentValue, 0u) == currentValue) {
        uint displacedValue = pack(getType(targetValue), 0u, 0u, 0u); 
        uint actualPush = atomicCompSwap(grid[pushIndex], 0u, displacedValue);
        
        if (actualPush == 0u) {
            uint actualTarget = atomicCompSwap(grid[targetIndex], targetValue, currentValue);
            if (actualTarget == targetValue) {
                return true;
            } else {
                atomicCompSwap(grid[pushIndex], displacedValue, 0u);
            }
        }
        atomicCompSwap(grid[currentIndex], 0u, currentValue);
    }
    return false;
}


// FUNCTION: orbitStep
// Moves a captured particle one cell along `stepDir`, into empty space only. Orbiting matter
// deliberately does NOT get the displacement rules the falling materials have: two particles
// arriving at the same cell should queue up behind each other, because that queueing is what gives
// the shell visible density instead of letting everything pass through everything else.
bool orbitStep(ivec3 pos, uint currentIndex, uint rawValue, ivec3 stepDir) {
    if (stepDir == ivec3(0)) return false;

    ivec3 target = pos + stepDir;
    if (target.x < 1 || target.x >= WIDTH - 1 ||
        target.y < 1 || target.y >= HEIGHT - 1 ||
        target.z < 1 || target.z >= DEPTH - 1) return false;

    uint targetIndex = getIndex(target);
    if (getType(grid[targetIndex]) != 0u) return false;

    return tryMove(currentIndex, rawValue, targetIndex,
                   pack(getType(rawValue), getDir(rawValue), 0u, getAge(rawValue)));
}

// FUNCTION: dominantAxis
// Collapses a continuous direction onto the 26 lattice steps: the largest component always steps,
// and the others join in when they are within 55% of it, which is what produces diagonal moves.
ivec3 dominantAxis(vec3 dir, float relative) {
    vec3 a = abs(dir);
    float m = max(a.x, max(a.y, a.z));
    if (m <= 0.0f) return ivec3(0);
    return ivec3(greaterThanEqual(a, vec3(m * relative))) * ivec3(sign(dir));
}

// FUNCTION: updateOrbital
// One tick of a particle held by a black hole. This replaces the particle's own material update
// outright -- captured matter is on an orbit, not falling -- which is the whole reason the shell
// stays up instead of raining down onto the hole.
//
// There is no force, acceleration or velocity anywhere in here, and nowhere to put one: a voxel has
// three spare bytes, all of them already spoken for by the materials. So a "gravity well" is instead
// a direction field sampled fresh every tick, plus two probabilities. The direction is purely
// sideways -- tangent to the particle's own orbital plane (see bhOrbitAxis), corrected back toward
// that plane -- and the two rolls supply everything a magnitude normally would:
//
//   speed  -- how OFTEN a step is taken, ~speed/sqrt(distance), reproducing the Keplerian shear
//             that makes inner orbits visibly outrun outer ones.
//   infall -- how often that step spirals inward instead of continuing around, which is what makes
//             the orbit decay over many revolutions rather than in one.
//
// Both are probabilities for the same reason: a move is exactly one voxel, so a step has no room to
// carry a magnitude. Encoding either as a vector weight instead fails in a way that looks like it
// works -- see the note on the infall roll below.
void updateOrbital(ivec3 pos, uint currentIndex, uint rawValue, ivec3 center, int slot, uint level, float dist, float randVal) {
    uint type = getType(rawValue);
    uint sleep = getSleep(rawValue);

    // Something is captured, so the hole is not starving -- reset the clock before anything else,
    // including before the swallow test, so a hole with matter merely orbiting it stays alive rather
    // than having to actually eat to survive. A plain store rather than an atomic: every captured
    // particle writes the same constant, so racing writes all agree, and the counter only ever feeds
    // a coarse "has this hole seen anything lately" decision.
    blackHoleStarve[slot] = 0u;

    // A hole voids a spherical shell around itself, not just the voxels its body occupies:
    // everything within body radius + horizon. The horizon is an offset PAST the body rather than an
    // absolute distance, so the cleared region stays tied to the size the hole is drawn at as it
    // grows, and the hole never sits flush against whatever it is eating.
    if (dist <= bhBodyRadius(level) + float(tuning.blackHoleHorizon)) {
        if (atomicCompSwap(grid[currentIndex], rawValue, 0u) == rawValue) {
            // Credited only on a successful swap, so two invocations racing the same voxel can
            // never both bill it -- the hole's size is a running total and would drift permanently.
            atomicAdd(blackHoleMass[slot], 1u);

            if (type == 2u) {
                decWater();
                // A hole keeps what it swallows, so this water can never be rained back. The high
                // mark has to come down with it, or the sky would open a storm it can never finish.
                atomicAdd(waterHighMark, 0xFFFFFFFFu);
            }
        }
        return;
    }

    // Held but not moving this tick. Sleep is still cleared: the particle skipped its material
    // update, and a stale sleep counter would leave it frozen once it drifts back out of range.
    if (randVal > clamp(tuning.blackHoleOrbitSpeed / sqrt(max(dist, 1.0f)), 0.0f, 1.0f)) {
        if (sleep != 0u) {
            atomicCompSwap(grid[currentIndex], rawValue, pack(type, getDir(rawValue), 0u, getAge(rawValue)));
        }
        return;
    }

    vec3 inward = normalize(vec3(center - pos));
    vec3 axis = bhOrbitAxis(center, pos);

    vec3 tangent = cross(axis, inward);
    float tangentLen = length(tangent);
    if (tangentLen < 0.05f) {
        // The chosen plane nearly contains the particle, so this is rare -- but a particle sitting
        // on its own axis has no direction to travel. Any perpendicular gets it moving, after which
        // the field takes over.
        tangent = normalize(cross(axis, vec3(0.577f, 0.577f, 0.577f)));
    } else {
        tangent /= tangentLen;
    }

    // Cancel whatever drift has accumulated along the plane's normal. Without this the orbit is
    // free to wander off its plane and the whole shell degenerates into a formless cloud.
    float axial = dot(vec3(pos - center), axis);
    vec3 grip = -axis * clamp(axial * 0.5f, -1.0f, 1.0f) * tuning.blackHolePlaneGrip;

    // Direction to travel along the orbit. Safe to normalize: tangent is a unit vector orthogonal
    // to grip, so the sum can never cancel to zero however grip is weighted. Infall is deliberately
    // NOT blended in here -- see the roll below.
    vec3 along = normalize(tangent + grip);

    // Infall has to be a PROBABILITY rather than a component of the direction, and the reason is not
    // obvious: blending it into the direction looks like it works and then quietly stops.
    //
    // A one-voxel move quantises direction to the 26 lattice neighbours. A small inward term does
    // bend some of those steps inward, so the orbit really does decay at first -- but only down to a
    // radius fixed by the infall weight, where the orbit locks into a closed lattice loop whose
    // rounding error exactly cancels the inward bias. That loop is a stable attractor, not a
    // coincidence: at the 0.16 default a particle released anywhere between r=10 and r=28 settles
    // onto the SAME r~6.7 cycle, 36 steps around, and orbits it forever without ever reaching the
    // horizon. Matter parked in mid-air near a hole is this.
    //
    // Rolling for infall removes the attractor, because there is no longer a fixed direction field
    // to lock into: decay becomes reliable at every radius, and a particle from r=28 reaches the
    // horizon in ~460 steps. It also mirrors how orbital SPEED is handled a few lines up, for the
    // same underlying reason -- a one-voxel step has no room to carry a magnitude.
    bool pullIn = fract(randVal * 61.0f) < clamp(tuning.blackHoleInfall, 0.0f, 1.0f);

    // Still mostly sideways when it does fall, so infall reads as the spiral tightening rather than
    // the particle abruptly dropping out of its orbit.
    vec3 spiral = normalize(inward + tangent * 0.6f);

    if (pullIn && orbitStep(pos, currentIndex, rawValue, dominantAxis(spiral, 0.55f))) return;

    if (orbitStep(pos, currentIndex, rawValue, dominantAxis(along, 0.55f))) return;
    if (orbitStep(pos, currentIndex, rawValue, dominantAxis(along, 1.0f))) return;
    // Blocked in the direction it wants, so slide along the ring instead. A jammed orbit is
    // traffic that clears as the particles ahead move on -- never a reason to drop out of the orbit.
    if (orbitStep(pos, currentIndex, rawValue, dominantAxis(tangent, 1.0f))) return;

    // Last resort: inward. Captured matter packs tight enough to gridlock -- every particle wanting
    // a tangential cell that another captured particle already occupies -- and with no inward option
    // that jam never breaks, which is the second way matter ends up hanging in space. Dropping
    // inward when the ring is blocked lets a clump drain from its inner edge, where the horizon is
    // already eating it.
    if (orbitStep(pos, currentIndex, rawValue, dominantAxis(inward, 0.55f))) return;
    if (orbitStep(pos, currentIndex, rawValue, dominantAxis(inward, 1.0f))) return;

    if (sleep != 0u) {
        atomicCompSwap(grid[currentIndex], rawValue, pack(type, getDir(rawValue), 0u, getAge(rawValue)));
    }
}

// FUNCTION: captureByBlackHole
// Scans the table and hands the particle to the nearest hole whose influence it is inside.
// Returns false for the overwhelmingly common case of a particle nowhere near one.
bool captureByBlackHole(ivec3 pos, uint currentIndex, uint rawValue, float randVal) {
    if (blackHoleCount == 0u) return false;

    float bestDistSq = 3.0e9f;
    ivec3 bestCenter = ivec3(0);
    int bestSlot = -1;
    uint bestLevel = 0u;

    // Widest reach any hole could possibly have. Every solid voxel in the grid runs this loop every
    // dispatch, so the distance test has to come BEFORE bhLevel -- deriving a level per slot per
    // voxel would put a growth-threshold search on the hot path for the whole grid, to answer a
    // question that only matters for voxels already near a hole.
    float maxRadius = float(tuning.blackHoleRadius + min(tuning.blackHoleMaxLevel, 16u));
    float maxRadiusSq = maxRadius * maxRadius;

    for (int i = 0; i < BLACK_HOLE_MAX; i++) {
        uint code = blackHoles[i];
        if (code == 0u) continue;

        ivec3 center = bhDecode(code);
        vec3 d = vec3(center - pos);
        float distSq = dot(d, d);
        if (distSq > maxRadiusSq || distSq >= bestDistSq) continue;

        // Reach grows with the body, one voxel per level, so a hole that has eaten a dune pulls on
        // a wider field than the pinprick it started as.
        uint level = bhLevel(blackHoleMass[i]);
        float radius = float(tuning.blackHoleRadius + level);

        if (distSq <= radius * radius) {
            bestDistSq = distSq;
            bestCenter = center;
            bestSlot = i;
            bestLevel = level;
        }
    }

    if (bestSlot < 0) return false;

    updateOrbital(pos, currentIndex, rawValue, bestCenter, bestSlot, bestLevel, sqrt(bestDistSq), randVal);
    return true;
}

// FUNCTION: getRainDropChance
// Rain's rate control, expressed as a per-column probability rather than a shared allowance.
//
// The obvious implementation -- a global budget of N drops that columns claim atomically until
// it runs out -- silently biases rain to one side of the cube. Workgroups are dispatched in
// roughly spatial order, so low-x/low-z columns reliably reach the counter first and drain the
// whole allowance before the far side ever attempts a claim. The rate comes out correct while
// the distribution is badly skewed, which is exactly the sort of bug that looks like a rendering
// problem and isn't.
//
// Instead, every eligible column rolls independently against the same probability, so placement
// carries no dependence on execution order whatsoever. To keep the *rate* fixed while doing that,
// the odds are divided by a live census of how many columns are currently rainable (counted last
// dispatch): odds = wanted_drops / candidates, giving an expected wanted_drops per tick no matter
// whether one small cloud or a full overcast sky is overhead. Capping wanted_drops at the
// outstanding deficit tapers the final tick so a storm can't overshoot and ratchet the high mark.
float getRainDropChance(uint candidates, uint remaining) {
    if (candidates == 0u) return 0.0f;
    uint want = min(tuning.rainDropsPerTick, remaining);
    return clamp(float(want) / float(candidates), 0.0f, 1.0f);
}


// FUNCTION: updateSand
void updateSand(ivec3 pos, uint currentIndex, uint rawValue, uint currentSleep, uint currentAge, float randVal) {
    uint moisture = currentAge;
    bool moistureModified = false;
    
    if (moisture < tuning.sandMoistureCapacity) {
        int startDir = int(fract(randVal * 17.0f) * 6.0f);
        for(int i = 0; i < 6; i++) {
            int d = (startDir + i) % 6;
            if (d != 2) {
                ivec3 nPos = pos + getOrthoDir(d);
                if (nPos.x > 0 && nPos.x < WIDTH-1 && nPos.y > 0 && nPos.y < HEIGHT-1 && nPos.z > 0 && nPos.z < DEPTH-1) {
                    uint nIndex = getIndex(nPos);
                    uint nVal = grid[nIndex];

                    if (getType(nVal) == 2u) {
                        if (atomicCompSwap(grid[nIndex], nVal, 0u) == nVal) {
                            atomicAdd(grid[currentIndex], tuning.sandWaterAbsorbUnit << 24);
                            decWater(); // water voxel consumed into soil moisture
                            moistureModified = true;
                            break;
                        }
                    }
                }
            }
        }
    }

    if (!moistureModified && moisture > 0u) {
        int d = int(fract(randVal * 31.0f) * 6.0f);
        if (d != 2) {
            ivec3 nPos = pos + getOrthoDir(d);
            if (nPos.x > 0 && nPos.x < WIDTH-1 && nPos.y > 0 && nPos.y < HEIGHT-1 && nPos.z > 0 && nPos.z < DEPTH-1) {
                uint nIndex = getIndex(nPos);
                uint nVal = grid[nIndex];
                uint nType = getType(nVal);

                if (nType == 1u || nType == 4u) {
                    uint nMoisture = getAge(nVal);
                    uint nCapacity = (nType == 4u) ? tuning.dirtMoistureCapacity : tuning.sandMoistureCapacity;

                    if (moisture > nMoisture + 1u && nMoisture < nCapacity) {
                        atomicAdd(grid[currentIndex], 0xFF000000u);
                        atomicAdd(grid[nIndex], 1u << 24);
                        moistureModified = true;
                    }
                }
            }
        }
    }

    if (!moistureModified && moisture >= tuning.sandWaterAbsorbUnit) {
        ivec3 leakPos = pos + ivec3(0, -1, 0);
        if (leakPos.y > 0 && getType(grid[getIndex(leakPos)]) == 0u) {
            if (atomicCompSwap(grid[getIndex(leakPos)], 0u, pack(2u, 0u, 0u, 0u)) == 0u) {
                // Release exactly what one absorption stored. Was hardcoded 0xA6000000u, which
                // is (-90 << 24) and so silently assumed sandWaterAbsorbUnit == 90; deriving it
                // keeps percolation balanced if that value is ever retuned in the config.
                atomicAdd(grid[currentIndex], (0u - tuning.sandWaterAbsorbUnit) << 24);
                incWater(); // moisture percolated back out as a real water voxel
                moistureModified = true;
            }
        }
    }

    if (moistureModified) return;

    bool isClumped = false;
    if (moisture > 0u && currentSleep > tuning.wakeSleepThreshold) {
        int emptyBelowCount = 0;
        if (pos.y > 1) {
            for (int x = -1; x <= 1; x++) {
                for (int z = -1; z <= 1; z++) {
                    ivec3 checkPos = pos + ivec3(x, -1, z);
                    if (checkPos.x >= 0 && checkPos.x < WIDTH && checkPos.z >= 0 && checkPos.z < DEPTH) {
                        if (getType(grid[getIndex(checkPos)]) == 0u) {
                            emptyBelowCount++;
                        }
                    }
                }
            }
        }

        if (emptyBelowCount >= int(tuning.emptyBelowWakeCount)) {
            currentSleep = 0u;
        } else {
            int clumpCount = 0;
            for (int x = -1; x <= 1; x++) {
                for (int y = -1; y <= 1; y++) {
                    for (int z = -1; z <= 1; z++) {
                        if (x == 0 && y == 0 && z == 0) continue;
                        ivec3 nPos = pos + ivec3(x, y, z);
                        if (nPos.x >= 0 && nPos.x < WIDTH && nPos.y >= 0 && nPos.y < HEIGHT && nPos.z >= 0 && nPos.z < DEPTH) {
                            if (getType(grid[getIndex(nPos)]) == 1u) clumpCount++;
                        }
                    }
                }
            }
            if (clumpCount >= int(tuning.sandClumpThreshold)) isClumped = true;
        }
    }

    if (!isClumped) {
        if (pos.y > 1) {
            ivec3 belowPos = pos + ivec3(0, -1, 0);
            if (getType(grid[getIndex(belowPos)]) == 0u) {
                if (tryMove(currentIndex, rawValue, getIndex(belowPos), pack(1u, 0u, 0u, moisture))) return;
            }
        }

        if (pos.y > 1) {
            int dir = (fract(randVal * 10.0f) > 0.5f) ? 1 : -1;
            ivec3 slidePos1, slidePos2;
            
            if (fract(randVal * 100.0f) > 0.5f) {
                slidePos1 = pos + ivec3(dir, -1, 0); slidePos2 = pos + ivec3(0, -1, dir);
            } else {
                slidePos1 = pos + ivec3(0, -1, dir); slidePos2 = pos + ivec3(dir, -1, 0);
            }

            if (slidePos1.x > 0 && slidePos1.x < WIDTH - 1 && slidePos1.z > 0 && slidePos1.z < DEPTH - 1) {
                if (getType(grid[getIndex(slidePos1)]) == 0u) {
                    if (tryMove(currentIndex, rawValue, getIndex(slidePos1), pack(1u, 0u, 0u, moisture))) return;
                }
            }
            if (slidePos2.x > 0 && slidePos2.x < WIDTH - 1 && slidePos2.z > 0 && slidePos2.z < DEPTH - 1) {
                if (getType(grid[getIndex(slidePos2)]) == 0u) {
                    if (tryMove(currentIndex, rawValue, getIndex(slidePos2), pack(1u, 0u, 0u, moisture))) return;
                }
            }
        }

        if (pos.y > 1) {
            ivec3 belowPos = pos + ivec3(0, -1, 0);
            uint belowIndex = getIndex(belowPos);
            uint belowValue = grid[belowIndex];
            
            if (getType(belowValue) == 2u) {
                int startDir = int(fract(randVal * 8.0f) * 8.0f);
                for (int i = 0; i < 8; i++) {
                    int d = (startDir + i) % 8;
                    ivec3 pushPos = belowPos + getHDir(d);
                    if (pushPos.x > 0 && pushPos.x < WIDTH - 1 && pushPos.z > 0 && pushPos.z < DEPTH - 1) {
                        if (tryDisplace(currentIndex, pack(1u, 0u, 0u, moisture), belowIndex, belowValue, getIndex(pushPos))) return; 
                    }
                }
                if (tryMove(currentIndex, rawValue, belowIndex, pack(1u, 0u, 0u, moisture))) return;
            }

            int dir = (fract(randVal * 10.0f) > 0.5f) ? 1 : -1;
            ivec3 slidePos[2];
            if (fract(randVal * 100.0f) > 0.5f) {
                slidePos[0] = pos + ivec3(dir, -1, 0); slidePos[1] = pos + ivec3(0, -1, dir);
            } else {
                slidePos[0] = pos + ivec3(0, -1, dir); slidePos[1] = pos + ivec3(dir, -1, 0);
            }

            for (int s = 0; s < 2; s++) {
                ivec3 sPos = slidePos[s];
                if (sPos.x > 0 && sPos.x < WIDTH - 1 && sPos.z > 0 && sPos.z < DEPTH - 1) {
                    uint sIndex = getIndex(sPos);
                    uint sValue = grid[sIndex];
                    if (getType(sValue) == 2u) {
                        int startDir = int(fract(randVal * 8.0f + float(s)) * 8.0f);
                        for (int i = 0; i < 8; i++) {
                            int d = (startDir + i) % 8;
                            ivec3 pushPos = sPos + getHDir(d);
                            if (pushPos.x > 0 && pushPos.x < WIDTH - 1 && pushPos.z > 0 && pushPos.z < DEPTH - 1) {
                                if (tryDisplace(currentIndex, pack(1u, 0u, 0u, moisture), sIndex, sValue, getIndex(pushPos))) return;
                            }
                        }
                        if (tryMove(currentIndex, rawValue, sIndex, pack(1u, 0u, 0u, moisture))) return;
                    }
                }
            }
        }
    }

    uint newSleep = min(currentSleep + 1u, 255u);
    atomicCompSwap(grid[currentIndex], rawValue, pack(1u, 0u, newSleep, moisture));
}

// FUNCTION: updateDirt
void updateDirt(ivec3 pos, uint currentIndex, uint rawValue, uint currentDir, uint currentSleep, uint currentAge, float randVal) {
    uint moisture = currentAge;
    bool moistureModified = false;
    
    if (moisture < tuning.dirtMoistureCapacity) {
        int startDir = int(fract(randVal * 17.0f) * 6.0f);
        for(int i = 0; i < 6; i++) {
            int d = (startDir + i) % 6;
            ivec3 nPos = pos + getOrthoDir(d);
            if (nPos.x > 0 && nPos.x < WIDTH-1 && nPos.y > 0 && nPos.y < HEIGHT-1 && nPos.z > 0 && nPos.z < DEPTH-1) {
                uint nIndex = getIndex(nPos);
                uint nVal = grid[nIndex];

                if (getType(nVal) == 2u) {
                    if (atomicCompSwap(grid[nIndex], nVal, 0u) == nVal) {
                        atomicAdd(grid[currentIndex], tuning.sandWaterAbsorbUnit << 24);
                        decWater(); // water voxel consumed into soil moisture
                        moistureModified = true;
                        break;
                    }
                }
            }
        }
    }

    if (!moistureModified && moisture > 0u) {
        int d = int(fract(randVal * 31.0f) * 6.0f);
        ivec3 nPos = pos + getOrthoDir(d);
        if (nPos.x > 0 && nPos.x < WIDTH-1 && nPos.y > 0 && nPos.y < HEIGHT-1 && nPos.z > 0 && nPos.z < DEPTH-1) {
            uint nIndex = getIndex(nPos);
            uint nVal = grid[nIndex];
            uint nType = getType(nVal);

            if (nType == 4u || nType == 1u) {
                uint nMoisture = getAge(nVal);
                uint nCapacity = (nType == 4u) ? tuning.dirtMoistureCapacity : tuning.sandMoistureCapacity;

                if (moisture > nMoisture + 1u && nMoisture < nCapacity) {
                    atomicAdd(grid[currentIndex], 0xFF000000u);
                    atomicAdd(grid[nIndex], 1u << 24);
                    moistureModified = true;
                }
            }
        }
    }

    if (moistureModified) return;

    bool isClumped = false;
    if (currentSleep > tuning.wakeSleepThreshold) {
        int emptyBelowCount = 0;
        if (pos.y > 1) {
            for (int x = -1; x <= 1; x++) {
                for (int z = -1; z <= 1; z++) {
                    ivec3 checkPos = pos + ivec3(x, -1, z);
                    if (checkPos.x >= 0 && checkPos.x < WIDTH && checkPos.z >= 0 && checkPos.z < DEPTH) {
                        if (getType(grid[getIndex(checkPos)]) == 0u) {
                            emptyBelowCount++;
                        }
                    }
                }
            }
        }

        if (emptyBelowCount >= int(tuning.emptyBelowWakeCount)) {
            currentSleep = 0u;
        } else {
            int clumpCount = 0;
            for (int x = -1; x <= 1; x++) {
                for (int y = -1; y <= 1; y++) {
                    for (int z = -1; z <= 1; z++) {
                        if (x == 0 && y == 0 && z == 0) continue;
                        ivec3 nPos = pos + ivec3(x, y, z);
                        if (nPos.x >= 0 && nPos.x < WIDTH && nPos.y >= 0 && nPos.y < HEIGHT && nPos.z >= 0 && nPos.z < DEPTH) {
                            if (getType(grid[getIndex(nPos)]) == 4u) clumpCount++;
                        }
                    }
                }
            }
            if (clumpCount >= int(tuning.dirtClumpThreshold)) isClumped = true;
        }
    }

    if (!isClumped) {
        if (pos.y > 1) {
            ivec3 belowPos = pos + ivec3(0, -1, 0);
            if (getType(grid[getIndex(belowPos)]) == 0u) {
                if (tryMove(currentIndex, rawValue, getIndex(belowPos), pack(4u, 0u, 0u, moisture))) return;
            }
        }

        if (pos.y > 1) {
            int dir = (fract(randVal * 10.0f) > 0.5f) ? 1 : -1;
            ivec3 slidePos1, slidePos2;
            
            if (fract(randVal * 100.0f) > 0.5f) {
                slidePos1 = pos + ivec3(dir, -1, 0); slidePos2 = pos + ivec3(0, -1, dir);
            } else {
                slidePos1 = pos + ivec3(0, -1, dir); slidePos2 = pos + ivec3(dir, -1, 0);
            }

            if (slidePos1.x > 0 && slidePos1.x < WIDTH - 1 && slidePos1.z > 0 && slidePos1.z < DEPTH - 1) {
                if (getType(grid[getIndex(slidePos1)]) == 0u) {
                    if (tryMove(currentIndex, rawValue, getIndex(slidePos1), pack(4u, 0u, 0u, moisture))) return;
                }
            }
            if (slidePos2.x > 0 && slidePos2.x < WIDTH - 1 && slidePos2.z > 0 && slidePos2.z < DEPTH - 1) {
                if (getType(grid[getIndex(slidePos2)]) == 0u) {
                    if (tryMove(currentIndex, rawValue, getIndex(slidePos2), pack(4u, 0u, 0u, moisture))) return;
                }
            }
        }

        if (pos.y > 1) {
            ivec3 belowPos = pos + ivec3(0, -1, 0);
            uint belowIndex = getIndex(belowPos);
            uint belowValue = grid[belowIndex];
            
            if (getType(belowValue) == 2u) {
                int startDir = int(fract(randVal * 8.0f) * 8.0f);
                for (int i = 0; i < 8; i++) {
                    int d = (startDir + i) % 8;
                    ivec3 pushPos = belowPos + getHDir(d);
                    if (pushPos.x > 0 && pushPos.x < WIDTH - 1 && pushPos.z > 0 && pushPos.z < DEPTH - 1) {
                        if (tryDisplace(currentIndex, pack(4u, 0u, 0u, moisture), belowIndex, belowValue, getIndex(pushPos))) return; 
                    }
                }
                if (tryMove(currentIndex, rawValue, belowIndex, pack(4u, 0u, 0u, moisture))) return;
            }

            int dir = (fract(randVal * 10.0f) > 0.5f) ? 1 : -1;
            ivec3 slidePos[2];
            if (fract(randVal * 100.0f) > 0.5f) {
                slidePos[0] = pos + ivec3(dir, -1, 0); slidePos[1] = pos + ivec3(0, -1, dir);
            } else {
                slidePos[0] = pos + ivec3(0, -1, dir); slidePos[1] = pos + ivec3(dir, -1, 0);
            }

            for (int s = 0; s < 2; s++) {
                ivec3 sPos = slidePos[s];
                if (sPos.x > 0 && sPos.x < WIDTH - 1 && sPos.z > 0 && sPos.z < DEPTH - 1) {
                    uint sIndex = getIndex(sPos);
                    uint sValue = grid[sIndex];
                    if (getType(sValue) == 2u) {
                        int startDir = int(fract(randVal * 8.0f + float(s)) * 8.0f);
                        for (int i = 0; i < 8; i++) {
                            int d = (startDir + i) % 8;
                            ivec3 pushPos = sPos + getHDir(d);
                            if (pushPos.x > 0 && pushPos.x < WIDTH - 1 && pushPos.z > 0 && pushPos.z < DEPTH - 1) {
                                if (tryDisplace(currentIndex, pack(4u, 0u, 0u, moisture), sIndex, sValue, getIndex(pushPos))) return;
                            }
                        }
                        if (tryMove(currentIndex, rawValue, sIndex, pack(4u, 0u, 0u, moisture))) return;
                    }
                }
            }
        }
    }

    uint floraState = currentDir;
    
    if (isClumped || currentSleep > tuning.wakeSleepThreshold) {
        ivec3 abovePos = pos + ivec3(0, 1, 0);
        uint aboveType = (abovePos.y < HEIGHT - 1) ? getType(grid[getIndex(abovePos)]) : 0u;

        if (aboveType == 0u) {
            if (moisture >= 5u && floraState < 100u) {
                if (fract(randVal * 55.0f) < tuning.grassGrowChance) floraState++;
            }
            if (floraState > 100u) floraState = 100u;
        } else if (aboveType == 2u) {
            if (floraState > 0u) {
                if (floraState <= 100u) floraState = 101u;
                if (fract(randVal * 66.0f) < tuning.grassSubmergedDecayChance) floraState++;
                if (floraState >= 200u) floraState = 0u;
            }
        } else if (aboveType != 5u) {
            floraState = 0u;
        }
    }

    uint newSleep = min(currentSleep + 1u, 255u);
    atomicCompSwap(grid[currentIndex], rawValue, pack(4u, floraState, newSleep, moisture));
}

// FUNCTION: updateWater
// Water that is genuinely dormant -- sleeping past wakeSleepThreshold AND unable to wake this
// tick -- goes fully inert and stays that way indefinitely; it does NOT age out or evaporate.
// A settled lake/pool is meant to reach a steady state and remain there. The only ways water
// leaves the system are the user's void brush and fire boiling it into steam (see updateFire),
// and cloud moisture is only ever banked by that steam venting off the top of the grid (see
// updateSteam) -- this function must never call atomicAdd(cloudWaterCount, ...).
void updateWater(ivec3 pos, uint currentIndex, uint rawValue, uint currentDir, uint currentSleep, uint currentAge, float randVal) {
    if (currentSleep > tuning.wakeSleepThreshold) {
        bool wake = false;
        if (pos.y > 1 && getType(grid[getIndex(pos + ivec3(0, -1, 0))]) == 0u) {
            wake = true;
        } else {
            bool hasPressure = (pos.y < HEIGHT - 2) ? (getType(grid[getIndex(pos + ivec3(0, 1, 0))]) != 0u) : false;
            bool isStackedOnWater = (pos.y > 1) ? (getType(grid[getIndex(pos + ivec3(0, -1, 0))]) == 2u) : false;

            for(int d = 0; d < 8; d++) {
                ivec3 nPos = pos + getHDir(d);
                if (nPos.x > 0 && nPos.x < WIDTH - 1 && nPos.z > 0 && nPos.z < DEPTH - 1) {
                    if (getType(grid[getIndex(nPos)]) == 0u) {
                        uint belowNeighbor = getType(grid[getIndex(nPos + ivec3(0, -1, 0))]);
                        if (belowNeighbor == 0u || hasPressure || isStackedOnWater || belowNeighbor == 2u) {
                            wake = true;
                            break;
                        }
                    }
                }
            }
        }
        if (!wake) return;
        currentSleep = 0u;
        currentAge = 0u;
    }

    uint newAge = currentAge + 1u;

    if (pos.y > 1) {
        ivec3 belowPos = pos + ivec3(0, -1, 0);
        if (getType(grid[getIndex(belowPos)]) == 0u) {
            if (tryMove(currentIndex, rawValue, getIndex(belowPos), pack(2u, 0u, 0u, newAge))) return;
        }
    }

    uint newDir = currentDir;
    
    if (newDir == 0u || newDir == 9u) {
        float r = fract(randVal * 77.0f);
        if (r < 0.25f) newDir = 1u;      
        else if (r < 0.50f) newDir = 2u; 
        else if (r < 0.75f) newDir = 3u; 
        else newDir = 4u;                  
    }
    
    if (newAge % 3u == 0u && newAge > 0u) {
        uint diagDir = newDir;
        if (diagDir >= 1u && diagDir <= 4u) {
            float r = fract(randVal * 133.0f);
            if (diagDir == 1u) diagDir = (r > 0.5f) ? 5u : 6u;      
            else if (diagDir == 2u) diagDir = (r > 0.5f) ? 7u : 8u; 
            else if (diagDir == 3u) diagDir = (r > 0.5f) ? 5u : 7u; 
            else if (diagDir == 4u) diagDir = (r > 0.5f) ? 6u : 8u; 
        }
        
        ivec3 stepPos = pos + getHDir(int(diagDir) - 1);
        if (stepPos.x > 0 && stepPos.x < WIDTH - 1 && stepPos.z > 0 && stepPos.z < DEPTH - 1) {
            if (getType(grid[getIndex(stepPos)]) == 0u) {
                uint newValue = pack(2u, newDir, 0u, newAge);
                if (tryMove(currentIndex, rawValue, getIndex(stepPos), newValue)) return;
            }
        }
    }

    ivec3 bestDropPos = pos;
    bool foundDrop = false;
    
    uint blockedMask = 0u;
    int startDir = int(fract(randVal * 8.0f) * 8.0f);

    for (int r = 1; r <= 128; r++) {
        if (blockedMask == 255u) break;

        for (int i = 0; i < 8; i++) {
            int d = (startDir + i) % 8;

            if ((blockedMask & (1u << d)) == 0u) {
                ivec3 c = pos + getHDir(d) * r;
                
                if (c.x <= 0 || c.x >= WIDTH - 1 || c.z <= 0 || c.z >= DEPTH - 1 || getType(grid[getIndex(c)]) != 0u) {
                    blockedMask |= (1u << d);
                } else if (c.y > 1 && getType(grid[getIndex(c + ivec3(0, -1, 0))]) == 0u) {
                    bestDropPos = c; 
                    foundDrop = true; 
                    break;
                }
            }
        }
        if (foundDrop) break;
    }
    
    if (foundDrop) {
        uint newValue = pack(2u, 0u, 0u, 0u); 
        if (tryMove(currentIndex, rawValue, getIndex(bestDropPos), newValue)) return;
    } else {
        bool hasPressure = (pos.y < HEIGHT - 2) ? (getType(grid[getIndex(pos + ivec3(0, 1, 0))]) != 0u) : false;
        bool isStackedOnWater = (pos.y > 1) ? (getType(grid[getIndex(pos + ivec3(0, -1, 0))]) == 2u) : false;
        
        bool canStepOntoPool = false;
        for(int d = 0; d < 8; d++) {
            ivec3 nPos = pos + getHDir(d);
            if(nPos.x > 0 && nPos.x < WIDTH - 1 && nPos.z > 0 && nPos.z < DEPTH - 1) {
                if(getType(grid[getIndex(nPos)]) == 0u && pos.y > 1 && getType(grid[getIndex(nPos + ivec3(0,-1,0))]) == 2u) {
                    canStepOntoPool = true; 
                    break;
                }
            }
        }
        
        if (hasPressure || isStackedOnWater || canStepOntoPool) {
            int startSpreadDir = int(fract(randVal * 8.0f) * 8.0f);
            for(int i = 0; i < 8; i++) {
                int d = (startSpreadDir + i) % 8;
                ivec3 targetPos = pos + getHDir(d);
                if (targetPos.x > 0 && targetPos.x < WIDTH - 1 && targetPos.z > 0 && targetPos.z < DEPTH - 1) {
                    if (getType(grid[getIndex(targetPos)]) == 0u) {
                        uint newValue = pack(2u, uint(d + 1), 0u, newAge);
                        if (tryMove(currentIndex, rawValue, getIndex(targetPos), newValue)) return;
                    }
                }
            }
        }
    }
    
    uint newSleep = min(currentSleep + 1u, 255u);
    uint sleepValue = pack(2u, 0u, newSleep, newAge);
    atomicCompSwap(grid[currentIndex], rawValue, sleepValue);
}

// FUNCTION: updateFire
void updateFire(ivec3 pos, uint currentIndex, uint rawValue, uint currentDir, uint currentSleep, uint currentAge, float randVal) {
    uint newAge = currentAge + 1u;
    bool isBurningGrass = false;

    for (int i = 0; i < 6; i++) {
        ivec3 nPos = pos + getOrthoDir(i);
        if (nPos.x > 0 && nPos.x < WIDTH-1 && nPos.y > 0 && nPos.y < HEIGHT-1 && nPos.z > 0 && nPos.z < DEPTH-1) {
            uint nIndex = getIndex(nPos);
            uint nVal = grid[nIndex];
            if (getType(nVal) == 2u) {
                if (atomicCompSwap(grid[nIndex], nVal, pack(6u, 0u, 0u, 0u)) == nVal) {
                    decWater(); // water voxel became steam; it is no longer a water voxel
                    atomicExchange(grid[currentIndex], 0u);
                    return;
                }
            }
        }
    }

    if (pos.y > 1) {
        ivec3 belowPos = pos + ivec3(0, -1, 0);
        uint belowIndex = getIndex(belowPos);
        uint belowValue = grid[belowIndex];
        uint belowType = getType(belowValue);

        if (belowType == 0u) {
            if (tryMove(currentIndex, rawValue, belowIndex, pack(5u, 0u, 0u, newAge))) return;
        } else if (belowType == 2u) {
            atomicExchange(grid[currentIndex], 0u);
            return;
        } else if (belowType == 1u) {
            uint moisture = getAge(belowValue);
            if (moisture > 0u) {
                uint newMoisture = (moisture > tuning.fireDryRate) ? moisture - tuning.fireDryRate : 0u;
                uint newVal = pack(1u, getDir(belowValue), 0u, newMoisture);
                if (atomicCompSwap(grid[belowIndex], belowValue, newVal) == belowValue) {
                    atomicExchange(grid[currentIndex], 0u);
                    return;
                }
            }
        } else if (belowType == 4u) {
            uint flora = (belowValue >> 8) & 0xFFu;
            if (flora > 10u && flora <= 100u) {
                isBurningGrass = true;
                newAge = 0u;

                if (fract(randVal * 100.0f) < tuning.fireBurnGrassChance) {
                    uint newFlora = flora - 1u;
                    uint newVal = pack(4u, newFlora, 0u, getAge(belowValue));
                    atomicCompSwap(grid[belowIndex], belowValue, newVal);
                }

                if (fract(randVal * 100.0f) < tuning.fireSpreadChance) {
                    int d = int(fract(randVal * 10.0f) * 8.0f);
                    ivec3 targetPos = pos + getHDir(d);
                    if (targetPos.x > 0 && targetPos.x < WIDTH-1 && targetPos.z > 0 && targetPos.z < DEPTH-1) {
                        uint targetIndex = getIndex(targetPos);
                        if (getType(grid[targetIndex]) == 0u) {
                            ivec3 targetBelow = targetPos + ivec3(0, -1, 0);
                            uint tBelowVal = grid[getIndex(targetBelow)];
                            if (getType(tBelowVal) == 4u) {
                                uint tFlora = (tBelowVal >> 8) & 0xFFu;
                                if (tFlora > 10u && tFlora <= 100u) {
                                    atomicCompSwap(grid[targetIndex], 0u, pack(5u, 0u, 0u, 0u));
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if (newAge > tuning.fireLifetime) {
        atomicExchange(grid[currentIndex], 0u);
        return;
    }

    atomicCompSwap(grid[currentIndex], rawValue, pack(5u, 0u, 0u, newAge));
}


// FUNCTION: updateSimState
// Drives the rain state machine: 0 = accumulating (white), 1 = darkening (waiting to rain),
// 2 = raining (draining), and sweeps the black hole table. Only invocation (0,0,0) performs
// transitions and eases the cloud charge, keeping those single-writer rather than having every
// voxel in the grid contend on the same atomics. Other invocations may observe a transition up to
// one dispatch late, which is invisible at this timescale.
void updateSimState() {
    if (gl_GlobalInvocationID.x != 0u || gl_GlobalInvocationID.y != 0u || gl_GlobalInvocationID.z != 0u) return;

    // --- Black hole table sweep ------------------------------------------------------------------
    // Slots are validated here, once, rather than by each captured particle. Every mobile voxel in
    // the grid reads this table every dispatch, so a per-particle "is that voxel still a hole?"
    // check would multiply one cheap confirmation into millions. Recomputing the count from scratch
    // also means it can never drift: a hole erased by the void brush frees its slot immediately,
    // and one erased any other way is reaped on the next dispatch.
    uint live = 0u;
    for (int i = 0; i < BLACK_HOLE_MAX; i++) {
        uint code = blackHoles[i];
        if (code == 0u) continue;

        uint voxel = code & BH_INDEX_MASK;
        if (getType(grid[voxel]) != 7u) {
            blackHoles[i] = 0u;
            continue;
        }

        // --- Starvation ----------------------------------------------------------------------
        // Advanced here, and zeroed by any captured particle in updateOrbital. Incrementing from
        // the single-writer sweep rather than having holes time themselves means the clock ticks
        // once per dispatch no matter how much matter is in flight, which is what makes the grace
        // period a predictable duration instead of something that depends on the scene.
        uint starve = blackHoleStarve[i] + 1u;
        blackHoleStarve[i] = starve;

        if (starve > tuning.blackHoleStarveGrace) {
            uint mass = blackHoleMass[i];
            if (mass == 0u) {
                // Nothing left to shed and nothing coming in: the hole evaporates. Clearing the
                // voxel and the slot together is what keeps this from leaving an untracked black
                // voxel behind -- and doing it from the sweep means it happens exactly once.
                grid[voxel] = 0u;
                blackHoles[i] = 0u;
                continue;
            }
            blackHoleMass[i] = mass - min(mass, tuning.blackHoleDecayRate);
        }

        live++;
    }
    blackHoleCount = live;

    // The peak water level is the target a storm restores to. Only tracked while no storm is in
    // progress: a storm deliberately overshoots past the old peak, and letting the mark chase
    // that would move the goalposts mid-storm and stop it from ever finishing. Only a deliberate
    // user void lowers it, so erasing water on purpose leaves no debt the sky keeps repaying.
    if (rainPhase == 0u && waterVoxelCount > waterHighMark) waterHighMark = waterVoxelCount;

    uint deficit = getWaterDeficit();

    // Rotate the rainable-column census: last dispatch's tally becomes this dispatch's divisor,
    // and a fresh tally starts. Columns racing this swap land in one bucket or the other, which
    // only jitters the estimate slightly -- it is a denominator for probability, not a hard
    // allowance, so being a little stale costs nothing and no drop is ever lost to the race.
    rainCandidateEstimate = rainCandidateCount;
    rainCandidateCount = 0u;

    // --- Group cloud charge -------------------------------------------------------------------
    // One value the entire sky renders from, so the whole field thickens and greys together
    // rather than individual clouds blinking in and out. Before a storm it tracks banked steam,
    // so the sky only darkens because smoke put moisture up there; once a storm is committed it
    // tracks the outstanding deficit instead, so the clouds visibly thin out as the debt is
    // repaid and are clear again exactly when the water is back. Eased rather than assigned so
    // every transition -- including the source switch at the storm boundary -- is gradual.
    uint remainingToTarget = (rainTargetLevel > waterVoxelCount) ? (rainTargetLevel - waterVoxelCount) : 0u;
    uint chargeSource = (rainPhase == 0u) ? cloudWaterCount : remainingToTarget;
    float chargeTarget = clamp(float(chargeSource) / max(tuning.cloudChargeSaturation, 1.0f), 0.0f, 1.0f);
    float charge = uintBitsToFloat(cloudChargeBits);
    charge += (chargeTarget - charge) * clamp(tuning.cloudChargeEaseRate, 0.0f, 1.0f);
    cloudChargeBits = floatBitsToUint(clamp(charge, 0.0f, 1.0f));

    if (rainPhase == 0u) {
        // Two independent preconditions, deliberately kept separate: cloudWaterCount > 0 means
        // smoke actually put moisture in the sky (rain still only ever follows steam), while the
        // deficit decides whether there is anything worth raining for. Storm SIZE is not tied to
        // how much steam happened to reach the top -- it's tied to what's actually gone.
        if (cloudWaterCount > 0u && deficit > getRainThreshold()) {
            rainPhase = 1u;
            rainPhaseTimeBits = floatBitsToUint(pc.time);
            // Aim past the deficit rather than exactly at it. Drops still in flight already count
            // as water voxels, so the level reads "restored" a moment before those drops have
            // actually landed -- and some of them then soak into soil instead of pooling. Without
            // headroom every storm therefore quits a little early and the level ratchets down
            // over time. rainOvershoot is that headroom.
            rainTargetLevel = waterHighMark + uint(float(deficit) * max(tuning.rainOvershoot, 0.0f));
        }
    } else if (rainPhase == 1u) {
        float crossedTime = uintBitsToFloat(rainPhaseTimeBits);
        if (pc.time - crossedTime >= tuning.rainDarkenDelay) {
            rainPhase = 2u;
            rainPhaseTimeBits = floatBitsToUint(pc.time); // repurposed: now marks rain start time
        }
    } else if (rainPhase == 2u) {
        // Ends only when the level actually reaches the target, not when some separately-counted
        // reservoir runs dry. Water absorbed by soil mid-storm keeps the gap open, so the storm
        // simply continues until the ground is sated and real water pools again.
        if (remainingToTarget == 0u) {
            rainPhase = 0u;
            rainPhaseTimeBits = 0u;
            cloudWaterCount = 0u; // clouds have spent their moisture; the sky eases back to clear
        }
    }
}

// FUNCTION: updateSteam
void updateSteam(ivec3 pos, uint currentIndex, uint rawValue, uint currentSleep, uint currentAge, float randVal) {
    if (pos.y >= HEIGHT - 2) {
        // No decWater() here: this voxel stopped counting as water back when fire turned it
        // into steam. Venting only banks it as cloud moisture, which is what charges the sky.
        atomicAdd(cloudWaterCount, 1u);
        atomicExchange(grid[currentIndex], 0u);
        return;
    }

    uint newAge = min(currentAge + 1u, 255u);

    // 1. Scatter randomly (horizontal or vertical)
    if (fract(randVal * 88.0f) < tuning.steamScatterChance) {
        int d = int(fract(randVal * 13.0f) * 6.0f);
        ivec3 scatterPos = pos + getOrthoDir(d);
        if (scatterPos.x > 0 && scatterPos.x < WIDTH - 1 && scatterPos.y > 0 && scatterPos.y < HEIGHT - 1 && scatterPos.z > 0 && scatterPos.z < DEPTH - 1) {
            uint sType = getType(grid[getIndex(scatterPos)]);
            if (sType == 0u || sType == 5u) {
                if (tryMove(currentIndex, rawValue, getIndex(scatterPos), pack(6u, 0u, 0u, newAge))) return;
            }
        }
    }

    ivec3 checkPos[3];
    checkPos[0] = pos + ivec3(0, 1, 0);
    int dir = (fract(randVal * 10.0f) > 0.5f) ? 1 : -1;
    if (fract(randVal * 100.0f) > 0.5f) {
        checkPos[1] = pos + ivec3(dir, 1, 0); checkPos[2] = pos + ivec3(0, 1, dir);
    } else {
        checkPos[1] = pos + ivec3(0, 1, dir); checkPos[2] = pos + ivec3(dir, 1, 0);
    }

    // 2. Check for moisture-absorbing blocks (Sand = 1u, Dirt = 4u)
    for (int i = 0; i < 3; i++) {
        ivec3 cPos = checkPos[i];
        if (cPos.x > 0 && cPos.x < WIDTH - 1 && cPos.z > 0 && cPos.z < DEPTH - 1) {
            uint cIndex = getIndex(cPos);
            uint cVal = grid[cIndex];
            uint cType = getType(cVal);
            
            if (cType == 1u || cType == 4u) {
                uint moisture = getAge(cVal);
                uint capacity = (cType == 4u) ? tuning.dirtMoistureCapacity : tuning.sandMoistureCapacity;
                if (moisture < capacity) {
                    if (atomicCompSwap(grid[currentIndex], rawValue, 0u) == rawValue) {
                        atomicAdd(grid[cIndex], 1u << 24);
                        return; 
                    }
                }
            }
        }
    }

    // 3. Try moving upwards or diagonally upwards (Air = 0u, Fire = 5u)
    for (int i = 0; i < 3; i++) {
        ivec3 sPos = checkPos[i];
        if (sPos.x > 0 && sPos.x < WIDTH - 1 && sPos.z > 0 && sPos.z < DEPTH - 1) {
            uint sType = getType(grid[getIndex(sPos)]);
            if (sType == 0u || sType == 5u) {
                if (tryMove(currentIndex, rawValue, getIndex(sPos), pack(6u, 0u, 0u, newAge))) return;
            }
        }
    }
    
    uint newSleep = min(currentSleep + 1u, 255u);
    atomicCompSwap(grid[currentIndex], rawValue, pack(6u, 0u, newSleep, newAge));
}

// FUNCTION: main
void main() {
    ivec3 pos = ivec3(gl_GlobalInvocationID.xyz);

    updateSimState();

    if (pc.spawnActive == 1 && inBrush(pos)) {
        uint spawnIndex = getIndex(pos);
        uint oldType = getType(grid[spawnIndex]);
        uint newType = uint(pc.spawnType);

        // Clicking an existing black hole is the one no-op: re-placing it would burn a second table
        // slot on a voxel that already has one.
        if (newType != 7u || oldType != 7u) {
            if (oldType != newType) {
                if (oldType == 2u) {
                    decWater();
                    // Lower the target too: erasing water by hand is intentional, so it must not
                    // register as a deficit that the sky then spends a storm trying to refill.
                    atomicAdd(waterHighMark, 0xFFFFFFFFu);
                }
                if (oldType == 7u) bhRelease(pos);
                if (newType == 2u) incWater();
            }

            grid[spawnIndex] = pack(newType, 0u, 0u, 0u);

            if (newType == 7u) {
                // The voxel is published BEFORE the slot is claimed, and the barrier is what makes
                // that ordering real. This dispatch's table sweep may run at any point relative to
                // this code, and it frees any slot whose voxel is not a hole -- so a slot becoming
                // visible ahead of its voxel would get reaped instantly, leaving a black cube that
                // pulls on nothing.
                memoryBarrierBuffer();
                if (!bhRegister(pos)) {
                    grid[spawnIndex] = 0u; // table full: roll back rather than leave an inert hole
                }
            }
        }
    }

    if (pos.x < 1 || pos.x >= WIDTH - 1 || 
        pos.y < 1 || pos.y >= HEIGHT - 1 || 
        pos.z < 1 || pos.z >= DEPTH - 1) {
        return;
    }

    uint currentIndex = getIndex(pos);
    uint rawValue = grid[currentIndex];
    uint currentType = getType(rawValue);

    // --- RAIN: while draining, void cells at the top boundary (same layer steam vents from)
    // may become falling water. The rate is constant for the whole storm and set by
    // rainDropsPerTick; what varies is the storm's LENGTH, which is proportional to how much
    // water was evaporated. There is deliberately no time-based ramp -- a ramp made the rate
    // depend on when you happened to look, which is what made this so hard to reason about.
    if (currentType == 0u && rainPhase >= 1u && pos.y == HEIGHT - 2) {
        // Evaluated live from the same placement math the renderer uses, so rain always falls
        // from a cloud that is actually drawn overhead -- and follows it as it drifts. The
        // edge-fade test matters: a cloud dissolving at the border must stop raining as it goes,
        // otherwise drops would keep falling from a patch of empty sky.
        bool underCloud = false;
        int cloudN = int(min(tuning.cloudCount, uint(CLOUD_MAX)));
        for (int ci = 0; ci < cloudN; ci++) {
            vec2 c = cloudCenterXZ(ci, pc.time);
            if (cloudEdgeFade(c) <= 0.01f) continue;
            vec3 r = cloudRadii(ci);
            vec2 d = (vec2(float(pos.x), float(pos.z)) - c) / vec2(r.x, r.z);
            if (dot(d, d) <= 1.0f) { underCloud = true; break; }
        }

        if (underCloud) {
            // Join this dispatch's census. Counting during the darkening phase too means the
            // divisor is already warm the instant rain begins, so the first tick of a storm has
            // correct odds instead of having to skip while an estimate builds.
            atomicAdd(rainCandidateCount, 1u);

            if (rainPhase == 2u) {
                // Independent roll, identical odds for every column under any cloud -- nothing
                // here depends on which invocation got scheduled first, so rain lands evenly
                // across the whole sky rather than piling up wherever the GPU happened to start.
                uint remaining = (rainTargetLevel > waterVoxelCount) ? (rainTargetLevel - waterVoxelCount) : 0u;
                float dropChance = getRainDropChance(rainCandidateEstimate, remaining);
                float rainRandVal = hash(vec3(pos) + vec3(pc.time * 1.7f, 51.0f, 0.0f));

                if (rainRandVal < dropChance) {
                    if (atomicCompSwap(grid[currentIndex], rawValue, pack(2u, 0u, 0u, 0u)) == rawValue) {
                        incWater();
                        return;
                    }
                }
            }
        }
    }
    
    if (currentType == 0u) return;

    float randVal = hash(vec3(pos) + vec3(pc.time));

    // Checked ahead of the stone early-out on purpose: a black hole tears a stone wall apart the
    // same as anything else, and a hole buried inside one should not be walled off from its own
    // orbit field.
    if (currentType != 7u && captureByBlackHole(pos, currentIndex, rawValue, randVal)) return;

    if (currentType == 3u || currentType == 7u) return;

    uint currentDir = getDir(rawValue);
    uint currentSleep = getSleep(rawValue);
    uint currentAge = getAge(rawValue);

    switch (currentType) {
        case 1u:
            updateSand(pos, currentIndex, rawValue, currentSleep, currentAge, randVal);
            break;
        case 2u:
            updateWater(pos, currentIndex, rawValue, currentDir, currentSleep, currentAge, randVal);
            break;
        case 4u:
            updateDirt(pos, currentIndex, rawValue, currentDir, currentSleep, currentAge, randVal);
            break;
        case 5u:
            updateFire(pos, currentIndex, rawValue, currentDir, currentSleep, currentAge, randVal);
            break;
        case 6u:
            updateSteam(pos, currentIndex, rawValue, currentSleep, currentAge, randVal);
            break;
        default:
            break;
    }
}
