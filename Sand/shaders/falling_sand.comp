#version 450

// 8 x 8 x 4 = 256 invocations, which is WebGPU's maxComputeInvocationsPerWorkgroup and therefore
// the ceiling anywhere this has to run in a browser. Desktop Vulkan drivers report 1024, so 8x8x8
// was fine there and would simply be rejected at pipeline creation on the web.
//
// Reshaping is safe because nothing here depends on the workgroup's shape: the shader reads only
// gl_GlobalInvocationID, declares no shared variables, and calls no barrier(). Those are the only
// three ways a compute shader can notice. The dispatch in VulkanRenderer divides Z by 4 to match.
//
// Not bit-identical, and it was never going to be: changing the shape changes the order invocations
// reach a contested cell, so which atomicCompSwap wins a race shifts. That ordering is already
// nondeterministic frame to frame -- it is what the atomics exist to be correct under -- so this
// changes the tie-breaks, not the behaviour.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 4) in;

layout(std430, binding = 0) buffer VoxelGrid {
    uint grid[];
};

// The grid is read in two ways and it matters which: a plain read of a neighbour, and an atomic
// read-modify-write that claims a cell. Every plain read goes through readCell and every plain
// write through writeCell, so the two are named rather than spelled identically to the atomics
// around them.
//
// This is also the seam a WebGPU port turns on. WGSL will not let one storage buffer be both
// atomic and non-atomic -- a binding is array<atomic<u32>> or array<u32>, never both, and there is
// no reinterpreting between them -- while this shader does exactly that on grid[] in about a
// hundred and fifty places. Routed through here, the whole of that becomes two function bodies
// calling atomicLoad and atomicStore. Left inline, it is a hundred and fifty edits with no
// compiler to check them. It costs nothing in the Vulkan build: both compile to the same load.
uint readCell(uint index) { return grid[index]; }
void writeCell(uint index, uint value) { grid[index] = value; }

// Black holes are the one thing in the sim that acts at a distance, so unlike every other
// material they cannot be discovered by looking at neighbouring voxels. They live in a tiny fixed
// table instead, which every captured particle scans in full -- 8 entries is cheap enough to read
// per voxel per dispatch, and it means the orbit field is exact rather than sampled.
const int BLACK_HOLE_MAX = 8;

// The per-slot reveal/footprint arrays are gone: the cloud field is now a fixed drifting
// population whose layout is a pure function of (index, time), so there is nothing per-cloud
// left to store. See the CLOUD FIELD section below.
layout(std430, binding = 1) buffer SimStats {
    uint waterVoxelCount;
    uint waterHighMark;          // UNUSED since clouds became blocks; kept so offsets do not shift
    uint cloudWaterCount;        // UNUSED since clouds became blocks; kept so offsets do not shift
    uint rainPhase;
    uint rainPhaseTimeBits;
    uint rainTargetLevel;        // UNUSED since clouds became blocks; kept so offsets do not shift
    uint rainCandidateCount;     // census of rainable columns, rebuilt every dispatch
    uint rainCandidateEstimate;  // last dispatch's census -- the divisor that sets drop odds
    uint cloudChargeBits;        // float bits: eased 0..1 group-wide cloud opacity/greyness
    uint cloudBlockCount;        // live cloud + storm blocks; census, rotated every dispatch
    uint cloudMovedCount;        // cloud blocks that moved this dispatch; census, rotated
    uint cloudStillTicks;        // UNUSED: the storm check samples rather than accumulating
    uint simTick;                // dispatches since startup; the clock the checks run on
    uint lastRainTick;           // simTick at the last rain event, for the profiler
    // The global Y range of the cloud field, so the renderer can start its march at the band
    // instead of at the edge of the world. Accumulator pair and published pair, rotated once
    // per dispatch like every other census here. Published min > max means no cloud at all.
    uint cloudMinYAcc;
    uint cloudMaxYAcc;
    uint cloudMinY;
    uint cloudMaxY;
    uint blackHoleCount;         // live table entries; 0 lets every voxel skip the scan entirely
    uint maxOccupiedY;           // ceiling on where matter can be; lets the renderer skip empty sky
    uint blackHoles[BLACK_HOLE_MAX];      // 0 = free slot, else BH_ACTIVE | linear voxel index
    uint blackHoleMass[BLACK_HOLE_MAX];   // voxels swallowed; the hole's body size is derived from it
    uint blackHoleStarve[BLACK_HOLE_MAX]; // dispatches since it last had anything captured

    // Per-column cloud census, four words per column at (x + z * WIDTH) * 4:
    //   0 accumulator: cloud blocks counted this dispatch      (atomicAdd)
    //   1 accumulator: highest cloud block's Y this dispatch    (atomicMax)
    //   2 published:   last dispatch's count      -- what the renderer reads
    //   3 published:   last dispatch's highest Y  -- what the renderer reads
    //
    // Runtime-sized, which a std430 block permits only as its last member, so nothing may be added
    // below this line. Length is gridWidth * gridDepth * 4; both renderers size the buffer to match.
    //
    // Published separately from the accumulator because there is no way to order a clear against the
    // atomics that fill it -- the same problem maxOccupiedY documents, solved the same way the rain
    // census is: the column's owning invocation rotates the pair, and a contribution that races the
    // rotation lands in one dispatch's tally or the next. That is a jitter of one block on a count,
    // which is invisible, and it costs no barrier.
    uint cloudColumn[];
};

// =================================================================================================
// CLOUD BLOCKS
//
// A second voxel field, one uint per cell, laid out exactly like the main grid and indexed with the
// same getIndex(). Clouds live here and nowhere else.
//
// A parallel buffer rather than a flag inside the voxel word, for two reasons. The word is full --
// pack() is four 8-bit fields with nothing spare -- and, more importantly, pack() rewrites the whole
// word in well over a hundred places, so a flag living inside it would be erased constantly and
// unpredictably by code that has no idea clouds exist. Keeping clouds in their own buffer is what
// makes a cloud block able to share a cell with ordinary matter: the two fields never alias, so
// spawning stone into a cell cannot disturb the cloud in it, and a cloud drifting through cannot
// disturb the stone.
layout(std430, binding = 4) buffer CloudGrid {
    uint cloudCells[];
};

